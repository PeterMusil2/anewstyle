{
  "name": "anew-style",
  "version": "3.0.0",
  "description": "Updated on 11.10.2026",
  "private": true,
  "license": "ISC",
  "author": "Lukáš Chylík",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321 --strictPort",
    "admin:build": "bun build src/lib/image-pipeline.ts --outfile public/admin/pipeline-core.js --format esm --target browser --banner \"// Generated from src/lib/image-pipeline.ts by bun run admin:build - do not edit.\"",
    "gallery:image": "bun scripts/image-set.ts",
    "watermark": "bun scripts/watermark.ts",
    "models:wildlife-normals": "bun scripts/add-wildlife-normal-maps.mjs",
    "models:product-relief": "bun scripts/add-product-relief-maps.mjs",
    "models:ar-landscape": "bun scripts/create-ar-landscape-models.mjs",
    "typecheck": "astro check && node node_modules/typescript-7/bin/tsc --noEmit",
    "test": "bun test",
    "build": "bun run admin:build && bun run images && bun run typecheck && astro build && node scripts/postbuild-sitemap-alias.mjs",
    "preview": "astro preview --host 0.0.0.0 --port 4322 --strictPort",
    "astro": "astro",
    "cms:local": "decap-server",
    "stylelint": "stylelint --fix \"src/**/*.css\" \"src/**/*.astro\"",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@fancyapps/ui": "^6.1.15",
    "@google/model-viewer": "^4.4.0",
    "@photo-sphere-viewer/core": "^5.15.1",
    "astro": "^7.4.0",
    "three": "^0.183.2",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "decap-server": "^3.11.5",
    "postcss-html": "^2.0.0",
    "sharp": "^0.35.5",
    "smartcrop-sharp": "^2.0.8",
    "stylelint": "^17.16.0",
    "stylelint-order": "^8.1.2",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
