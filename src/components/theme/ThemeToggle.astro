---
/**
 * Light / dark switch. The page follows the system theme until the visitor
 * picks one; the choice is stored and re-applied before first paint by the
 * inline script in Layout.astro. Icons swap purely in CSS (effects.css).
 */
import { useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang?: Lang;
  class?: string;
}

const { lang = "cs", class: className } = Astro.props;
const t = useTranslations(lang);
---

<button
  type="button"
  class:list={[
    "theme-toggle inline-flex size-11 shrink-0 cursor-pointer items-center justify-center border border-line-bold text-fg transition-colors hover:border-gold hover:text-gold",
    className,
  ]}
  data-label-light={t("theme.toLight")}
  data-label-dark={t("theme.toDark")}
  aria-label={t("theme.label")}
  title={t("theme.label")}
>
  <!-- moon: switch to dark -->
  <svg class="theme-toggle__to-dark size-5 fill-none stroke-current stroke-[1.6]" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" stroke-linejoin="round"></path>
  </svg>
  <!-- sun: switch to light -->
  <svg class="theme-toggle__to-light size-5 fill-none stroke-current stroke-[1.6]" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

  const current = (): "light" | "dark" =>
    (root.dataset.theme as "light" | "dark" | undefined) ??
    (systemDark.matches ? "dark" : "light");

  const syncLabels = () => {
    document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((button) => {
      const label =
        current() === "dark" ? button.dataset.labelLight : button.dataset.labelDark;
      if (label) {
        button.setAttribute("aria-label", label);
        button.title = label;
      }
    });
  };

  const apply = (theme: "light" | "dark") => {
    root.dataset.theme = theme;
    try {
      localStorage.setItem("theme", theme);
    } catch {
      /* storage blocked – the choice lasts for this page view only */
    }
    syncLabels();
    // Keep the browser UI colour in step with the chosen theme.
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((meta) => {
      meta.content = theme === "dark" ? "#000000" : "#faf9f5";
      meta.removeAttribute("media");
    });
  };

  document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((button) => {
    button.addEventListener("click", () => {
      const next = current() === "dark" ? "light" : "dark";
      const doc = document as Document & {
        startViewTransition?: (callback: () => void) => unknown;
      };
      if (doc.startViewTransition && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        doc.startViewTransition(() => apply(next));
      } else {
        apply(next);
      }
    });
  });

  systemDark.addEventListener("change", syncLabels);
  syncLabels();
</script>
