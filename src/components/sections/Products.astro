---
import Card from "../product/Card.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import Button from "../ui/Button.astro";
import {
  useTranslations,
  type Lang,
  type TranslationKey,
} from "../../i18n/utils";

interface Props {
  id: string;
  lang?: Lang;
}

const { id, lang = "cs" } = Astro.props;
const t = useTranslations(lang);

const basePath = lang === "cs" ? "" : "/en";

interface ProductFrontmatter {
  id: number;
  title: string;
  imgLight: string;
  imgDark: string;
  imgFrame: string;
  modelHorizontal3d?: string;
  modelVertical3d?: string;
}

const products = Object.values(
  import.meta.glob<{ frontmatter: ProductFrontmatter }>(
    "../../content/products/*.md",
    { eager: true },
  ),
);
---

<section id={id} aria-labelledby={`${id}-title`} class="section-y bg-ink-850">
  <div class="container-page flex flex-col gap-14">
    <SectionHeader
      id={`${id}-title`}
      eyebrow={t("products.title")}
      title={t("products.descPart1").trim()}
    >
      <p>
        <span>{t("products.descPart2")}</span><strong class="font-bold text-gold">{t("products.descPart3")}</strong><span>{t("products.descPart4")}</span>
      </p>
      <p class="text-fg-muted">
        <span>{t("products.descPart5")}</span><strong class="font-bold text-fg">{t("products.descPart6")}</strong><span>{t("products.descPart7")}</span>
      </p>
    </SectionHeader>

    <div class="flex flex-col gap-6">
      <h3 class="border-b border-line pb-4 text-sm font-extrabold tracking-[0.18em] uppercase">
        {t("products.illustrative" as TranslationKey)}
      </h3>
      <ul class="product-list grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {
          products
            .sort((a, b) => a.frontmatter.id - b.frontmatter.id)
            .map((product) => {
              const data = product.frontmatter;
              return (
                <li class="reveal">
                  <Card
                    id={data.id}
                    title={data.title}
                    imgLight={data.imgLight}
                    imgDark={data.imgDark}
                    imgFrame={data.imgFrame}
                    modelHorizontal3d={data.modelHorizontal3d}
                    modelVertical3d={data.modelVertical3d}
                    has3D={Boolean(data.modelHorizontal3d || data.modelVertical3d)}
                    lang={lang}
                  />
                </li>
              );
            })
        }
      </ul>
    </div>

    <div class="flex flex-col items-start justify-between gap-6 border border-line bg-ink-900 p-7 md:flex-row md:items-center md:gap-10 md:p-8">
      <p class="max-w-3xl text-base leading-relaxed text-fg-soft">
        {t("products.samplesNote" as TranslationKey)}
      </p>
      <Button href={`${basePath}/#contact`} variant="outline" class="shrink-0">
        {t("products.samplesCta" as TranslationKey)}
      </Button>
    </div>
  </div>
</section>

<script>
  const ensureModelViewerLoaded = (): void => {
    if (typeof document === "undefined") return;
    if (document.querySelector('script[data-model-viewer-loader="true"]'))
      return;
    const script = document.createElement("script");
    script.type = "module";
    script.src =
      "https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js";
    script.dataset.modelViewerLoader = "true";
    document.head.appendChild(script);
  };

  const productCards = document.querySelectorAll<HTMLAnchorElement>(
    ".product-list .card",
  );
  productCards.forEach((card) => {
    card.addEventListener(
      "click",
      () => {
        ensureModelViewerLoaded();
      },
      { once: true },
    );
  });
</script>
