---
import Icon from "../icons/Icon.astro";
import Button from "../ui/Button.astro";
import PanelCategorySwitch from "../ui/PanelCategorySwitch.astro";
import {
  useTranslations,
  type Lang,
  type PanelCategory,
} from "../../i18n/utils";

interface Props {
  lang?: Lang;
  pageTitle?: string;
  pageDescription?: string;
  home?: boolean;
  panelCategory?: PanelCategory;
}

const { lang = 'cs', pageTitle, pageDescription, home = false, panelCategory } = Astro.props;
const t = useTranslations(lang);
const homeHref = lang === "cs" ? "/" : "/en/";
---

<header class="scheme-dark-protected relative isolate flex min-h-svh text-fg items-end overflow-hidden bg-ink">
  <!-- Poster: the LCP image. The video fades in over it once it plays. -->
  {panelCategory === "mineral" ? (
    <picture>
      <source
        media="(max-width: 560px)"
        type="image/webp"
        srcset="/images/hero/hero-poster-mineral-mobile.webp 540w"
        sizes="100vw"
      />
      <img
        src="/images/hero/hero-poster-mineral-desktop.webp"
        alt=""
        width="1280"
        height="720"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 -z-30 size-full object-cover"
      />
    </picture>
  ) : (
    <picture>
      <source media="(max-width: 560px)" type="image/avif" srcset="/images/hero/hero-poster-mobile.avif" />
      <source media="(max-width: 560px)" type="image/webp" srcset="/images/hero/hero-poster-mobile.webp" />
      <source type="image/avif" srcset="/images/hero/hero-poster-1280.avif" />
      <img
        src="/images/hero/hero-poster-1280.webp"
        alt=""
        width="1280"
        height="720"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 -z-30 size-full object-cover"
      />
    </picture>
  )}
  <video
    class="hero-video pointer-events-none absolute inset-0 -z-20 size-full object-cover"
    id="headerVideo"
    data-panel-category={panelCategory ?? "stone"}
    data-home={home ? "true" : "false"}
    aria-hidden="true"
    tabindex="-1"
    preload="auto"
    autoplay
    loop
    muted
    playsinline
    disablepictureinpicture></video>
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(60%_70%_at_75%_40%,rgb(163_140_82/0.18),transparent_70%),linear-gradient(to_top,var(--color-ink)_0%,rgb(0_0_0/0.40)_45%,rgb(0_0_0/0.15)_100%)]"
    aria-hidden="true"
  >
  </div>

  <button
    type="button"
    id="headerVideoToggle"
    hidden
    aria-controls="headerVideo"
    aria-label={t('header.videoPause')}
    data-label-pause={t('header.videoPause')}
    data-label-play={t('header.videoPlay')}
    class="hero-video-toggle absolute z-10 grid size-11 cursor-pointer place-items-center rounded-full border border-fg/35 bg-ink/45 text-fg backdrop-blur-md transition-colors hover:bg-fg/12 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg [&[hidden]]:hidden!"
  >
    <svg class="video-toggle__pause size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
    <svg class="video-toggle__play hidden size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
  </button>
  {!home && panelCategory && (
    <a
      href={homeHref}
      aria-label={t("nav.home")}
      title={t("nav.home")}
      class="hero-home-link absolute z-10 grid size-11 place-items-center rounded-full border border-gold bg-ink/70 text-gold backdrop-blur-md transition-colors hover:bg-gold hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
    >
      <Icon name="home" class="size-5" />
    </a>
  )}

  <div class="container-wide flex flex-col items-center gap-6 pt-[calc(var(--nav-height)+4rem)] pb-20 text-center lg:pb-28">
    <h1 class:list={[
      "hero-title max-w-4xl font-display leading-[0.92] font-black tracking-[0.08em] uppercase",
      pageTitle ? "text-[clamp(1.75rem,8vw,3rem)] sm:text-6xl lg:text-7xl" : "text-[clamp(2.25rem,11.5vw,4.5rem)] sm:text-7xl lg:text-[7.5rem]",
    ]}>
      <span class:list={["hero-title__label", { "hero-title__label--home": home }]}>{pageTitle ?? "ANEW STYLE"}</span>
    </h1>
    <p class="hero-subtitle max-w-xl text-center text-xl font-light tracking-wide text-fg-soft lg:text-2xl">
      {pageDescription ?? t('header.title')}
    </p>
    <PanelCategorySwitch lang={lang} activeCategory={panelCategory} />
    <Button
      href="https://www.anewstyle-eshop.cz"
      variant="ghost"
      rel="external"
      target="_blank"
      title={t('header.gotoEshop')}
      class="w-64 justify-center max-md:hidden!"
    >
      {t('header.btnEshop')}
      <Icon name="eshop" class="size-4" />
    </Button>
    {!home && (
      <div class="absolute bottom-4 left-1/2 z-10 flex -translate-x-1/2 lg:hidden!">
        <Button
          variant="outline"
          id="headerArButton"
          data-model-path="/3d/products/Rockfoil_DARKGOLD_3D_vertical.glb"
          data-texture-path={panelCategory === "mineral" ? "/images/patterns/mineral-2.png" : undefined}
          data-loading="false"
          data-error="false"
          class="w-64 [--spinner-color:var(--color-gold)] lg:hidden! data-[error=true]:border-danger data-[error=true]:bg-danger data-[loading=true]:cursor-wait data-[loading=true]:opacity-70"
        >
          {t('header.btnAr')}
          <Icon name="ar" class="size-5" />
        </Button>
      </div>
    )}
  </div>

  <div
    class="absolute bottom-8 left-1/2 hidden h-10 w-px -translate-x-1/2 bg-linear-to-b from-transparent to-gold md:block"
    aria-hidden="true"
  >
  </div>
</header>

<script>

  // AR functionality with proper Android support
  async function activateARForModel(modelPath: string, texturePath?: string): Promise<void> {
    try {
      // model-viewer (three.js) is ~1 MB – load it only when AR is requested.
      await import("@google/model-viewer");

      // Create model-viewer element
      const modelViewer = document.createElement("model-viewer") as any;

      // Set attributes for AR
      modelViewer.setAttribute("src", modelPath);
      modelViewer.setAttribute("ar", "");
      modelViewer.setAttribute("ar-scale", "auto");
      modelViewer.setAttribute("ar-modes", "webxr scene-viewer quick-look");
      modelViewer.setAttribute("camera-controls", "");
      modelViewer.setAttribute("touch-action", "pan-y");
      modelViewer.setAttribute("camera-orbit", "0deg 90deg 2.5m");
      modelViewer.setAttribute("loading", "eager");

      // Position off-screen but keep it accessible for AR
      modelViewer.style.position = "fixed";
      modelViewer.style.top = "-1px";
      modelViewer.style.left = "-1px";
      modelViewer.style.width = "1px";
      modelViewer.style.height = "1px";
      modelViewer.style.opacity = "0";
      modelViewer.style.pointerEvents = "none";
      modelViewer.style.zIndex = "-1";

      // Add to DOM
      document.body.appendChild(modelViewer);

      // Wait for model to load
      await new Promise<void>((resolve, reject) => {
        const timeout = setTimeout(() => {
          reject(new Error("Model load timeout"));
        }, 10000);

        const onLoad = () => {
          clearTimeout(timeout);
          resolve();
        };

        const onError = (error: any) => {
          clearTimeout(timeout);
          reject(error);
        };

        // Listen for load events
        modelViewer.addEventListener("load", onLoad, { once: true });
        modelViewer.addEventListener("error", onError, { once: true });

        // Also check if already loaded
        if (modelViewer.loaded) {
          clearTimeout(timeout);
          resolve();
        }
      });

      if (texturePath) {
        const texture = await modelViewer.createTexture(texturePath);
        if (!texture) throw new Error("Panel texture could not be loaded.");
        const materials = modelViewer.model?.materials.filter(
          (material: any) => material.pbrMetallicRoughness.baseColorTexture,
        ) ?? [];
        if (!materials.length) throw new Error("The model does not expose a textured panel material.");
        materials.forEach((material: any) => {
          material.pbrMetallicRoughness.baseColorTexture.setTexture(texture);
        });
      }

      // Wait a bit more to ensure everything is ready
      await new Promise((resolve) => setTimeout(resolve, 300));

      // Activate AR
      if (typeof modelViewer.activateAR === "function") {
        modelViewer.activateAR();
      } else {
        throw new Error("AR activation not available");
      }

      // Set up cleanup when AR session ends
      const cleanup = () => {
        if (document.body.contains(modelViewer)) {
          document.body.removeChild(modelViewer);
        }
      };

      // Listen for AR session end events
      modelViewer.addEventListener("ar-status", (event: any) => {
        if (event.detail.status === "not-presenting") {
          // AR session ended, clean up after a delay
          setTimeout(cleanup, 1000);
        }
      });

      // Fallback cleanup after 30 seconds (in case AR session doesn't end properly)
      setTimeout(cleanup, 30000);
    } catch (error) {
      console.error("Failed to activate AR:", error);
      throw error;
    }
  }

  const MOBILE_BREAKPOINT = 560;
  // Use a landscape and portrait loop; the hero is always muted.

  function initHeaderVideo(): void {
    const video = document.querySelector<HTMLVideoElement>("#headerVideo");
    const toggle = document.querySelector<HTMLButtonElement>("#headerVideoToggle");
    if (!video || !toggle) return;

    // Autoplay is the default on phones too, regardless of connection estimates.
    // Keep the explicit accessibility preference for a still background.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    // Set the live properties before attaching a source, including on iOS.
    video.muted = true;
    video.defaultMuted = true;
    video.playsInline = true;
    video.autoplay = true;
    video.controls = false;

    const isMineral = video.dataset.panelCategory === "mineral";
    const isHome = video.dataset.home === "true";
    const videoMobile = isMineral
      ? "/videos/hero-mineral-mobile.mp4"
      : isHome
        ? "/videos/hero-mobile.mp4"
        : "/videos/hero-stone-bomma-v8-mobile.mp4";
    const videoDesktop = isMineral
      ? "/videos/mineral_before_after_intro_loop_16x9.mp4"
      : isHome
        ? "/videos/hero-1280.mp4"
        : "/videos/hero-stone-bomma-v8.mp4";

    let userPaused = false;
    let inView = true;
    let playPending = false;
    const sync = () => {
      const paused = video.paused;
      toggle.setAttribute("aria-label", (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? "");
      toggle.querySelector(".video-toggle__pause")?.classList.toggle("hidden", paused);
      toggle.querySelector(".video-toggle__play")?.classList.toggle("hidden", !paused);
    };
    const play = async () => {
      if (playPending || userPaused || !inView || document.hidden) return;
      playPending = true;
      try {
        await video.play();
      } catch {
        // OS autoplay restrictions keep the poster and offer the same small control.
        if (!userPaused && inView && !document.hidden && !video.error) {
          toggle.hidden = false;
          sync();
        }
      } finally {
        playPending = false;
      }
    };

    video.addEventListener("playing", () => {
      // Never expose a native central play overlay before playback succeeds.
      video.classList.add("is-playing");
      toggle.hidden = false;
      sync();
    });
    video.addEventListener("pause", sync);
    video.addEventListener("error", () => {
      video.classList.remove("is-playing");
      toggle.hidden = true;
    });
    toggle.addEventListener("click", () => {
      if (video.paused) {
        userPaused = false;
        void play();
      } else {
        userPaused = true;
        video.pause();
      }
    });

    // Save decoding work off screen, without undoing an explicit user pause.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        if (inView) void play();
        else video.pause();
      }, { threshold: 0.05 }).observe(video);
    }
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) video.pause();
      else void play();
    });
    // Mobile browsers can restore a frozen page from the back/forward cache.
    window.addEventListener("pageshow", () => { void play(); });

    // Do not wait for unrelated images, analytics or the window load event.
    const isMobile = window.matchMedia(`(max-width: ${MOBILE_BREAKPOINT}px)`).matches;
    video.src = isMobile ? videoMobile : videoDesktop;
    video.preload = "auto";
    video.addEventListener("canplay", () => { void play(); }, { once: true });
    video.load();
    void play();
  }

  function initHeader(): void {
    initHeaderVideo();

    // AR button initialization
    const arButton = document.querySelector(
      "#headerArButton"
    ) as HTMLButtonElement;

    if (!arButton) return;

    arButton.addEventListener("click", async () => {
      try {
        // Show loading state
        arButton.disabled = true;
        arButton.setAttribute("data-loading", "true");

        // Activate AR
        await activateARForModel(
          arButton.dataset.modelPath ?? "/3d/products/Rockfoil_DARKGOLD_3D_vertical.glb",
          arButton.dataset.texturePath,
        );

        // Restore button state
        arButton.disabled = false;
        arButton.setAttribute("data-loading", "false");
      } catch (error) {
        console.error("AR activation failed:", error);

        // Show error state
        arButton.disabled = false;
        arButton.setAttribute("data-loading", "false");
        arButton.setAttribute("data-error", "true");

        // Reset error state after 2 seconds
        setTimeout(() => {
          arButton.setAttribute("data-error", "false");
        }, 2000);
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeader, { once: true });
  } else {
    initHeader();
  }
</script>
