---
import type { TooltipProps } from "./types";

/**
 * Info tooltip built on the native popover API; effects.css anchors it to the
 * trigger where CSS anchor positioning is supported.
 */
interface Props extends TooltipProps {}

const { label = "Info" } = Astro.props as Props;

const tooltipId = `tooltip-${
  typeof crypto !== "undefined" && "randomUUID" in crypto
    ? crypto.randomUUID()
    : Math.random().toString(36).slice(2)
}`;
---

<span class="tooltip inline-flex align-middle">
  <button
    class="tooltip__trigger inline-grid size-6 cursor-pointer place-items-center rounded-full border border-gold bg-gold text-xs leading-none font-bold text-ink transition-colors hover:bg-gold-light"
    type="button"
    commandfor={tooltipId}
    command="toggle-popover"
    popovertarget={tooltipId}
    popovertargetaction="toggle"
    aria-label={label}
  >
    <span aria-hidden="true">i</span>
  </button>
  <span
    class="tooltip__popover pop-panel border border-gold-light bg-gold p-4 text-sm leading-relaxed font-normal text-ink shadow-2xl"
    id={tooltipId}
    popover="auto"
    role="tooltip"
  >
    <slot />
  </span>
</span>
