---
import NavItem from "./NavItem.astro";
import LangSwitch from "../langSwitch/LangSwitch.astro";
import ThemeToggle from "../theme/ThemeToggle.astro";
import Button from "../ui/Button.astro";
import Icon from "../icons/Icon.astro";
import {
  getPanelPagePath,
  useTranslations,
  type Lang,
} from "../../i18n/utils";

interface Props {
  lang?: Lang;
  panelCategory?: "stone" | "mineral";
}

const { lang = "cs", panelCategory } = Astro.props;
const t = useTranslations(lang);

const basePath = lang === "cs" ? "" : "/en";
const eshopUrl = "https://www.anewstyle-eshop.cz/";

const links = panelCategory
  ? [
      { href: `${getPanelPagePath(panelCategory, lang)}#products`, text: t("nav.products") },
      { href: `${getPanelPagePath(panelCategory, lang)}#price-list`, text: t("nav.price"), accent: true },
      { href: `${basePath}/#equipment-comparison`, text: t("nav.comparison") },
      { href: `${basePath}/gallery/`, text: t("nav.gallery") },
      { href: `${basePath}/manual/`, text: t("nav.manual") },
      { href: `${basePath}/?panel=${panelCategory}#contact`, text: t("nav.contact") },
    ]
  : [
      { href: "#about", text: t("nav.light"), accent: true },
      { href: "#technologies", text: t("nav.technologies") },
      { href: "#features", text: t("nav.features") },
      { href: "#contact", text: t("nav.contact") },
      { href: `${basePath}/gallery/`, text: t("nav.gallery") },
      { href: `${basePath}/manual/`, text: t("nav.manual") },
    ];
const mobileLinks = links;
---

<div class="site-nav fixed inset-x-0 top-0 z-50">
  <nav aria-label={t("nav.main")} class="site-nav__bar border-b border-line">
    <div class="container-wide flex h-(--nav-height) items-center justify-between gap-3 sm:gap-6">
      <a
        href={`${basePath}/`}
        aria-label={t("nav.home")}
        class="flex min-w-0 shrink items-center gap-2.5 text-fg no-underline sm:gap-3.5"
      >
        <img
          src="/images/logos/logo.svg"
          alt=""
          width="365"
          height="850"
          class="h-10 w-auto shrink-0 lg:h-13"
        />
        <span class:list={["flex flex-col gap-0.5", !panelCategory && "xl:max-2xl:sr-only"]}>
          <span class="text-sm font-black tracking-[0.2em] whitespace-nowrap sm:text-base sm:tracking-[0.3em] lg:text-lg">ANEW STYLE</span>
          {!panelCategory && (
            <span class:list={["hidden text-[0.625rem] tracking-[0.18em] text-fg-muted uppercase sm:block xl:hidden 2xl:block"]}>
              {t("header.title")}
            </span>
          )}
        </span>
      </a>

      <ul class="hidden items-center gap-5 xl:flex 2xl:gap-8">
        {links.map((link) => <NavItem {...link} />)}
      </ul>

      <div class="flex items-center gap-2 sm:gap-3">
        <Button
          href={eshopUrl}
          variant="outline"
          size="sm"
          rel="external"
          target="_blank"
          class="max-md:hidden!"
        >
          {t("nav.eshop")}
          <Icon name="eshop" class="size-4" />
        </Button>
        <ThemeToggle lang={lang} />
        <LangSwitch lang={lang} />
        <button
          type="button"
          popovertarget="mobile-menu"
          class="inline-flex size-11 cursor-pointer items-center justify-center border border-line-bold text-fg transition-colors hover:border-gold hover:text-gold xl:hidden"
          aria-label={t("nav.openMenu")}
        >
          <Icon name="menu" class="size-5" />
        </button>
      </div>
    </div>
  </nav>

  <div
    id="mobile-menu"
    popover
    class="pop-panel fixed inset-x-0 top-(--nav-height) bottom-auto m-0 max-h-[calc(100dvh-var(--nav-height))] w-full overflow-y-auto border-b border-line-strong bg-ink-900 text-fg xl:hidden"
  >
    <div class="container-wide flex flex-col gap-8 pt-4 pb-8">
      <ul class="flex flex-col">
        {mobileLinks.map((link) => <NavItem {...link} variant="panel" />)}
      </ul>
      <div class="flex items-center justify-between gap-4">
        <Button href={eshopUrl} variant="outline" rel="external" target="_blank" class="flex-1">
          {t("nav.eshop")}
          <Icon name="eshop" class="size-4" />
        </Button>
        <button
          type="button"
          popovertarget="mobile-menu"
          popovertargetaction="hide"
          class="inline-flex size-13 cursor-pointer items-center justify-center border border-line-bold text-fg hover:border-gold hover:text-gold"
          aria-label={t("nav.closeMenu")}
        >
          <Icon name="close" class="size-5" />
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Following an in-page link should also close the mobile menu popover.
  const menu = document.getElementById("mobile-menu");
  menu?.querySelectorAll("[data-nav-link]").forEach((link) => {
    link.addEventListener("click", () => menu.hidePopover());
  });
</script>
