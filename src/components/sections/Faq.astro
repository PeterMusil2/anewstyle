---
/**
 * FAQ – native exclusive accordion (<details name="faq">); the opening motion
 * is pure CSS (.faq-item in effects.css).
 */
import SectionHeader from "../ui/SectionHeader.astro";
import Button from "../ui/Button.astro";
import Icon from "../icons/Icon.astro";
import { faqItems } from "../../lib/faq";
import { inlineMarkdown } from "../../lib/inline-markdown";
import {
  useTranslations,
  type Lang,
  type TranslationKey,
} from "../../i18n/utils";

interface Props {
  id: string;
  lang?: Lang;
  panelCategory?: "stone" | "mineral";
  standalone?: boolean;
}

const { id, lang = "cs", panelCategory, standalone = false } = Astro.props;
const t = useTranslations(lang);
const basePath = lang === "cs" ? "" : "/en";
const pagePath = panelCategory
  ? panelCategory === "stone"
    ? lang === "cs" ? "/svitici-kamenne-panely/" : "/en/illuminated-stone-panels/"
    : lang === "cs" ? "/svitici-mineralni-panely/" : "/en/illuminated-mineral-panels/"
  : `${basePath}/`;

const questions = faqItems(lang)
  .filter((item) => !(panelCategory === "mineral" && item.hideInMineral))
  .map((item) => ({
    ...item,
    answer: inlineMarkdown(item.answer),
    mineralAnswer: inlineMarkdown(item.mineralAnswer),
  }));
---

<section
  id={id}
  aria-labelledby={`${id}-title`}
  class:list={[
    standalone ? "section-y bg-ink faq-standalone" : "home-section-y home-section-divider bg-ink",
  ]}
>
  <div class="container-page flex flex-col gap-8 lg:gap-10">
    <SectionHeader id={`${id}-title`} layout="center" eyebrow={t("faq.title")} title={t("faq.heading")}>
      <p class="text-fg-muted">{t("faq.desc" as TranslationKey)}</p>
      <Button href={`${pagePath}#contact`} variant="outline" class="mx-auto">
        {t("contact.title")}
      </Button>
    </SectionHeader>

    <div class="grid items-start gap-3 md:grid-cols-2 md:gap-4 lg:gap-5">
      {
        questions.map((item) => (
          <details
            name="faq"
            class="faq-item group border border-line-strong bg-ink-900 px-4 transition-colors hover:border-gold/60 sm:px-5"
            data-panel-type={item.hideInMineral ? "stone" : undefined}
          >
            <summary class="flex min-h-16 cursor-pointer items-center justify-between gap-4 py-4 text-left">
              <h3 class="min-w-0 text-base leading-snug font-bold text-fg transition-colors group-open:text-gold sm:text-lg">
                {item.question}
              </h3>
              <span class="grid size-9 shrink-0 place-items-center border border-line-strong text-gold transition-colors group-open:border-gold">
                <Icon name="plus" class="faq-icon size-4" />
              </span>
            </summary>
            <div class="faq-answer">
              <div class="prose-inline pb-5 text-base leading-relaxed text-fg-soft">
                {panelCategory ? (
                  <span set:html={panelCategory === "mineral" ? item.mineralAnswer : item.answer} />
                ) : item.answer !== item.mineralAnswer ? (
                  <div class="grid gap-4 lg:grid-cols-2 lg:gap-5">
                    <div>
                      <h4 class="mb-2 text-xs font-extrabold tracking-caps text-gold uppercase">{t("price.categoryStone")}</h4>
                      <span set:html={item.answer} />
                    </div>
                    <div>
                      <h4 class="mb-2 text-xs font-extrabold tracking-caps text-gold uppercase">{t("price.categoryMineral")}</h4>
                      <span set:html={item.mineralAnswer} />
                    </div>
                  </div>
                ) : item.hideInMineral ? (
                  <div>
                    <h4 class="mb-2 text-xs font-extrabold tracking-caps text-gold uppercase">{t("price.categoryStone")}</h4>
                    <span set:html={item.answer} />
                  </div>
                ) : (
                  <span set:html={item.answer} />
                )}
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
