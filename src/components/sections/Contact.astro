---
import Picture from "../ui/Picture.astro";
import Icon from "../icons/Icon.astro";
import Button from "../ui/Button.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { useTranslations, type Lang } from "../../i18n/utils";
import { contact } from "../../lib/site-data";

interface Props {
  id: string;
  lang?: Lang;
  panelCategory?: "stone" | "mineral";
}

const { id, lang = "cs", panelCategory } = Astro.props;
const t = useTranslations(lang);

// Where the bonus button sends the visitor, honouring the locale prefix.
// ?filter=bonus makes the gallery open with the Bonus segment preselected.
const galleryPath = `${lang === "en" ? "/en/gallery/" : "/gallery/"}?filter=bonus`;
---

<section id={id} aria-labelledby={`${id}-title`} class="section-y bg-ink">
  <div class="container-page flex flex-col gap-12">
      <SectionHeader id={`${id}-title`} layout="left" eyebrow={t("nav.contact")} title={t("contact.title")}>
        <p>
          <span>{t("contact.descPart1")}</span>
          <a href="mailto:info@anewstyle.cz" class="font-bold text-gold underline-offset-4 hover:text-gold-light hover:underline">info@anewstyle.cz</a><span>{t("contact.descPart2")}</span>
        </p>
        <div class="flex items-center gap-3 pt-2">
          <span class="text-xs font-bold tracking-eyebrow text-fg-muted uppercase">{t("contact.followUs")}</span>
          <a
            href="https://www.facebook.com/profile.php?id=100088855596654"
            rel="external"
            aria-label={t("contact.gotoFacebook")}
            target="_blank"
            class="grid size-12 place-items-center border border-line-strong text-fg-soft transition-colors hover:border-gold hover:text-gold"
          >
            <Icon name="facebook" class="size-5" />
          </a>
          <a
            href="https://www.instagram.com/anewstyle.cz/"
            rel="external"
            aria-label={t("contact.gotoInstagram")}
            target="_blank"
            class="grid size-12 place-items-center border border-line-strong text-fg-soft transition-colors hover:border-gold hover:text-gold"
          >
            <Icon name="instagram" class="size-5" />
          </a>
        </div>
      </SectionHeader>

    <div class="grid items-stretch gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-6">
      <form
        class="contact-form flex h-full flex-col gap-5 sm:border sm:border-line sm:bg-ink-850 sm:p-10"
        data-panel-category={panelCategory}
        action="/api/contact"
        method="POST"
        novalidate
        toolname="anewstyle_inquiry"
        tooldescription={`Send an inquiry to ANEW STYLE (${panelCategory === "mineral" ? "illuminated mineral panels" : panelCategory === "stone" ? "illuminated stone panels" : "illuminated stone panels, illuminated mineral panels, or undecided"}): name, e-mail, optional panel size and version, and an optional message. The visitor confirms and submits it.`}
      >
        <input type="hidden" name="panel_category" value={panelCategory ?? ""} />
        <input type="hidden" name="locale" value={lang} />
        <input type="hidden" name="gclid" data-attribution />
        <input type="hidden" name="fbclid" data-attribution />
        <input type="hidden" name="source" data-attribution />
        <input type="hidden" name="utm_source" data-attribution />
        <input type="hidden" name="utm_medium" data-attribution />
        <input type="hidden" name="utm_campaign" data-attribution />
        <input type="hidden" name="utm_content" data-attribution />
        <input type="hidden" name="utm_term" data-attribution />
        <input type="hidden" name="landing_page" data-attribution />
        <input type="hidden" name="referrer" data-attribution />
        <input
          type="checkbox"
          name="botcheck"
          class="hidden"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />

        {!panelCategory && (
          <fieldset class="flex flex-col gap-2.5">
            <legend class="text-xs font-extrabold tracking-[0.16em] text-fg-muted uppercase">{t("contact.panelCategoryLabel")}</legend>
            <div class="grid gap-2 sm:grid-cols-3">
              {(["stone", "mineral", "unknown"] as const).map((category) => (
                <label class="flex min-h-12 cursor-pointer items-center gap-3 border border-line bg-ink-900 px-4 text-sm font-semibold text-fg-soft transition-colors hover:border-line-strong has-checked:border-gold has-checked:bg-gold/10 has-checked:text-fg has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-gold">
                  <input type="radio" name="panel_category_choice" value={category} checked={category === "unknown"} required={category === "stone"} class="accent-gold" />
                  {t(category === "stone" ? "price.categoryStone" : category === "mineral" ? "price.categoryMineral" : "contact.formUnknown")}
                </label>
              ))}
            </div>
          </fieldset>
        )}

        <p class="-mb-2 text-xs leading-relaxed text-fg-muted">{t("contact.formChoiceHint")}</p>

        <fieldset class="flex flex-col gap-2.5">
          <legend class="text-xs font-extrabold tracking-[0.16em] text-fg-muted uppercase">{t("contact.formSize")}</legend>
          <div class="grid grid-cols-3 gap-2 sm:grid-cols-5">
            {["L", "XL", "XXL", "XXXL", ""].map((size) => (
              <label class="flex min-h-11 cursor-pointer items-center justify-center border border-line bg-ink-900 px-2 text-sm font-bold text-fg-soft transition-colors hover:border-line-strong has-checked:border-gold has-checked:bg-gold/10 has-checked:text-fg has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-gold">
                <input type="radio" name="size" value={size} checked={size === ""} class="sr-only" />
                {size || t("contact.formUnknown")}
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-2.5">
          <legend class="text-xs font-extrabold tracking-[0.16em] text-fg-muted uppercase">{t("contact.formVersion")}</legend>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
            {["SLIM", "BASIC", "DELUXE", ""].map((version) => (
              <label class="flex min-h-11 cursor-pointer items-center justify-center border border-line bg-ink-900 px-2 text-sm font-bold text-fg-soft transition-colors hover:border-line-strong has-checked:border-gold has-checked:bg-gold/10 has-checked:text-fg has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-gold">
                <input type="radio" name="version" value={version} checked={version === ""} class="sr-only" />
                {version || t("contact.formUnknown")}
              </label>
            ))}
          </div>
        </fieldset>

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="flex flex-col gap-2 text-xs font-extrabold tracking-[0.16em] text-fg-muted uppercase">
            {t("contact.formName")}
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              placeholder={t("contact.formNamePlaceholder")}
              toolparamdescription="Full name of the person asking"
              class="min-h-13 border border-field bg-ink-900 px-4 text-base font-normal tracking-normal text-fg normal-case transition-colors placeholder:text-fg-subtle hover:border-line-bold focus:border-gold focus:outline-none user-invalid:border-danger"
            />
          </label>
          <label class="flex flex-col gap-2 text-xs font-extrabold tracking-[0.16em] text-fg-muted uppercase">
            {t("contact.formEmail")}
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              inputmode="email"
              placeholder={t("contact.formEmailPlaceholder")}
              toolparamdescription="E-mail address for the reply"
              class="min-h-13 border border-field bg-ink-900 px-4 text-base font-normal tracking-normal text-fg normal-case transition-colors placeholder:text-fg-subtle hover:border-line-bold focus:border-gold focus:outline-none user-invalid:border-danger"
            />
          </label>
        </div>

        <label class="flex flex-col gap-2 text-xs font-extrabold tracking-[0.16em] text-fg-muted uppercase">
          {t("contact.formMessage")}
          <textarea
            name="message"
            rows="3"
            placeholder={t("contact.formMessagePlaceholder")}
            toolparamdescription="Optional question or additional request"
            class="min-h-13 resize-y border border-field bg-ink-900 px-4 py-3.5 text-base font-normal tracking-normal text-fg normal-case transition-colors placeholder:text-fg-subtle hover:border-line-bold focus:border-gold focus:outline-none user-invalid:border-danger"></textarea>
        </label>

        <div class="flex flex-col gap-4 pt-1 sm:flex-row sm:items-center">
          <Button type="submit" class="contact-form__submit self-start data-[loading=true]:cursor-wait data-[loading=true]:opacity-70">
            {t("contact.formSubmit")}
            <Icon name="email" class="size-4" />
          </Button>
          <p
            class="contact-form__status text-sm font-semibold data-[state=error]:text-danger data-[state=success]:text-success"
            role="status"
            aria-live="polite"
            data-status-success={t("contact.formSuccess")}
            data-status-error={t("contact.formError")}
          >
          </p>
        </div>
        <p class="max-w-prose text-xs leading-relaxed text-fg-muted">{t("contact.dataUseNotice")}</p>
      </form>

      <div class="flex flex-col gap-5">
      <article class="flex grow flex-col border border-line bg-ink-850">
        <Picture
          src="/images/backgrounds/showroom.webp"
          alt={t("contact.showroomTitle")}
          sizes="(min-width: 64rem) 30vw, 100vw"
          class="aspect-[425/293] w-full object-cover"
        />
        <div class="flex flex-col gap-4 p-7 sm:p-8">
          <h3 class="text-sm font-extrabold tracking-[0.18em] text-gold uppercase">{t("contact.showroomTitle")}</h3>
          <p class="text-[0.9375rem] leading-relaxed text-fg-muted">{t("contact.showroomDesc")}</p>
          <address class="flex flex-col gap-3 not-italic">
            <a
              href="https://www.google.cz/maps/place/Hybe%C5%A1ova+308%2F61,+602+00+Brno-st%C5%99ed/@49.1887768,16.5968647,17z/data=!3m1!4b1!4m5!3m4!1s0x471294529732ae65:0x75c148bfafac76!8m2!3d49.1887733!4d16.5990534"
              rel="external"
              target="_blank"
              title={t("contact.showroomAddress")}
              class="flex flex-col gap-1 text-fg no-underline hover:text-gold-light"
            >
              <strong class="text-xl font-black tracking-[0.08em] uppercase">Hybešova 61</strong>
              <span class="text-[0.9375rem] text-fg-soft">602 00 Brno, {t("contact.czechia")}</span>
            </a>
            <a
              href="tel:+420601221551"
              class="inline-flex min-h-11 items-center gap-3 self-start text-lg font-extrabold tracking-[0.04em] text-gold no-underline hover:text-gold-light"
            >
              <Icon name="phone" class="size-5" />
              +420 601 221 551
            </a>
          </address>
        </div>
      </article>

      <article class="flex flex-col gap-4 border border-line bg-ink-900 p-7 sm:p-8">
        <h3 class="text-xs font-extrabold tracking-[0.18em] text-fg-muted uppercase">{t("contact.addressTitle")}</h3>
        <address class="flex flex-col gap-1 text-[0.9375rem] leading-relaxed text-fg-soft not-italic">
          <strong class="font-extrabold text-fg">OSM s.r.o.</strong>
          <span>Hudcova 86/54</span>
          <span>621 00 Brno, {t("contact.czechia")}</span>
        </address>
        <dl class="flex gap-8 text-sm text-fg-muted">
          <div class="flex gap-2"><dt><abbr title={t("contact.companyIdTitle")} class="no-underline">{t("contact.companyIdLabel")}</abbr></dt><dd class="font-bold text-fg">{contact.companyId}</dd></div>
          <div class="flex gap-2"><dt><abbr title={t("contact.vatIdTitle")} class="no-underline">{t("contact.vatIdLabel")}</abbr></dt><dd class="font-bold text-fg">{contact.vatId}</dd></div>
        </dl>
      </article>
      </div>
    </div>
  </div>
</section>

<dialog
  id="contact-thanks-dialog"
  class="dialog m-auto w-[min(36rem,calc(100vw-2.5rem))] border border-gold/50 bg-ink-850 p-0 text-fg"
  aria-labelledby="contact-thanks-title"
  aria-describedby="contact-thanks-desc"
  data-code-email-sent={t("contact.codeEmailSent")}
  data-code-email-failed={t("contact.codeEmailFailed")}
  data-code-copied={t("contact.codeCopied")}
  data-code-copy-error={t("contact.codeCopyError")}
>
  <div class="flex flex-col gap-6 p-7 sm:p-9">
    <div class="flex items-start justify-between gap-6">
      <h2 id="contact-thanks-title" class="text-2xl font-black tracking-[0.06em] uppercase">
        {t("contact.thanksTitle")}
      </h2>
      <button
        type="button"
        id="contact-thanks-close"
        class="grid size-11 shrink-0 cursor-pointer place-items-center border border-line-strong text-fg hover:border-gold hover:text-gold"
        aria-label={t("contact.thanksClose")}
        title={t("contact.thanksClose")}
      >
        <Icon name="close" class="size-4" />
      </button>
    </div>
    <p id="contact-thanks-desc" class="text-base leading-relaxed text-fg-soft">{t("contact.thanksDesc")}</p>
    <div class="flex flex-col gap-3 border border-gold/50 bg-ink-900 p-5">
      <p class="text-xs font-extrabold tracking-eyebrow text-fg-muted uppercase">{t("contact.codeLabel")}</p>
      <code id="contact-discount-code" tabindex="0" aria-live="polite" class="max-w-full break-all font-mono text-lg font-bold tracking-[0.08em] text-gold sm:text-2xl"></code>
      <p id="contact-code-email-status" class="text-sm leading-relaxed text-fg-soft" role="status" aria-live="polite"></p>
      <div class="flex flex-wrap items-center gap-3">
        <button
          type="button"
          id="contact-code-copy"
          class="min-h-11 border border-line-strong px-4 text-sm font-bold text-fg transition-colors hover:border-gold hover:text-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
        >{t("contact.codeCopy")}</button>
        <p id="contact-code-copy-status" class="text-sm text-fg-muted" role="status" aria-live="polite"></p>
      </div>
    </div>
    <p class="prose-inline text-base leading-relaxed text-fg-soft" set:html={t("contact.thanksBonus")} />
    <div class="flex justify-end">
      <Button href={galleryPath} id="contact-thanks-bonus" hidden class="[&[hidden]]:hidden!">
        {t("contact.thanksShowBonus")}
      </Button>
    </div>
  </div>
</dialog>

<script>
  // Unlocks the gated bonus tiles in the gallery; read by Showroom.astro.
  const BONUS_KEY = "bonusContentUnlocked";

  const unlockBonus = (): boolean => {
    try {
      localStorage.setItem(BONUS_KEY, "true");
      return true;
    } catch {
      // Private mode or blocked storage: the message still sent, so show the
      // thank-you without promising bonus content we cannot unlock.
      return false;
    }
  };

  const initThanksDialog = () => {
    const dialog = document.querySelector<HTMLDialogElement>(
      "#contact-thanks-dialog"
    );
    if (!dialog) return null;

    const close = dialog.querySelector<HTMLButtonElement>(
      "#contact-thanks-close"
    );
    close?.addEventListener("click", () => dialog.close());

    const code = dialog.querySelector<HTMLElement>("#contact-discount-code");
    const emailStatus = dialog.querySelector<HTMLElement>("#contact-code-email-status");
    const copyStatus = dialog.querySelector<HTMLElement>("#contact-code-copy-status");
    const copyButton = dialog.querySelector<HTMLButtonElement>("#contact-code-copy");
    copyButton?.addEventListener("click", async () => {
      const value = code?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(value);
        if (copyStatus) copyStatus.textContent = copyStatus.dataset.copied ?? "";
      } catch {
        if (copyStatus) copyStatus.textContent = copyStatus.dataset.copyError ?? "";
      }
    });

    if (copyStatus) {
      copyStatus.dataset.copied = dialog.dataset.codeCopied ?? "";
      copyStatus.dataset.copyError = dialog.dataset.codeCopyError ?? "";
    }

    return (unlocked: boolean, value: string, emailSent: boolean) => {
      const bonusLink = dialog.querySelector<HTMLAnchorElement>(
        "#contact-thanks-bonus"
      );
      // The bonus button only appears once the flag is genuinely stored.
      if (bonusLink) bonusLink.toggleAttribute("hidden", !unlocked);
      if (code) code.textContent = value;
      if (emailStatus) {
        emailStatus.textContent = emailSent
          ? dialog.dataset.codeEmailSent ?? ""
          : dialog.dataset.codeEmailFailed ?? "";
      }
      if (copyStatus) copyStatus.textContent = "";
      dialog.showModal();
    };
  };

  const showThanks = initThanksDialog();

  const form = document.querySelector<HTMLFormElement>(".contact-form");
  if (form) {
    const requestedCategory = new URLSearchParams(window.location.search).get("panel");
    const requestedChoice = requestedCategory === "mineral" || requestedCategory === "stone"
      ? form.querySelector<HTMLInputElement>(`input[name="panel_category_choice"][value="${requestedCategory}"]`)
      : null;
    if (requestedChoice) requestedChoice.checked = true;

    const fillAttributionFields = (): void => {
      try {
        const attribution = JSON.parse(
          sessionStorage.getItem("anewstyle-attribution-v1") || "{}",
        ) as Record<string, string>;
        form
          .querySelectorAll<HTMLInputElement>("input[data-attribution]")
          .forEach((input) => {
            input.value = attribution[input.name] ?? "";
          });
      } catch {
        // Keep attribution fields empty if browser storage is unavailable.
      }
    };

    fillAttributionFields();
    const status = form.querySelector<HTMLElement>(".contact-form__status");
    const submitBtn = form.querySelector<HTMLButtonElement>(
      ".contact-form__submit",
    );
    const successMessage = status?.dataset.statusSuccess ?? "";
    const errorMessage = status?.dataset.statusError ?? "";

    const newSubmissionId = (): string => {
      if (typeof crypto.randomUUID === "function") return crypto.randomUUID();
      const bytes = crypto.getRandomValues(new Uint8Array(16));
      bytes[6] = (bytes[6] & 0x0f) | 0x40;
      bytes[8] = (bytes[8] & 0x3f) | 0x80;
      const hex = [...bytes].map((byte) => byte.toString(16).padStart(2, "0")).join("");
      return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
    };

    const setStatus = (
      state: "idle" | "success" | "error",
      message: string,
    ): void => {
      if (!status) return;
      if (state === "idle") {
        status.removeAttribute("data-state");
      } else {
        status.dataset.state = state;
      }
      status.textContent = message;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const panelCategoryField = form.querySelector<HTMLInputElement>(
        'input[name="panel_category"]',
      );
      let submittedPanelCategory = "stone";
      if (panelCategoryField) {
        const selectedCategory = form.querySelector<HTMLInputElement>(
          'input[name="panel_category_choice"]:checked',
        )?.value;
        panelCategoryField.value =
          form.dataset.panelCategory ??
          selectedCategory ??
          document.documentElement.dataset.panelCategory ??
          panelCategoryField.value;
        submittedPanelCategory = panelCategoryField.value;
      }
      fillAttributionFields();

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());
      const fingerprint = JSON.stringify(payload);
      if (
        !form.dataset.submissionId ||
        form.dataset.submissionFingerprint !== fingerprint
      ) {
        form.dataset.submissionId = newSubmissionId();
        form.dataset.submissionFingerprint = fingerprint;
      }
      payload.submission_id = form.dataset.submissionId;

      setStatus("idle", "");
      if (submitBtn) submitBtn.dataset.loading = "true";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json", "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = (await response.json()) as {
          success?: boolean;
          code?: string;
          emailSent?: boolean;
        };

        if (response.ok && data.success && data.code) {
          setStatus("success", successMessage);
          form.reset();
          const categoryChoice = form.querySelector<HTMLInputElement>(
            `input[name="panel_category_choice"][value="${submittedPanelCategory}"]`,
          );
          if (categoryChoice) categoryChoice.checked = true;
          if (panelCategoryField) panelCategoryField.value = submittedPanelCategory;
          delete form.dataset.submissionId;
          delete form.dataset.submissionFingerprint;
          showThanks?.(unlockBonus(), data.code, data.emailSent === true);
        } else {
          setStatus("error", errorMessage);
        }
      } catch {
        setStatus("error", errorMessage);
      } finally {
        if (submitBtn) delete submitBtn.dataset.loading;
      }
    });
  }
</script>
