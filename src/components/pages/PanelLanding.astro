---
import Layout from "../../layouts/Layout.astro";
import Header from "../header/Header.astro";
import PanelCategorySwitch from "../ui/PanelCategorySwitch.astro";
import Showcase from "../sections/Showcase.astro";
import Products from "../sections/Products.astro";
import Technologies from "../sections/Technologies.astro";
import Features from "../sections/Features.astro";
import BeforeAfter from "../sections/BeforeAfter.astro";
import Faq from "../sections/Faq.astro";
import PriceList from "../sections/PriceList.astro";
import Contact from "../sections/Contact.astro";
import Button from "../ui/Button.astro";
import { getLangFromUrl, useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  category: "stone" | "mineral";
  lang?: Lang;
}

const { category, lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
const copy = {
  cs: {
    stone: {
      title: "Svítící kamenné panely",
      hero: "Interiérové světlo z přírodního kamene",
      heading: "Přírodní kámen, který rozzáří interiér",
      intro: "Celoplošně podsvícené panely z pravého kamene spojují jedinečnou kresbu přírodního materiálu s integrovaným osvětlením. Vyberte dekor, rozměr i výbavu a prohlédněte si možnosti provedení.",
      metaTitle: "Svítící kamenné panely na míru | ANEW STYLE",
      metaDescription: "Designové svítící panely z přírodního kamene. Prohlédněte si dekory ve 3D/AR, porovnejte provedení a vyžádejte si cenu na míru.",
    },
    mineral: {
      title: "Svítící minerální panely",
      hero: "Jemná kresba minerálu v hlavní roli",
      heading: "Minerální dekor s rovnoměrným podsvícením",
      intro: "Transparentní a rigidní minerální panel o tloušťce 6 mm nabízí jemnou kresbu dekoru a rovnoměrné podsvícení. Prohlédněte si dostupné vzory ve 3D/AR, porovnejte výbavu a vyberte rozměr.",
      metaTitle: "Svítící minerální panely na míru | ANEW STYLE",
      metaDescription: "Svítící minerální panely s transparentním, rigidním minerálním panelem o tloušťce 6 mm. Prohlédněte si vzory ve 3D/AR a vyžádejte si cenu.",
    },
  },
  en: {
    stone: {
      title: "Illuminated Stone Panels",
      hero: "Interior lighting made from natural stone",
      heading: "Natural stone that brings an interior to life",
      intro: "Full-surface backlit panels made from real stone combine the one-of-a-kind pattern of a natural material with integrated lighting. Choose a decor, size and finish, then explore the available options.",
      metaTitle: "Custom Illuminated Stone Panels | ANEW STYLE",
      metaDescription: "Designer illuminated panels made from natural stone. Explore decors in 3D/AR, compare finishes and request a custom quote.",
    },
    mineral: {
      title: "Illuminated Mineral Panels",
      hero: "A delicate mineral pattern takes centre stage",
      heading: "Mineral decor with even backlighting",
      intro: "A transparent, rigid 6 mm mineral panel combines a delicate decor with even backlighting. Explore the patterns in 3D/AR, compare finishes and choose a size.",
      metaTitle: "Custom Illuminated Mineral Panels | ANEW STYLE",
      metaDescription: "Illuminated mineral panels with a transparent, rigid 6 mm mineral sheet. Explore patterns in 3D/AR and request a custom quote.",
    },
  },
}[lang][category];

const pagePath = category === "stone"
  ? lang === "cs" ? "/svitici-kamenne-panely/" : "/en/illuminated-stone-panels/"
  : lang === "cs" ? "/svitici-mineralni-panely/" : "/en/illuminated-mineral-panels/";
const homePath = lang === "cs" ? "/" : "/en/";
const pageUrl = new URL(pagePath, Astro.site ?? Astro.url.origin).href;
const categoryName = category === "stone" ? t("price.categoryStone") : t("price.categoryMineral");
---

<Layout
  title={copy.metaTitle}
  description={copy.metaDescription}
  panelCategory={category}
  metaImageUrl={category === "stone" ? "/images/meta/meta-facebook.webp" : "/images/patterns/mineral-2.png"}
  pageType="CollectionPage"
  breadcrumbs={[
    { name: lang === "cs" ? "Domů" : "Home", url: new URL(homePath, Astro.site ?? Astro.url.origin).href },
    { name: categoryName, url: pageUrl },
  ]}
>
  <Header lang={lang} pageTitle={copy.title} pageDescription={copy.hero} />
  <PanelCategorySwitch lang={lang} activeCategory={category} />
  <main id="main">
    <section aria-labelledby="panel-landing-title" class="section-y bg-ink">
      <div class="container-page flex flex-col items-start gap-7">
        <div class="max-w-4xl">
          <p class="eyebrow">{categoryName}</p>
          <h2 id="panel-landing-title" class="mt-4 font-display text-3xl leading-tight font-black tracking-display uppercase sm:text-4xl lg:text-5xl">{copy.heading}</h2>
          <p class="mt-5 max-w-3xl text-lg leading-relaxed text-fg-muted">{copy.intro}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button href="#price-list">{t("nav.price")}</Button>
          <Button href="#contact" variant="outline">{t("nav.contact")}</Button>
        </div>
      </div>
    </section>
    <Showcase id="about" lang={lang} panelCategory={category} />
    <Products id="products" lang={lang} panelCategory={category} />
    <Technologies id="technologies" lang={lang} panelCategory={category} />
    <Features id="features" lang={lang} panelCategory={category} />
    <BeforeAfter lang={lang} panelCategory={category} />
    <Faq id="faq" lang={lang} panelCategory={category} />
    <PriceList id="price-list" lang={lang} panelCategory={category} />
    <Contact id="contact" lang={lang} panelCategory={category} />
  </main>
</Layout>
