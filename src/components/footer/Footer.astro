---
import Icon from "../icons/Icon.astro";
import {
  getPanelPagePath,
  useTranslations,
  type Lang,
  type PanelCategory,
} from "../../i18n/utils";

interface Props {
  lang?: Lang;
  panelCategory?: PanelCategory;
}

const { lang = "cs", panelCategory } = Astro.props;
const t = useTranslations(lang);
const basePath = lang === "cs" ? "" : "/en";
const links = panelCategory
  ? [
      { href: `${getPanelPagePath(panelCategory, lang)}#products`, text: t("nav.products") },
      { href: `${getPanelPagePath(panelCategory, lang)}#price-list`, text: t("nav.price") },
      { href: `${basePath}/#equipment-comparison`, text: t("nav.comparison") },
      { href: `${basePath}/gallery/`, text: t("nav.gallery") },
      { href: `${basePath}/faq/`, text: t("nav.faq") },
      { href: `${basePath}/manual/`, text: t("nav.manual") },
      { href: `${basePath}/?panel=${panelCategory}#contact`, text: t("nav.contact") },
    ]
  : [
      { href: getPanelPagePath("stone", lang), text: t("price.categoryStone") },
      { href: getPanelPagePath("mineral", lang), text: t("price.categoryMineral") },
      { href: `${basePath}/#contact`, text: t("nav.contact") },
      { href: `${basePath}/gallery/`, text: t("nav.gallery") },
      { href: `${basePath}/faq/`, text: t("nav.faq") },
      { href: `${basePath}/manual/`, text: t("nav.manual") },
    ];
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-line bg-ink">
  <div class="container-wide flex flex-col gap-8 py-10 lg:flex-row lg:items-center lg:justify-between">
    <a href={`${basePath}/`} class="flex items-center gap-3 text-fg no-underline">
      <img src="/images/logos/logo.svg" alt="" width="365" height="850" loading="lazy" class="h-9 w-auto" />
      <span class="text-[0.9375rem] font-black tracking-[0.3em]">ANEW STYLE</span>
    </a>
    <nav aria-label={t("nav.footer")}>
      <ul class="flex flex-wrap gap-x-6 gap-y-1">
        {links.map((link) => (
          <li>
            <a href={link.href} class="inline-flex min-h-11 items-center text-xs font-bold tracking-[0.12em] text-fg-muted uppercase no-underline hover:text-gold-light">
              {link.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="border-t border-line">
    <small class="container-wide flex flex-wrap items-center gap-x-4 gap-y-1 py-5 text-[0.8125rem] text-fg-muted">
      <span>©2022 – {currentYear} anewstyle.cz</span>
      <span aria-hidden="true" class="text-fg-disabled">|</span>
      <span>{t("footer.rights")}</span>
      <span aria-hidden="true" class="text-fg-disabled">|</span>
      <a
        href="#"
        id="footerCookieSettings"
        rel="nofollow noopener"
        class="inline-flex min-h-11 items-center gap-2 text-fg-soft hover:text-gold-light"
      >
        <Icon name="cookie" class="size-3.5" />
        {t("footer.cookieSettings")}
      </a>
      <span aria-hidden="true" class="text-fg-disabled">|</span>
      <span>
        {t("footer.creator")}{" "}
        <a
          href="https://lukaschylik.dev/"
          target="_blank"
          rel="external"
          title={t("footer.gotoCreator")}
          class="text-fg-soft hover:text-gold-light">Lukáš Chylík</a>
      </span>
    </small>
  </div>
</footer>

<script>
  const footerCookieLink = document.getElementById(
    "footerCookieSettings",
  ) as HTMLAnchorElement | null;
  footerCookieLink?.addEventListener("click", (e) => {
    e.preventDefault();
    // Prefer direct call if available, else broadcast event
    // @ts-ignore
    if (typeof window.__openCookieDialog === "function") {
      // @ts-ignore
      window.__openCookieDialog();
    } else {
      window.dispatchEvent(new CustomEvent("open-cookie-dialog"));
    }
  });
</script>
