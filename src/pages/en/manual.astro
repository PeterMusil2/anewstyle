---
import Layout from "../../layouts/Layout.astro";
import Manuals from "../../components/sections/Manuals.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const baseSite = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL("/en/manual/", baseSite).href;
const manualUrl = new URL(
  "/downloads/Manual_EN_AnewStyle_Basic_Deluxe.pdf",
  baseSite
).href;
---

<Layout
  title={t("meta.titleManual")}
  description={t("meta.descriptionManual")}
  metaImageUrl="/images/meta/meta-facebook.webp"
  pageType="WebPage"
  breadcrumbs={[
    { name: "Home", url: "/en/" },
    { name: "Manual", url: "/en/manual/" },
  ]}
  additionalStructuredData={[
    {
      "@type": "DigitalDocument",
      "@id": `${manualUrl}#document`,
      name: t("manual.cardTitle"),
      url: manualUrl,
      encodingFormat: "application/pdf",
      inLanguage: lang,
      mainEntityOfPage: { "@id": `${pageUrl}#webpage` },
    },
  ]}
>
  <main>
    <Manuals lang={lang} />
  </main>
</Layout>
