---
import NavItem from "./NavItem.astro";
import InfoNavItem from "./InfoNavItem.astro";
import PanelNavSwitch from "./PanelNavSwitch.astro";
import PriceNavItem from "./PriceNavItem.astro";
import LangSwitch from "../langSwitch/LangSwitch.astro";
import ThemeToggle from "../theme/ThemeToggle.astro";
import Button from "../ui/Button.astro";
import Icon from "../icons/Icon.astro";
import { useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang?: Lang;
  panelCategory?: "stone" | "mineral";
}

const { lang = "cs", panelCategory } = Astro.props;
const t = useTranslations(lang);

const basePath = lang === "cs" ? "" : "/en";
const normalizedPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isHomePage = normalizedPath === (lang === "cs" ? "/" : "/en");
const eshopUrl = "https://www.anewstyle-eshop.cz/";

const homeLinks = [
  { href: `${basePath}/#technologies`, text: t("nav.technologies") },
  { href: `${basePath}/#features`, text: t("nav.features") },
];

const contactLink = {
  href: panelCategory ? `${basePath}/?panel=${panelCategory}#contact` : `${basePath}/#contact`,
  text: t("nav.contact"),
};
---

<div class="site-nav fixed inset-x-0 top-0 z-50">
  <nav aria-label={t("nav.main")} class="site-nav__bar border-b border-line">
    <div class="container-wide flex h-(--nav-height) items-center justify-between gap-3 sm:gap-6">
      <a
        href={`${basePath}/`}
        aria-label={t("nav.home")}
        class="flex min-w-0 shrink items-center gap-2.5 text-fg no-underline sm:gap-3.5"
      >
        <img
          src="/images/logos/logo.svg"
          alt=""
          width="365"
          height="850"
          class="h-10 w-auto shrink-0 lg:h-13"
        />
        <span class="flex flex-col gap-0.5">
          <span class="text-sm font-black tracking-[0.2em] whitespace-nowrap sm:text-base sm:tracking-[0.3em] lg:text-lg">ANEW STYLE</span>
          <span class="hidden text-[0.625rem] tracking-[0.18em] text-fg-muted uppercase sm:block xl:hidden 2xl:block">
            {t("header.title")}
          </span>
        </span>
      </a>

      <ul class="hidden items-center gap-3 min-[1200px]:flex 2xl:gap-8">
        <PanelNavSwitch lang={lang} panelCategory={panelCategory} isHomePage={isHomePage} />
        {homeLinks.map((link) => <NavItem {...link} />)}
        <InfoNavItem lang={lang} />
        <PriceNavItem lang={lang} />
        <NavItem {...contactLink} />
      </ul>

      <div class="flex items-center gap-2 sm:gap-3">
        <Button
          href={eshopUrl}
          variant="outline"
          size="sm"
          rel="external"
          target="_blank"
          class="max-md:hidden!"
        >
          {t("nav.eshop")}
          <Icon name="eshop" class="size-4" />
        </Button>
        <ThemeToggle lang={lang} />
        <LangSwitch lang={lang} />
        <button
          type="button"
          popovertarget="mobile-menu"
          class="inline-flex size-11 cursor-pointer items-center justify-center border border-line-bold text-fg transition-colors hover:border-gold hover:text-gold min-[1200px]:hidden"
          aria-label={t("nav.openMenu")}
        >
          <Icon name="menu" class="size-5" />
        </button>
      </div>
    </div>
  </nav>

  <div
    id="mobile-menu"
    popover
    class="pop-panel fixed inset-x-0 top-(--nav-height) bottom-auto m-0 max-h-[calc(100dvh-var(--nav-height))] w-full overflow-y-auto border-b border-line-strong bg-ink-900 text-fg min-[1200px]:hidden"
  >
    <div class="container-wide flex flex-col gap-8 pt-4 pb-8">
      <ul class="flex flex-col">
        <PanelNavSwitch lang={lang} panelCategory={panelCategory} isHomePage={isHomePage} variant="panel" />
        {homeLinks.map((link) => <NavItem {...link} variant="panel" />)}
        <InfoNavItem lang={lang} variant="panel" />
        <PriceNavItem lang={lang} variant="panel" />
        <NavItem {...contactLink} variant="panel" />
      </ul>
      <div class="flex items-center justify-between gap-4">
        <Button href={eshopUrl} variant="outline" rel="external" target="_blank" class="flex-1">
          {t("nav.eshop")}
          <Icon name="eshop" class="size-4" />
        </Button>
        <button
          type="button"
          popovertarget="mobile-menu"
          popovertargetaction="hide"
          class="inline-flex size-13 cursor-pointer items-center justify-center border border-line-bold text-fg hover:border-gold hover:text-gold"
          aria-label={t("nav.closeMenu")}
        >
          <Icon name="close" class="size-5" />
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const menu = document.getElementById("mobile-menu");
  const mobileDropdowns = menu?.querySelectorAll<HTMLDetailsElement>("details") ?? [];
  const closeMobileDropdowns = () => mobileDropdowns.forEach((details) => { details.open = false; });
  const mobileHover = window.matchMedia("(max-width: 1199px) and (hover: hover) and (pointer: fine)");
  const closeMobileDropdownTree = (root: HTMLDetailsElement) => {
    mobileDropdowns.forEach((details) => {
      if (details === root || root.contains(details)) details.open = false;
    });
  };

  mobileDropdowns.forEach((details) => {
    details.addEventListener("pointerleave", (event) => {
      if (mobileHover.matches && event.pointerType === "mouse") closeMobileDropdownTree(details);
    });
  });

  menu?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const clickedDropdown = target.closest("details");
    const clickedSummary = target.closest("summary");
    if (!clickedDropdown) {
      closeMobileDropdowns();
    } else {
      const clickedDirectSummary = clickedDropdown.querySelector(":scope > summary");
      const clickedParentSummary = clickedSummary === clickedDirectSummary;
      mobileDropdowns.forEach((details) => {
        if (details === clickedDropdown || details.contains(clickedDropdown)) return;
        if (clickedDropdown.contains(details)) {
          if (clickedParentSummary) details.open = false;
          return;
        }
        details.open = false;
      });
    }

    if (target.closest("[data-nav-link]")) {
      closeMobileDropdowns();
      menu.hidePopover();
    }
  });

  menu?.addEventListener("toggle", () => {
    if (!menu.matches(":popover-open")) closeMobileDropdowns();
  });

  const desktopHover = window.matchMedia("(min-width: 1200px) and (hover: hover) and (pointer: fine)");
  const desktopDropdowns = document.querySelectorAll<HTMLDetailsElement>(
    ".site-nav__bar .panel-nav-switch--bar details, .site-nav__bar .info-nav-item--bar details, .site-nav__bar .price-nav-item details",
  );
  const closeDesktopDropdowns = () => desktopDropdowns.forEach((details) => { details.open = false; });

  desktopDropdowns.forEach((details) => {
    const summary = details.querySelector("summary");

    details.addEventListener("pointerenter", (event) => {
      if (desktopHover.matches && event.pointerType === "mouse") details.open = true;
    });
    details.addEventListener("pointerleave", (event) => {
      if (desktopHover.matches && event.pointerType === "mouse") details.open = false;
    });
    summary?.addEventListener("click", (event) => {
      if (desktopHover.matches && event.detail > 0) {
        event.preventDefault();
        details.open = true;
      }
    });
    details.addEventListener("focusout", (event) => {
      if (!details.contains(event.relatedTarget as Node | null)) details.open = false;
    });
    details.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        details.open = false;
        summary?.focus();
      }
    });
  });

  window.addEventListener("scroll", () => {
    if (desktopHover.matches) closeDesktopDropdowns();
  }, { passive: true });
  desktopHover.addEventListener("change", closeDesktopDropdowns);

  const navLinks = document.querySelectorAll<HTMLAnchorElement>(".site-nav [data-nav-link]");
  const normalizePath = (path: string) => path.replace(/\/+$/, "") || "/";

  const updateActiveNavLinks = () => {
    navLinks.forEach((link) => {
      const targetUrl = new URL(link.href, window.location.href);
      const samePage = normalizePath(targetUrl.pathname) === normalizePath(window.location.pathname);
      const target = targetUrl.hash ? document.getElementById(decodeURIComponent(targetUrl.hash.slice(1))) : null;
      let active = samePage && !targetUrl.hash;

      if (samePage && target) {
        const { top, bottom } = target.getBoundingClientRect();
        active = top <= window.innerHeight * 0.55 && bottom >= window.innerHeight * 0.35;
      }

      if (active) {
        link.dataset.active = "true";
        link.setAttribute("aria-current", targetUrl.hash ? "location" : "page");
      } else {
        delete link.dataset.active;
        link.removeAttribute("aria-current");
      }
    });

    document.querySelectorAll<HTMLDetailsElement>(".site-nav .info-nav-item details").forEach((details) => {
      const summary = details.querySelector("summary");
      const hasActiveDestination = details.querySelector('[data-nav-link][data-active="true"]');
      if (hasActiveDestination) summary?.setAttribute("data-active", "true");
      else summary?.removeAttribute("data-active");
    });
  };

  updateActiveNavLinks();
  window.addEventListener("scroll", updateActiveNavLinks, { passive: true });
  window.addEventListener("resize", updateActiveNavLinks, { passive: true });
  window.addEventListener("hashchange", updateActiveNavLinks);
  window.addEventListener("popstate", updateActiveNavLinks);
</script>
