---
interface Props {
  href: string;
  text: string;
  accent?: boolean;
  variant?: "bar" | "panel";
}

const { href, text, accent = false, variant = "bar" } = Astro.props;
---

<li>
  <a
    href={href}
    data-nav-link
    data-nav-level="primary"
    class:list={[
      "flex items-center whitespace-nowrap no-underline transition-colors duration-200 hover:text-gold-light",
      variant === "bar" && "min-h-11",
      variant === "panel" &&
        "min-h-14 border-b border-line",
      accent ? "text-gold" : "text-fg-soft",
    ]}
  >
    {text}
  </a>
</li>

<style>
  a[data-active="true"] {
    color: var(--color-gold);
  }

  a[data-active="true"]:is(:hover, :focus-visible) {
    color: var(--color-gold-light);
  }
</style>
