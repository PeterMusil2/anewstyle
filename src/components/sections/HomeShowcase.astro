---
import Picture from "../ui/Picture.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import Icon from "../icons/Icon.astro";
import Button from "../ui/Button.astro";
import { getPanelPagePath, useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "cs" } = Astro.props;
const t = useTranslations(lang);
const stoneHref = getPanelPagePath("stone", lang);
const mineralHref = getPanelPagePath("mineral", lang);
const states = [
  { value: "off", icon: "turn-off", label: t("showcase.btn1") },
  { value: "frame", icon: "frame", label: t("showcase.btn2") },
  { value: "panel", icon: "bulp", label: t("showcase.btn3") },
];
const stoneImages = [
  { state: "off", src: "/images/showcase/rockfoil_pink_dark.jpg" },
  { state: "frame", src: "/images/showcase/rockfoil_pink_dark.jpg" },
  { state: "panel", src: "/images/showcase/rockfoil_pink_light.jpg" },
];
const mineralImages = [
  { state: "off", src: "/images/showcase/Mineral_off.png" },
  { state: "frame", src: "/images/showcase/Mineral_off.png" },
  { state: "panel", src: "/images/showcase/Mineral_on.png" },
];
---

<section id="about" aria-labelledby="about-title" class="showcase home-section-y home-section-divider relative isolate overflow-hidden bg-ink text-fg">
  <div class="container-page flex flex-col gap-5 sm:gap-8 lg:grid lg:grid-cols-[minmax(0,18rem)_minmax(0,1fr)] lg:grid-rows-[auto_1fr] lg:items-start lg:gap-x-8 lg:gap-y-6 xl:gap-x-12">
    <SectionHeader id="about-title" layout="left" eyebrow={t("home.chapterLight")} title={t("home.showcaseTitle")} class="lg:col-start-1 lg:row-start-1" />

    <div class="home-showcase-comparison mx-auto flex w-full max-w-6xl flex-col gap-2 sm:gap-3 lg:contents">
      <fieldset class="mx-auto flex w-full min-w-0 max-w-2xl flex-col gap-2 lg:col-start-1 lg:row-start-2">
        <legend class="mb-1 text-center text-xs font-bold tracking-eyebrow text-fg-muted uppercase lg:text-left">{t("showcase.stateLabel")}</legend>
        <div class="grid grid-cols-3 border border-line-strong lg:grid-cols-1 lg:divide-y lg:divide-line-strong">
          {states.map((state) => (
            <label class="flex min-h-11 cursor-pointer flex-col items-center justify-center gap-1 px-1.5 py-1.5 text-center text-xs leading-tight font-bold text-fg transition-colors duration-200 not-last:border-r not-last:border-line-strong hover:bg-ink-850 has-checked:bg-gold has-checked:text-ink has-focus-visible:outline-2 has-focus-visible:-outline-offset-4 has-focus-visible:outline-gold sm:min-h-14 sm:flex-row sm:gap-2.5 sm:px-2 sm:py-3 sm:text-[0.8125rem] lg:min-h-11 lg:justify-start lg:px-4 lg:py-2 lg:text-left lg:not-last:border-r-0">
              <input type="radio" name="home-showcase-state" value={state.value} checked={state.value === "panel"} class="sr-only" />
              <Icon name={state.icon} class="size-4 sm:size-5" />
              <span>{state.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="grid grid-cols-2 items-stretch gap-3 sm:gap-5 lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <article class="relative isolate flex min-w-0 flex-col gap-3 border border-line bg-ink-900 p-1 hover:border-gold focus-within:border-gold sm:p-4" aria-label={t("price.categoryStone")}>
          <div class="showcase__stage home-showcase-stage relative aspect-[1024/1000] w-full bg-transparent">
            <div class="showcase__stone-states absolute inset-0">
              {stoneImages.map((image) => (
                <Picture src={image.src} alt={`${t("price.categoryStone")} – ${states.find((state) => state.value === image.state)?.label ?? ""}`} sizes="(min-width: 64rem) 19rem, 100vw" data-state={image.state} class="absolute inset-0 size-full object-contain" />
              ))}
            </div>
            <div class="showcase__stone-reflection" aria-hidden="true">
              {stoneImages.map((image) => (
                <Picture src={image.src} alt="" sizes="(min-width: 64rem) 19rem, 100vw" data-state={image.state} class="showcase__stone-reflection-image" />
              ))}
            </div>
          </div>
          <div class="flex min-w-0 flex-col items-center gap-2.5">
            <Button href={stoneHref} size="sm" class="showcase-card-link w-full max-w-sm px-2! whitespace-normal! leading-tight tracking-normal sm:min-h-12 sm:px-4! sm:text-sm">{t("home.openStone")}</Button>
            <p class="text-center text-xs text-fg-soft sm:text-sm">{t("header.stoneMaterial")}</p>
          </div>
        </article>

        <article class="relative isolate flex min-w-0 flex-col gap-3 border border-line bg-ink-900 p-1 hover:border-gold focus-within:border-gold sm:p-4" aria-label={t("price.categoryMineral")}>
          <div class="showcase__stage home-showcase-stage relative aspect-[1024/1000] w-full bg-transparent">
            <div class="showcase__mineral-showcase absolute inset-0 grid place-items-center">
              <div class="showcase__mineral-reflection" aria-hidden="true">
                {mineralImages.map((image) => (
                  <Picture src={image.src} alt="" sizes="(min-width: 64rem) 11rem, 45vw" data-state={image.state} class="showcase__mineral-texture size-full object-cover" />
                ))}
              </div>
              <div class="showcase__mineral-panel overflow-hidden border border-transparent bg-transparent">
                {mineralImages.map((image) => (
                  <Picture src={image.src} alt={`${t("price.categoryMineral")} – ${states.find((state) => state.value === image.state)?.label ?? ""}`} sizes="(min-width: 64rem) 11rem, 45vw" data-state={image.state} class="showcase__mineral-texture size-full object-cover" />
                ))}
              </div>
            </div>
          </div>
          <div class="flex min-w-0 flex-col items-center gap-2.5">
            <Button href={mineralHref} size="sm" class="showcase-card-link w-full max-w-sm px-2! whitespace-normal! leading-tight tracking-normal sm:min-h-12 sm:px-4! sm:text-sm">{t("home.openMineral")}</Button>
            <p class="text-center text-xs text-fg-soft sm:text-sm">{t("header.mineralMaterial")}</p>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  /* One link per card makes both the image and button clickable. */
  .showcase-card-link::after {
    position: absolute;
    z-index: 10;
    inset: 0;
    content: "";
  }

  /* Keep the visible stone and mineral panel faces the same size after
     accounting for the stone image's 90-degree rotation. */
  :global(.home-showcase-stage .showcase__stone-states [data-state]) {
    top: 53%;
    width: 100.65%;
    height: 51.55%;
  }

  :global(.home-showcase-stage .showcase__mineral-panel) {
    top: 53%;
    width: 53.7%;
    height: 104.85%;
    transform: translate(-50%, -50%);
  }

  :global(.home-showcase-stage .showcase__mineral-reflection) {
    top: 110.5%;
    width: 53.7%;
    height: 104.85%;
  }

  @media (width >= 64rem) {
    .home-showcase-stage {
      /* Reserve space for the visible reflection and the controls below it. */
      --stage-width: clamp(8rem, calc((100svh - 15rem) / 1.36), 19rem);
      inline-size: min(100%, var(--stage-width));
      margin-inline: auto;
      margin-block-end: min(38%, calc(var(--stage-width) * 0.38));
    }
  }

  :global(.home-showcase-stage .showcase__stone-reflection) {
    top: 108.3%;
    width: 51.55%;
    height: 100.65%;
  }

  :global(.home-showcase-stage) {
    margin-block-end: 38%;
  }

  :global(.home-showcase-stage .showcase__mineral-reflection) {
    background: transparent;
    border: 0;
  }

  @media (width < 40rem) {
    :global(.home-showcase-stage) {
      margin-block-end: 62%;
      overflow: visible;
    }

    :global(.home-showcase-stage .showcase__stone-states [data-state]) {
      top: 62%;
      width: 118.1%;
      height: 59.04%;
    }

    :global(.home-showcase-stage .showcase__mineral-panel) {
      top: 62%;
      width: 61.5%;
      height: 123%;
      transform: translate(-50%, -50%);
    }

    :global(.home-showcase-stage .showcase__mineral-reflection) {
      top: 128.5%;
      width: 61.5%;
      height: 123%;
    }

    :global(.home-showcase-stage .showcase__stone-reflection) {
      top: 126%;
      width: 59.04%;
      height: 118.1%;
    }

  }
</style>
