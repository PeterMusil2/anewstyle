---
/**
 * RAL frame colours. The swatches orbit out of one circle when the button is
 * pressed – the motion lives in effects.css (.palette).
 */
import { useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "cs" } = Astro.props;
const t = useTranslations(lang);

const swatches = [
  { code: "150M", color: "hsl(23.64deg 16.42% 60.59%)" },
  { code: "140M", color: "hsl(38.4deg 24.04% 59.22%)" },
  { code: "260M", color: "#a38c52" },
  { code: "280M", color: "hsl(37.37deg 47.11% 47.45%)" },
];
---

<button
  class="palette relative grid size-32 shrink-0 cursor-pointer place-items-center rounded-full"
  type="button"
  aria-pressed="false"
  aria-label={t("features.showColors")}
>
  {
    swatches.map((swatch) => (
      <span
        class="palette__swatch absolute inset-0 grid place-items-center rounded-full shadow-lg transition-[translate] duration-300"
        style={`background-color: ${swatch.color}`}
      >
        <span class="palette__code text-[0.6875rem] font-extrabold text-black">{swatch.code}</span>
      </span>
    ))
  }
  <span class="palette__label relative z-10 max-w-[80%] text-center text-[0.6875rem] leading-tight font-black tracking-[0.06em] text-black uppercase transition-opacity">
    {t("features.showColors")}
  </span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>(".palette").forEach((palette) => {
    palette.addEventListener("click", () => {
      const pressed = palette.getAttribute("aria-pressed") === "true";
      palette.setAttribute("aria-pressed", String(!pressed));
    });
  });
</script>
