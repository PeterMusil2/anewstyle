---
import Icon from "../icons/Icon.astro";
import { useTranslations, type Lang } from "../../i18n/utils";
import { getGalleryItems } from "../../lib/cloudinary-gallery";

interface Props {
  id: string;
  lang?: Lang;
}

const { id, lang = "cs" } = Astro.props;
const t = useTranslations(lang);

// Images and videos loaded from the Cloudinary `AnewStyle/Gallery` folder at
// build time. Falls back to an empty list when the JSON hasn't been generated.
const rawGalleryItems = await getGalleryItems();

// Display order mirrors the segment control: videos first, then 360, then photos.
const GALLERY_ORDER: Record<string, number> = { video: 0, "360": 1, image: 2 };
const cloudinaryItems = [...rawGalleryItems].sort(
  (a, b) => (GALLERY_ORDER[a.type] ?? 99) - (GALLERY_ORDER[b.type] ?? 99),
);

// Tile widths the browser picks from, mirroring the .gallery column counts:
// 1 column on mobile, 2 on tablet, 3 on small laptops, 4 above that.
const GALLERY_SIZES =
  "(max-width: 480px) 100vw, (max-width: 768px) 50vw, (max-width: 1200px) 33vw, 25vw";

// 360° panoramas open in a lazy-loaded Photo Sphere Viewer overlay.
const panoLabels = {
  close: lang === "en" ? "Close" : "Zavřít",
  prev: lang === "en" ? "Previous panorama" : "Předchozí panorama",
  next: lang === "en" ? "Next panorama" : "Další panorama",
};
---

<section id={id}>
  <div class="container">
    <h2 class="title text-center title--mg-s">{t("gallery.title")}</h2>
    <p class="desc text-center">
      <span>{t("gallery.descPart1")}</span>
      <strong>{t("gallery.descPart2")}</strong>
      <span>{t("gallery.descPart3")}</span>
      <strong>{t("gallery.descPart4")}</strong>
      <span>{t("gallery.descPart5")}</span>
    </p>
  </div>
  <div class="container segment-filter-wrap">
    <div
      class="segment-filter segment-filter--fit"
      role="group"
      aria-label={t("gallery.filterAriaLabel")}
    >
      <button
        type="button"
        class="segment-filter__btn"
        data-filter=""
        aria-pressed="true"
      >
        <span>{t("gallery.filterAll")}</span>
      </button>
      <button
        type="button"
        class="segment-filter__btn"
        data-filter="video"
        aria-pressed="false"
      >
        <span>{t("gallery.filterVideos")}</span>
      </button>
      <button
        type="button"
        class="segment-filter__btn"
        data-filter="360"
        aria-pressed="false"
      >
        <span>{t("gallery.filter360")}</span>
      </button>
      <button
        type="button"
        class="segment-filter__btn"
        data-filter="image"
        aria-pressed="false"
      >
        <span>{t("gallery.filterImages")}</span>
      </button>
      <button
        type="button"
        class="segment-filter__btn segment-filter__btn--bonus"
        data-filter="bonus"
        aria-pressed="false"
        hidden
      >
        <span>{t("gallery.filterBonus")}</span>
      </button>
    </div>
  </div>
  <div
    class="container gallery"
    data-pano-close={panoLabels.close}
    data-pano-prev={panoLabels.prev}
    data-pano-next={panoLabels.next}
  >
    {
      cloudinaryItems.map((item) =>
        item.type === "360" ? (
          <a
            href={item.full}
            aria-label={item.alt ?? t("gallery.preview360Day")}
            data-media="360"
            data-bonus={item.bonus ? "true" : undefined}
            data-pano={item.bonus ? undefined : item.full}
            data-pano-locked={item.bonus ? item.full : undefined}
            class="gitem"
            rel="noopener"
          >
            <div class="gitem__photo">
              <picture>
                {item.thumbAvif && (
                  <source
                    type="image/avif"
                    srcset={item.thumbAvif}
                    sizes={GALLERY_SIZES}
                  />
                )}
                {item.thumbWebp && (
                  <source
                    type="image/webp"
                    srcset={item.thumbWebp}
                    sizes={GALLERY_SIZES}
                  />
                )}
                <img
                  src={item.thumb}
                  loading="lazy"
                  decoding="async"
                  width={item.width}
                  height={item.height}
                  alt={item.alt ?? t("gallery.preview360Day")}
                />
              </picture>
            </div>
            <div class="gitem__content">
              <Icon name="360" />
            </div>
          </a>
        ) : (
          <a
            href={item.full}
            aria-label={item.alt ?? t("products.stoneAsLighting")}
            data-fancybox={item.bonus ? undefined : "gallery"}
            data-fancybox-locked={item.bonus ? "gallery" : undefined}
            data-media={item.type}
            data-bonus={item.bonus ? "true" : undefined}
            class="gitem"
            rel="noopener"
          >
            <div class="gitem__photo">
              <picture>
                {item.thumbAvif && (
                  <source
                    type="image/avif"
                    srcset={item.thumbAvif}
                    sizes={GALLERY_SIZES}
                  />
                )}
                {item.thumbWebp && (
                  <source
                    type="image/webp"
                    srcset={item.thumbWebp}
                    sizes={GALLERY_SIZES}
                  />
                )}
                <img
                  src={item.thumb}
                  loading="lazy"
                  decoding="async"
                  width={item.width}
                  height={item.height}
                  alt={item.alt ?? t("products.stoneAsLighting")}
                />
              </picture>
            </div>
            {item.type === "video" && (
              <div class="gitem__content">
                <Icon name="play" />
              </div>
            )}
          </a>
        ),
      )
    }
  </div>
  <div class="container">
    <p class="desc desc--mg-s desc--center">
      <span>{t("gallery.underText")}</span>{" "}
      <a
        href="https://www.designatak.cz/"
        aria-label={t("gallery.gotoAtakDesign")}
        class="link"
        style="text-decoration: underline;"
        rel="external"
      >
        ATAK Design
      </a>.
      <br /><br />
      <picture class="atak-logo">
        <source
          type="image/avif"
          sizes="(min-width: 100px)"
          srcset="/images/logos/atak-logo.avif"
        />
        <source
          type="image/webp"
          sizes="(min-width: 100px)"
          srcset="/images/logos/atak-logo.webp"
        />
        <img
          src="/images/logos/atak-logo.webp"
          loading="lazy"
          width="250"
          alt={t("common.atakLogoAlt")}
        />
      </picture>
    </p>
  </div>
</section>

<script>
  // Set once the visitor submits the contact form; see Contact.astro.
  const BONUS_KEY = "bonusContentUnlocked";

  const isBonusUnlocked = (): boolean => {
    try {
      return localStorage.getItem(BONUS_KEY) === "true";
    } catch {
      // Private mode or blocked storage: stay locked rather than throwing.
      return false;
    }
  };

  const initGalleryFilter = () => {
    const gallery = document.querySelector<HTMLElement>(".gallery");
    const filter = gallery
      ?.closest("section")
      ?.querySelector<HTMLElement>(".segment-filter");
    if (!filter || !gallery) return;

    // Reveal the bonus tiles and their filter only for unlocked visitors. The
    // markup ships locked, so the gated content never flashes before this runs.
    if (isBonusUnlocked()) {
      gallery.dataset.bonusUnlocked = "true";
      filter
        .querySelectorAll<HTMLButtonElement>(".segment-filter__btn--bonus")
        .forEach((btn) => btn.removeAttribute("hidden"));

      // Bonus tiles ship without the attributes that make them openable, so a
      // locked visitor cannot reach them by paging through the lightbox or the
      // panorama viewer. Promote them to the real attributes now.
      gallery
        .querySelectorAll<HTMLElement>("[data-fancybox-locked]")
        .forEach((el) => {
          el.dataset.fancybox = el.dataset.fancyboxLocked ?? "gallery";
          delete el.dataset.fancyboxLocked;
        });

      gallery
        .querySelectorAll<HTMLElement>("[data-pano-locked]")
        .forEach((el) => {
          el.dataset.pano = el.dataset.panoLocked ?? "";
          delete el.dataset.panoLocked;
        });
    }

    const buttons = filter.querySelectorAll<HTMLButtonElement>(
      ".segment-filter__btn",
    );

    const activate = (btn: HTMLButtonElement) => {
      buttons.forEach((b) => b.setAttribute("aria-pressed", "false"));
      btn.setAttribute("aria-pressed", "true");

      const value = btn.dataset.filter ?? "";
      if (value) {
        gallery.setAttribute("data-filter", value);
      } else {
        gallery.removeAttribute("data-filter");
      }
    };

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.getAttribute("aria-pressed") === "true") return;
        activate(btn);
      });
    });

    // ?filter=<value> preselects a segment on arrival - the thank-you modal
    // links here with ?filter=bonus. A hidden button (bonus while locked) is
    // ignored, so the URL can never expose gated content.
    const requested = new URLSearchParams(location.search).get("filter");
    if (requested) {
      const target = Array.from(buttons).find(
        (btn) => btn.dataset.filter === requested && !btn.hidden,
      );
      if (target) activate(target);
    }
  };

  initGalleryFilter();
  document.addEventListener("astro:page-load", initGalleryFilter);
</script>

<script>
  // Lazy 360° panorama viewer. Photo Sphere Viewer (WebGL/three.js) and its CSS
  // are only fetched the first time a visitor opens a panorama. Prev/next cycle
  // through every panorama in the gallery by swapping the source on one viewer.
  const initPanoViewer = () => {
    const triggers = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("a[data-pano]"),
    );
    if (triggers.length === 0) return;

    const urls = triggers
      .map((trigger) => trigger.dataset.pano ?? "")
      .filter(Boolean);
    const gallery = document.querySelector<HTMLElement>(".gallery");
    const labels = {
      close: gallery?.dataset.panoClose ?? "Close",
      prev: gallery?.dataset.panoPrev ?? "Previous",
      next: gallery?.dataset.panoNext ?? "Next",
    };

    let closeActive: (() => void) | null = null;

    const button = (
      className: string,
      label: string,
      glyph: string,
    ): HTMLButtonElement => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = className;
      btn.setAttribute("aria-label", label);
      btn.innerHTML = glyph;
      return btn;
    };

    const open = async (startIndex: number): Promise<void> => {
      let index = startIndex;

      const modal = document.createElement("div");
      modal.className = "pano-modal";
      modal.setAttribute("role", "dialog");
      modal.setAttribute("aria-modal", "true");

      const stage = document.createElement("div");
      stage.className = "pano-modal__stage";

      const closeBtn = button("pano-modal__close", labels.close, "&times;");
      modal.append(stage, closeBtn);

      const multiple = urls.length > 1;
      const prevBtn = multiple
        ? button(
            "pano-modal__nav pano-modal__nav--prev",
            labels.prev,
            "&lsaquo;",
          )
        : null;
      const nextBtn = multiple
        ? button(
            "pano-modal__nav pano-modal__nav--next",
            labels.next,
            "&rsaquo;",
          )
        : null;
      if (prevBtn && nextBtn) modal.append(prevBtn, nextBtn);

      document.body.append(modal);
      document.documentElement.style.overflow = "hidden";

      const [{ Viewer }] = await Promise.all([
        import("@photo-sphere-viewer/core"),
        import("@photo-sphere-viewer/core/index.css"),
      ]);

      const viewer = new Viewer({
        container: stage,
        panorama: urls[index],
        navbar: ["zoom", "move", "fullscreen"],
      });

      const go = (delta: number): void => {
        index = (index + delta + urls.length) % urls.length;
        void viewer.setPanorama(urls[index], { showLoader: true });
      };

      const onKey = (event: KeyboardEvent): void => {
        if (event.key === "Escape") close();
        else if (event.key === "ArrowLeft" && multiple) go(-1);
        else if (event.key === "ArrowRight" && multiple) go(1);
      };

      const close = (): void => {
        document.removeEventListener("keydown", onKey);
        viewer.destroy();
        modal.remove();
        document.documentElement.style.overflow = "";
        closeActive = null;
      };

      closeBtn.addEventListener("click", close);
      prevBtn?.addEventListener("click", () => go(-1));
      nextBtn?.addEventListener("click", () => go(1));
      modal.addEventListener("click", (event) => {
        if (event.target === modal) close();
      });
      document.addEventListener("keydown", onKey);
      closeActive = close;
    };

    triggers.forEach((trigger, triggerIndex) => {
      if (trigger.dataset.panoBound) return;
      trigger.dataset.panoBound = "1";
      trigger.addEventListener("click", (event) => {
        if (!trigger.dataset.pano) return;
        event.preventDefault();
        closeActive?.();
        void open(triggerIndex);
      });
    });
  };

  initPanoViewer();
  document.addEventListener("astro:page-load", initPanoViewer);
</script>
