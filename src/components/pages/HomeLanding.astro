---
import Layout from "../../layouts/Layout.astro";
import Header from "../header/Header.astro";
import HomeShowcase from "../sections/HomeShowcase.astro";
import MaterialOverview from "../sections/MaterialOverview.astro";
import Features from "../sections/Features.astro";
import HomeEquipmentComparison from "../sections/HomeEquipmentComparison.astro";
import HomeDayNight from "../sections/HomeDayNight.astro";
import Contact from "../sections/Contact.astro";
import { getLangFromUrl, useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
---

<Layout
  title={t("meta.titleHome")}
  description={t("meta.descriptionHome")}
  metaImageUrl="/images/meta/meta-facebook.webp"
  pageType="WebPage"
>
  <main id="main">
    <Header lang={lang} home />
    <HomeShowcase lang={lang} />
    <MaterialOverview lang={lang} />
    <Features id="features" lang={lang} showBoth />
    <HomeEquipmentComparison lang={lang} />
    <HomeDayNight lang={lang} />
    <Contact id="contact" lang={lang} />
  </main>
</Layout>
