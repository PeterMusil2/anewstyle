---
/**
 * Inline SVG icon from the sprite in IconSet.astro.
 * Decorative by default; pass `label` when the icon carries meaning on its own.
 */
interface Props {
  name: string;
  class?: string;
  label?: string;
}

const { name, class: className, label } = Astro.props;
---

<svg
  class:list={["size-5 shrink-0 fill-current", className]}
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
  focusable="false"
>
  <use href={`#icon-${name}`}></use>
</svg>
