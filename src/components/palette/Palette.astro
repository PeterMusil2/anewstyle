---
/**
 * RAL frame colours as four small swatches. Hover, keyboard focus or a tap
 * shows the shade's name in a tooltip – pure CSS (.swatch in effects.css).
 */
import { useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "cs" } = Astro.props;
const t = useTranslations(lang);

const swatches = [
  { code: "RAL 150M", color: "hsl(23.64deg 16.42% 60.59%)" },
  { code: "RAL 140M", color: "hsl(38.4deg 24.04% 59.22%)" },
  { code: "RAL 260M", color: "#a38c52" },
  { code: "RAL 280M", color: "hsl(37.37deg 47.11% 47.45%)" },
];
---

<ul class="flex h-12 items-center gap-3" aria-label={t("features.showColors")}>
  {
    swatches.map((swatch) => (
      <li class="swatch relative">
        <button
          type="button"
          class="block size-9 cursor-pointer rounded-full shadow-[inset_0_0_0_1px_rgb(0_0_0/0.15)] ring-offset-2 ring-offset-ink-900 transition-transform duration-200 hover:scale-110 focus-visible:scale-110"
          style={`background-color: ${swatch.color}`}
          aria-label={swatch.code}
          aria-describedby={`swatch-${swatch.code.replace(/\s/g, "")}`}
        />
        <span
          id={`swatch-${swatch.code.replace(/\s/g, "")}`}
          role="tooltip"
          class="swatch__tip pointer-events-none absolute bottom-full left-1/2 z-10 mb-2.5 -translate-x-1/2 bg-fg px-2.5 py-1.5 text-xs font-bold whitespace-nowrap text-ink shadow-lg"
        >
          {swatch.code}
        </span>
      </li>
    ))
  }
</ul>
