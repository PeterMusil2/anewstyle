---
/**
 * Price list. The size picker is a native radio group; every price, VAT
 * price and preview image is rendered for all four sizes and effects.css shows
 * the ones matching the checked radio with :has() – no JavaScript needed.
 */
import prices from "../../data/prices.json";
import type { PricesData, Price } from "./PriceList.types";
import SectionHeader from "../ui/SectionHeader.astro";
import Button from "../ui/Button.astro";
import ScaleFigure from "../ui/ScaleFigure.astro";
import Icon from "../icons/Icon.astro";
import {
  useTranslations,
  type Lang,
  type TranslationKey,
} from "../../i18n/utils";

interface Props {
  id: string;
  lang?: Lang;
}

const { id, lang = "cs" } = Astro.props;
const t = useTranslations(lang);
const basePath = lang === "cs" ? "" : "/en";

type SizeKey = keyof Price;

const sizes: { key: SizeKey; label: string; width: number; aria: TranslationKey }[] = [
  { key: "l", label: "L", width: 400, aria: "price.showL" },
  { key: "xl", label: "XL", width: 600, aria: "price.showXL" },
  { key: "xxl", label: "XXL", width: 800, aria: "price.showXXL" },
  { key: "xxxl", label: "XXXL", width: 1200, aria: "price.showXXXL" },
];

const PANEL_HEIGHT = 2400;
const dims = (width: number) => `${PANEL_HEIGHT} × ${width} mm`;

/** Features in the order of prices.json, with their anchor in the Features section. */
const featureMeta: Record<string, { href: string; hint?: TranslationKey }> = {
  "1": { href: "#thickness-16mm", hint: "price.hint1" },
  "2": { href: "#thickness-34mm", hint: "price.hint2" },
  "3": { href: "#laminated" },
  "4": { href: "#nano-impregnation", hint: "price.hint4" },
  "5": { href: "#touch-control" },
  "6": { href: "#backlight", hint: "price.hint6" },
  "7": { href: "#quick-mounting", hint: "price.hint7" },
  "8": { href: "#easy-repair", hint: "price.hint8" },
  "9": { href: "#thickness-34mm", hint: "price.hint9" },
  "10": { href: "#temperature", hint: "price.hint10" },
  "11": { href: "#rf-control", hint: "price.hint11" },
  "12": { href: "#smartphone-control", hint: "price.hint12" },
  "13": { href: "#color-palette", hint: "price.hint13" },
};

const groups: { title: TranslationKey; features: string[] }[] = [
  { title: "price.groupConstruction", features: ["1", "2", "3", "4", "9"] },
  { title: "price.groupMounting", features: ["7", "8"] },
  { title: "price.groupLight", features: ["5", "6", "10", "11", "12"] },
  { title: "price.groupDesign", features: ["13"] },
];

const featureLabel = (key: string) => t(`price.feature${key}` as TranslationKey);

const number = new Intl.NumberFormat("cs-CZ", { maximumFractionDigits: 0 });
const toNumber = (value: string) => Number(value.replace(/\s/g, ""));
const format = (value: number) => number.format(value);

const products = (prices as PricesData).products;
const tiers = products.map((product, index) => {
  const previous = products[index - 1];
  // Highlights: the first tier lists what it has, every next tier lists only
  // what it adds on top of the previous one.
  const highlights = Object.entries(product.features)
    .filter(([key, has]) => has && !(previous?.features[key] ?? false))
    .map(([key]) => featureLabel(key));

  return {
    ...product,
    featured: index === products.length - 1,
    tagline: product.tagline?.[lang] ?? "",
    previousTitle: previous?.title,
    highlights,
    included: Object.entries(product.features).filter(([, has]) => has).map(([key]) => featureLabel(key)),
    missing: Object.entries(product.features).filter(([, has]) => !has).map(([key]) => featureLabel(key)),
    price: Object.fromEntries(
      sizes.map(({ key }) => {
        const net = toNumber(product.prices[key]);
        return [key, { net: format(net), gross: format(Math.round(net * 1.21)) }];
      }),
    ) as Record<SizeKey, { net: string; gross: string }>,
  };
});

const cheapest = (key: SizeKey) =>
  format(Math.min(...products.map((product) => toNumber(product.prices[key]))));
---

<section id={id} aria-labelledby={`${id}-title`} class="pricing section-y bg-ink-850">
  <div class="container-page flex flex-col gap-20">
    <SectionHeader id={`${id}-title`} layout="center" eyebrow={t("price.eyebrow")} title={t("price.title")}>
      <p class="text-lg text-fg-soft">{t("price.desc1")}</p>
      <p class="text-fg-muted">
        <span>{t("price.desc2")}</span>{" "}<strong class="font-bold text-gold">{t("price.desc3")}</strong>{" "}<span>{t("price.desc4")}</span>
      </p>
    </SectionHeader>

    <!-- Step 1: size -->
    <fieldset class="flex flex-col gap-6" aria-labelledby={`${id}-step1`}>
      <div class="flex flex-col justify-between gap-3 border-b border-line pb-4 md:flex-row md:items-end md:gap-6">
        <h3 class="flex items-center gap-4">
          <span class="grid size-8 place-items-center border border-gold text-sm font-extrabold text-gold">1</span>
          <span id={`${id}-step1`} class="text-[0.9375rem] font-extrabold tracking-[0.16em] uppercase">{t("price.step1")}</span>
        </h3>
        <p class="text-sm text-fg-muted">{t("price.underText")}</p>
      </div>
      <div class="grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-4">
        {
          sizes.map((size, index) => (
            <label class="group relative flex min-h-24 cursor-pointer items-center gap-3 border border-line bg-ink-900 px-3 py-4 transition-colors duration-200 hover:border-line-strong has-checked:border-gold has-checked:bg-gold/12 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-gold sm:gap-5 sm:px-6 lg:min-h-31">
              <input
                type="radio"
                name="size"
                value={size.key}
                checked={index === 0}
                aria-label={t(size.aria)}
                class="sr-only"
              />
              <span class="flex h-14 w-6 shrink-0 items-end justify-center sm:h-19 sm:w-10" aria-hidden="true">
                <span
                  class="block h-full bg-ink-700 shadow-[inset_0_0_0_1px_rgb(255_255_255/0.18)] transition-colors group-has-checked:bg-gold-light"
                  style={`width: ${(size.width / PANEL_HEIGHT) * 100 * 1.9}%`}
                />
              </span>
              <span class="flex flex-col gap-1">
                <span class="text-2xl leading-none font-black tracking-[0.04em] sm:text-3xl">{size.label}</span>
                <span class="text-[0.6875rem] whitespace-nowrap text-fg-soft sm:text-sm">{dims(size.width)}</span>
                <span class="text-[0.6875rem] font-bold whitespace-nowrap text-gold sm:text-sm">
                  {t("price.from")} {cheapest(size.key)} {t("price.currency")}
                </span>
              </span>
              <span class="absolute top-3 right-3 hidden size-5 place-items-center bg-gold text-ink group-has-checked:grid" aria-hidden="true">
                <Icon name="check" class="size-3" />
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <!-- Step 2: version -->
    <div class="flex flex-col gap-6">
      <div class="flex flex-col justify-between gap-3 border-b border-line pb-4 md:flex-row md:items-end md:gap-6">
        <h3 class="flex items-center gap-4">
          <span class="grid size-8 place-items-center border border-gold text-sm font-extrabold text-gold">2</span>
          <span class="text-[0.9375rem] font-extrabold tracking-[0.16em] uppercase">
            {t("price.step2")}{" "}
            <span class="text-fg-muted">·</span>{" "}
            {sizes.map((size) => <span data-size={size.key}>{t("price.sizeLabel")} {size.label}</span>)}
          </span>
        </h3>
        <p class="text-sm text-fg-muted">{t("price.vat")}</p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-[15.5rem_repeat(3,minmax(0,1fr))]">
        <div class="hidden flex-col items-center justify-between gap-6 border border-line bg-ink-900 px-5 py-7 lg:flex">
          <p class="text-xs font-bold tracking-[0.2em] text-fg-muted uppercase">{t("price.previewAlt")}</p>
          <div class="relative aspect-[280/560] w-full max-w-52">
            {
              sizes.map((size) => (
                <img
                  src={`/images/priceList/${size.key}.avif`}
                  width="280"
                  height="560"
                  loading="lazy"
                  decoding="async"
                  alt={`${t("price.previewAlt")} ${size.label}`}
                  data-size={size.key}
                  data-size-preview
                  class="absolute inset-0 size-full -scale-x-100 object-contain object-bottom"
                />
              ))
            }
            <ScaleFigure class="absolute bottom-0 left-0 z-10 aspect-[1.4/5.6] w-[23.5%]" />
          </div>
          <p class="flex flex-col items-center gap-1 text-center">
            {
              sizes.map((size) => (
                <span data-size={size.key} class="contents">
                  <span class="block text-2xl font-black tracking-[0.04em]">{size.label}</span>
                  <span class="block text-sm text-fg-soft">{dims(size.width)}</span>
                </span>
              ))
            }
          </p>
        </div>

        {
          tiers.map((tier) => (
            <article
              class:list={[
                "reveal relative flex flex-col gap-6 border px-6 py-8 sm:px-7",
                tier.featured ? "border-gold bg-ink-750" : "border-line bg-ink-800",
              ]}
            >
              {tier.featured && (
                <span class="absolute -top-px right-6 bg-gold px-3 py-1.5 text-[0.6875rem] font-extrabold tracking-[0.16em] text-ink uppercase">
                  {t("price.featured")}
                </span>
              )}
              <div class="flex flex-col gap-2.5">
                <h4 class="text-base font-black tracking-[0.22em] text-gold">{tier.title}</h4>
                <p class="text-[0.9375rem] leading-relaxed text-fg-soft lg:min-h-12">{tier.tagline}</p>
              </div>

              <div class="flex flex-col gap-1.5 border-y border-line py-5">
                {sizes.map((size) => (
                  <div data-size={size.key} class="flex flex-col gap-1.5">
                    <p class="flex flex-wrap items-baseline gap-x-2">
                      <span class="text-[2.75rem] leading-none font-extrabold tracking-tight tabular-nums">
                        {tier.price[size.key].net}
                      </span>
                      <span class="text-lg font-bold">{t("price.currency")}</span>
                      <span class="text-sm text-fg-muted">{t("price.withoutVat")}</span>
                    </p>
                    <p class="text-sm text-fg-muted tabular-nums">
                      {tier.price[size.key].gross} {t("price.currency")} {t("price.withVat")}
                    </p>
                  </div>
                ))}
              </div>

              <ul class="hidden grow flex-col gap-3 md:flex">
                {tier.previousTitle && (
                  <li class="flex items-start gap-2.5 text-[0.9375rem] leading-snug font-semibold">
                    <Icon name="check" class="mt-0.5 size-4 text-gold" />
                    {t("price.everythingFrom")} {tier.previousTitle}
                  </li>
                )}
                {tier.highlights.map((item) => (
                  <li class="flex items-start gap-2.5 text-[0.9375rem] leading-snug">
                    <Icon name="check" class="mt-0.5 size-4 text-gold" />
                    {item}
                  </li>
                ))}
              </ul>

              <div class="flex grow flex-col gap-4 md:hidden">
                <ul class="flex flex-col gap-2.5">
                  {tier.included.map((item) => (
                    <li class="flex items-start gap-2.5 text-[0.9375rem] leading-snug">
                      <Icon name="check" class="mt-0.5 size-4 text-gold" />
                      {item}
                    </li>
                  ))}
                </ul>
                {tier.missing.length > 0 && (
                  <p class="text-sm leading-relaxed text-fg-subtle">
                    <span class="font-bold text-fg-muted">{t("price.notIncluded")}: </span>
                    {tier.missing.join(", ")}
                  </p>
                )}
              </div>

              <div class="flex flex-col gap-2">
                <Button href={`${basePath}/#contact`} variant={tier.featured ? "primary" : "outline"} class="px-4!">
                  {t("price.inquire")}
                </Button>
                <Button
                  href="https://www.anewstyle-eshop.cz/"
                  variant="link"
                  rel="external"
                  target="_blank"
                  class="font-semibold! tracking-normal! text-fg-soft! normal-case! hover:text-fg!"
                >
                  {t("price.eshop")} →
                </Button>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Feature comparison (tablet and up; phones get the full list in each card) -->
    <div class="hidden flex-col gap-6 md:flex">
      <div class="flex items-end justify-between gap-6">
        <h3 class="text-2xl font-black tracking-[0.1em] uppercase lg:text-[1.75rem]">{t("price.compareTitle")}</h3>
        <p class="text-sm text-fg-muted">{t("price.compareHint")}</p>
      </div>
      <table class="w-full border-collapse text-left">
        <thead>
          <tr class="border-t border-gold bg-ink-900">
            <th scope="col" class="px-6 py-5 text-xs font-bold tracking-[0.2em] text-fg-muted uppercase">
              {sizes.map((size) => <span data-size={size.key}>{t("price.sizeLabel")} {size.label} · {dims(size.width)}</span>)}
            </th>
            {
              tiers.map((tier) => (
                <th scope="col" class="w-[18%] px-4 py-5 text-center">
                  <span class="block text-[0.9375rem] font-black tracking-[0.2em] text-gold">{tier.title}</span>
                  {sizes.map((size) => (
                    <span data-size={size.key} class="block text-sm font-normal text-fg tabular-nums">
                      {tier.price[size.key].net} {t("price.currency")}
                    </span>
                  ))}
                </th>
              ))
            }
          </tr>
        </thead>
        {
          groups.map((group) => (
            <tbody>
              <tr>
                <th colspan="4" scope="colgroup" class="px-6 pt-6 pb-2.5 text-xs font-extrabold tracking-[0.2em] text-gold uppercase">
                  {t(group.title)}
                </th>
              </tr>
              {group.features.map((key) => {
                const meta = featureMeta[key];
                return (
                  <tr class="border-b border-line transition-colors hover:bg-white/2">
                    <th scope="row" class="px-6 py-3 font-normal">
                      <a href={meta.href} class="text-[0.9375rem] font-semibold text-fg no-underline hover:text-gold-light">
                        {featureLabel(key)}
                      </a>
                      {meta.hint && <span class="block text-[0.8125rem] text-fg-subtle">{t(meta.hint)}</span>}
                    </th>
                    {tiers.map((tier) => (
                      <td class="px-4 py-3 text-center">
                        {tier.features[key] ? (
                          <Icon name="check" class="mx-auto size-5 text-gold" label={t("price.included")} />
                        ) : (
                          <span class="mx-auto block h-0.5 w-3.5 bg-fg-disabled" role="img" aria-label={t("price.notIncluded")} />
                        )}
                      </td>
                    ))}
                  </tr>
                );
              })}
            </tbody>
          ))
        }
      </table>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      <div class="flex flex-col gap-3 border border-line bg-ink-900 p-7 md:p-8">
        <h3 class="text-sm font-extrabold tracking-[0.18em] text-gold uppercase">{t("price.customTitle")}</h3>
        <p class="text-base leading-relaxed text-fg-soft">{t("price.customDesc")}</p>
        <Button href={`${basePath}/#contact`} variant="link" class="self-start">{t("price.customCta")} →</Button>
      </div>
      <div class="flex flex-col gap-3 border border-line bg-ink-900 p-7 md:p-8">
        <h3 class="text-sm font-extrabold tracking-[0.18em] text-gold uppercase">{t("contact.showroomTitle")}</h3>
        <p class="text-base leading-relaxed text-fg-soft">{t("price.showroomDesc")}</p>
        <Button href="tel:+420601221551" variant="link" class="self-start tracking-[0.06em]!">+420 601 221 551 →</Button>
      </div>
    </div>
  </div>
</section>
