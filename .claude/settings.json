{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-on-content-change.sh",
            "timeout": 120,
            "statusMessage": "Running tests (content changed)…"
          }
        ]
      }
    ]
  }
}
