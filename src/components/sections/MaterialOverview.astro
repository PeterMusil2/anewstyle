---
import Picture from "../ui/Picture.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import materialOverview from "../../data/material-overview.json";
import { inlineMarkdown } from "../../lib/inline-markdown";
import { useTranslations, type Lang, type TranslationKey } from "../../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "cs" } = Astro.props;
const t = useTranslations(lang);
const localized = (value: Record<Lang, string>, fallbackKey: TranslationKey) => value[lang]?.trim() || t(fallbackKey);
const sharedConstruction = materialOverview.sharedConstruction;
const description = sharedConstruction.description[lang]?.trim() || sharedConstruction.description[lang === "cs" ? "en" : "cs"];
const constructionMarkers = [
  { number: "1A", x: 43, y: 18 },
  { number: "1B", x: 55, y: 18 },
  { number: "2", x: 69.5, y: 51 },
  { number: "3", x: 69.5, y: 62 },
  { number: "4", x: 69.5, y: 70 },
  { number: "5", x: 49, y: 93 },
  { number: "6", x: 57, y: 86 },
] as const;
const constructionLayers: { number: string; label: string | TranslationKey; translated?: boolean }[] = [
  { number: "1A", label: localized(sharedConstruction.stoneLayer, "tech.panel1Label") },
  { number: "1B", label: localized(sharedConstruction.mineralLayer, "tech.mineralPanelLayer") },
  { number: "2", label: "tech.panel2", translated: true },
  { number: "3", label: "tech.panel3", translated: true },
  { number: "4", label: "tech.panel4", translated: true },
  { number: "5", label: "tech.panel5", translated: true },
  { number: "6", label: "tech.panel6Label", translated: true },
];
---

<section id="technologies" aria-labelledby="technologies-title" class="home-section-y home-section-divider bg-ink-800">
  <div class="container-page flex flex-col gap-10 lg:gap-14">
    <SectionHeader id="technologies-title" layout="left" eyebrow={t("home.chapterTechnology")} title={localized(sharedConstruction.imageHeading, "home.sharedConstructionTitle")} />

    <figure class="mx-auto flex w-full max-w-5xl flex-col gap-5 border border-line bg-ink-900 p-4 sm:gap-6 sm:p-6 lg:grid lg:max-w-none lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:items-center lg:gap-10 lg:p-8">
      <div class="relative w-full lg:col-start-2 lg:row-start-1">
        <Picture src="/images/technologies/konstrukce_sviticiho_panelu-1a-1b.png" alt={localized(sharedConstruction.imageAlt, "home.stoneConstructionAlt")} sizes="(min-width: 80rem) 41rem, (min-width: 64rem) 55vw, 100vw" class="mx-auto h-auto max-h-[38rem] w-full object-contain" />
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          {constructionMarkers.map((marker) => (
            <span class="absolute z-10 grid size-[clamp(1.25rem,3vw,2rem)] -translate-x-1/2 -translate-y-1/2 place-items-center rounded-sm border border-gold bg-ink-950/90 text-[clamp(0.5625rem,1.1vw,0.75rem)] font-black text-gold shadow-lg" style={`left: ${marker.x}%; top: ${marker.y}%;`}>
              {marker.number}
            </span>
          ))}
        </div>
      </div>
      <figcaption class="flex min-w-0 flex-col gap-5 lg:col-start-1 lg:row-start-1">
        <p class="section-copy max-w-2xl text-fg-soft [&_strong]:font-extrabold [&_strong]:text-fg" set:html={inlineMarkdown(description)} />
        <ol class="grid gap-2 border-t border-line pt-4 sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-1 lg:gap-0 lg:divide-y lg:divide-line lg:pt-2">
        {constructionLayers.map((layer) => (
          <li class="grid grid-cols-[2.25rem_minmax(0,1fr)] items-start gap-3 text-sm leading-relaxed text-fg-muted lg:grid-cols-[1.75rem_minmax(0,1fr)] lg:items-center lg:py-1.5">
            <span class="inline-grid size-7 place-items-center border border-gold text-[0.6875rem] font-extrabold text-gold">
              {layer.number}
            </span>
            <span>{layer.translated ? t(layer.label as TranslationKey) : layer.label}</span>
          </li>
        ))}
        </ol>
      </figcaption>
    </figure>
  </div>
</section>
