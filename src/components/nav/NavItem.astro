---
interface Props {
  href: string;
  text: string;
  accent?: boolean;
  variant?: "bar" | "panel";
}

const { href, text, accent = false, variant = "bar" } = Astro.props;
---

<li>
  <a
    href={href}
    data-nav-link
    class:list={[
      "flex items-center whitespace-nowrap text-[0.8125rem] font-bold tracking-[0.12em] uppercase no-underline transition-colors duration-200 hover:text-gold-light",
      variant === "bar" && "min-h-11",
      variant === "panel" &&
        "min-h-14 border-b border-line text-base tracking-caps",
      accent ? "text-gold" : "text-fg-soft",
    ]}
  >
    {text}
  </a>
</li>
