---
import Button from "./Button.astro";
import {
  getPanelPagePath,
  useTranslations,
  type Lang,
  type PanelCategory,
} from "../../i18n/utils";

interface Props {
  lang?: Lang;
  activeCategory?: PanelCategory;
}

const { lang = "cs", activeCategory } = Astro.props;
const t = useTranslations(lang);
const homePath = lang === "cs" ? "/" : "/en/";
const options = [
  { href: getPanelPagePath("stone", lang), label: t("price.categoryStone"), active: activeCategory === "stone" },
  { href: getPanelPagePath("mineral", lang), label: t("price.categoryMineral"), active: activeCategory === "mineral" },
  { href: `${homePath}#about`, label: t("nav.allPanels"), active: !activeCategory },
];
---

<nav aria-label={t("nav.panelPages")} class="panel-page-switch grid w-full max-w-4xl grid-cols-1 gap-2 sm:grid-cols-3">
  {options.map(({ href, label, active }) => (
    <Button
      href={href}
      variant={active ? "primary" : "outline"}
      aria-current={active ? "page" : undefined}
      class="min-h-12 w-full whitespace-normal px-2 py-2 text-[0.625rem] leading-tight sm:px-3 sm:text-xs"
    >
      {label}
    </Button>
  ))}
</nav>
