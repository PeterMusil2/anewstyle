---
import Picture from "../ui/Picture.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import Icon from "../icons/Icon.astro";
import { useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang?: Lang;
  panelCategory?: "stone" | "mineral";
}

const { lang = "cs", panelCategory } = Astro.props;
const t = useTranslations(lang);
---

<section aria-labelledby="day-night-title" class="bg-ink-850 pb-20 lg:pb-30">
  <div class="container-wide flex flex-col gap-12">
    <SectionHeader
      id="day-night-title"
      layout="center"
      eyebrow={`${t("slider.titleDay")} · ${t("slider.titleNight")}`}
      title={t("slider.desc")}
    />

    <div
      id="baSlider"
      class="ba-slider reveal relative aspect-[1440/809] max-h-[80svh] w-full overflow-hidden border border-line select-none"
    >
      {(!panelCategory || panelCategory === "stone") && <div data-panel-type="stone" class="absolute inset-0">
        <div class="absolute inset-0">
          <Picture
            src="/images/before-after/stone-library-angled-night-on.webp"
            sizes="(min-width: 90rem) 90rem, 100vw"
            class="size-full object-cover object-left"
            alt={t("slider.titleNight")}
          />
          <span class="absolute top-5 right-5 bg-gold px-3.5 py-2 text-xs font-extrabold tracking-[0.18em] text-ink uppercase sm:top-8 sm:right-8">
            {t("slider.titleNight")}
          </span>
        </div>
        <div class="ba-slider__before absolute inset-0">
          <Picture
            src="/images/before-after/stone-library-angled-day-off.webp"
            sizes="(min-width: 90rem) 90rem, 100vw"
            class="size-full object-cover object-left"
            alt={t("slider.titleDay")}
          />
          <span class="absolute top-5 left-5 bg-ink/80 px-3.5 py-2 text-xs font-extrabold tracking-[0.18em] text-fg uppercase sm:top-8 sm:left-8">
            {t("slider.titleDay")}
          </span>
        </div>
      </div>}
      {(!panelCategory || panelCategory === "mineral") && <div data-panel-type="mineral" class="absolute inset-0">
        <div class="absolute inset-0">
          <Picture
            src="/images/before-after/mineral-glass-angled-night-on.webp"
            sizes="(min-width: 90rem) 90rem, 100vw"
            class="size-full object-cover object-center"
            alt={`${t("showcase.mineralTextureAlt")} – ${t("slider.titleNight")}`}
          />
          <span class="absolute top-5 right-5 bg-gold px-3.5 py-2 text-xs font-extrabold tracking-[0.18em] text-ink uppercase sm:top-8 sm:right-8">
            {t("slider.titleNight")}
          </span>
        </div>
        <div class="ba-slider__before absolute inset-0">
          <Picture
            src="/images/before-after/mineral-glass-angled-day-off.webp"
            sizes="(min-width: 90rem) 90rem, 100vw"
            class="size-full object-cover object-center"
            alt={`${t("showcase.mineralTextureAlt")} – ${t("slider.titleDay")}`}
          />
          <span class="absolute top-5 left-5 bg-ink/80 px-3.5 py-2 text-xs font-extrabold tracking-[0.18em] text-fg uppercase sm:top-8 sm:left-8">
            {t("slider.titleDay")}
          </span>
        </div>
      </div>}
      <input
        type="range"
        min="0"
        max="100"
        value="70"
        step="0.1"
        aria-label={t("slider.percentage")}
        class="absolute inset-0 z-20 size-full cursor-ew-resize opacity-0"
      />
      <div class="ba-slider__handle pointer-events-none absolute inset-y-0 z-10 w-0.5 -translate-x-1/2 bg-white" aria-hidden="true">
        <span class="ba-slider__knob absolute top-1/2 left-1/2 grid size-12 -translate-1/2 place-items-center rounded-full bg-white text-black shadow-lg sm:size-14">
          <Icon name="move" class="size-6" />
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".ba-slider").forEach((slider) => {
    const input = slider.querySelector<HTMLInputElement>("input[type=range]");
    if (!input) return;
    const update = () => slider.style.setProperty("--ba-position", `${input.value}%`);
    input.addEventListener("input", update);
    update();
  });
</script>
