---
import Icon from "../icons/Icon.astro";
import Button from "../ui/Button.astro";
import mineralHero from "../../data/mineral-hero.json";
import stoneHero from "../../data/stone-hero.json";
import {
  heroArTextures,
  mineralArModelPath,
  PANEL_AR_PLACEMENT,
  panelArModes,
  STONE_AR_MODEL_PATH,
} from "../../lib/panel-ar";
import {
  useTranslations,
  type Lang,
  type PanelCategory,
} from "../../i18n/utils";

interface Props {
  lang?: Lang;
  pageTitle?: string;
  pageDescription?: string;
  home?: boolean;
  panelCategory?: PanelCategory;
}

const { lang = 'cs', pageTitle, pageDescription, home = false, panelCategory } = Astro.props;
const t = useTranslations(lang);
const homeHref = lang === "cs" ? "/" : "/en/";
const headerMineralTexture = "/images/patterns/mineral-2.png";
const headerModelPath = panelCategory === "mineral"
  ? mineralArModelPath(headerMineralTexture)
  : STONE_AR_MODEL_PATH;
const headerArTextures = heroArTextures(panelCategory);
const panelHero = home || !panelCategory ? undefined : panelCategory === "mineral" ? mineralHero : stoneHero;
---

<header class="scheme-dark-protected relative isolate flex min-h-svh text-fg items-end overflow-hidden bg-ink">
  <div class="hero-media absolute inset-0 -z-20 isolate" aria-hidden="true">
    <!-- Poster: the LCP image. The video fades in over it once it plays. -->
    {panelHero ? (
      <img
        src={panelHero.poster}
        alt=""
        width="1280"
        height="720"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 -z-10 size-full object-cover"
      />
    ) : (
      <picture>
        <source type="image/avif" srcset="/images/hero/hero-poster-1280.avif" />
        <img
          src="/images/hero/hero-poster-1280.webp"
          alt=""
          width="1280"
          height="720"
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 -z-10 size-full object-cover"
        />
      </picture>
    )}
    <video
      class="hero-video pointer-events-none absolute inset-0 size-full object-cover"
      id="headerVideo"
      data-panel-category={panelCategory ?? "stone"}
      data-home={home ? "true" : "false"}
      data-panel-video-mobile={panelHero?.videoMobile}
      data-panel-video-desktop={panelHero?.videoDesktop}
      aria-hidden="true"
      tabindex="-1"
      preload="auto"
      autoplay
      loop
      muted
      playsinline
      disablepictureinpicture></video>
  </div>
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(60%_70%_at_75%_40%,rgb(163_140_82/0.18),transparent_70%),linear-gradient(to_top,var(--color-ink)_0%,rgb(0_0_0/0.40)_45%,rgb(0_0_0/0.15)_100%)]"
    aria-hidden="true"
  >
  </div>

  <button
    type="button"
    id="headerVideoToggle"
    hidden
    aria-controls="headerVideo"
    aria-label={t('header.videoPause')}
    data-label-pause={t('header.videoPause')}
    data-label-play={t('header.videoPlay')}
    class="hero-video-toggle absolute z-10 grid size-11 cursor-pointer place-items-center rounded-full border border-fg/35 bg-ink/45 text-fg backdrop-blur-md transition-colors hover:bg-fg/12 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg [&[hidden]]:hidden!"
  >
    <svg class="video-toggle__pause size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
    <svg class="video-toggle__play hidden size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
  </button>
  {!home && panelCategory && (
    <a
      href={homeHref}
      aria-label={t("nav.home")}
      title={t("nav.home")}
      class="hero-home-link absolute z-10 grid size-11 place-items-center rounded-full border border-gold bg-ink/70 text-gold backdrop-blur-md transition-colors hover:bg-gold hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
    >
      <Icon name="home" class="size-5" />
    </a>
  )}

  <div class:list={[
    "container-page flex flex-col gap-4 pt-[calc(var(--nav-height)+3rem)] pb-20 sm:gap-6 lg:pb-28",
    home ? "items-center text-center lg:items-start lg:text-left" : "items-start text-left",
  ]}>
    <h1 class:list={[
      "hero-title max-w-4xl font-display leading-[0.92] font-black tracking-[0.08em] uppercase",
      pageTitle ? "max-w-full wrap-anywhere text-[clamp(1.75rem,8vw,3rem)] sm:max-w-4xl sm:text-6xl lg:text-7xl" : "text-[clamp(2.25rem,11.5vw,4.5rem)] sm:text-7xl lg:text-[7.5rem]",
    ]}>
      <span class:list={["hero-title__label", { "hero-title__label--home": home }]}>{pageTitle ?? "ANEW STYLE"}</span>
    </h1>
    <p class="hero-subtitle max-w-xl text-xl font-light tracking-wide text-fg-soft lg:text-2xl">
      {pageDescription ?? t('header.title')}
    </p>
    {(home || panelCategory) && (
      <Button href={home ? "#about" : "#panel-material"} size="sm" class="w-full max-w-64 sm:min-h-13 sm:text-sm">
        {t(home ? "home.chapterLight" : "header.btnMore")}
      </Button>
    )}
    <Button
      href="https://www.anewstyle-eshop.cz"
      variant="ghost"
      rel="external"
      target="_blank"
      title={t('header.gotoEshop')}
      class="w-64 justify-center max-md:hidden!"
    >
      {t('header.btnEshop')}
      <Icon name="eshop" class="size-4" />
    </Button>
    {(home || panelCategory) && (
      <div class:list={["absolute bottom-4 z-10 flex lg:hidden!", home ? "left-1/2 -translate-x-1/2" : "left-5 md:left-10"]}>
        <Button
          variant="outline"
          size="sm"
          id="headerArButton"
          data-model-path={headerModelPath}
          data-ar-texture-off={headerArTextures.off}
          data-ar-texture-on={headerArTextures.on}
          data-ar-modes={panelArModes()}
          data-ar-placement={PANEL_AR_PLACEMENT}
          data-loading="true"
          data-error="false"
          aria-busy="true"
          aria-describedby="headerArStatus"
          disabled
          class="w-64 [--spinner-color:var(--color-gold)] lg:hidden! disabled:cursor-not-allowed data-[error=true]:border-danger data-[error=true]:bg-danger data-[loading=true]:cursor-wait data-[loading=true]:opacity-70"
        >
          {t('header.btnAr')}
          <Icon name="ar" class="size-5" />
        </Button>
        <p
          id="headerArStatus"
          role="status"
          aria-live="polite"
          hidden
          data-unavailable={t("header.arUnavailable")}
          data-failed={t("header.arFailed")}
          class="absolute top-full mt-2 w-64 text-center text-xs leading-relaxed font-semibold text-danger"
        ></p>
      </div>
    )}
  </div>

  <div
    class="absolute bottom-8 left-1/2 hidden h-10 w-px -translate-x-1/2 bg-linear-to-b from-transparent to-gold md:block"
    aria-hidden="true"
  >
  </div>
</header>

<dialog
  id="arHandoffOverlay"
  aria-labelledby="arHandoffTitle"
  class="scheme-dark-protected fixed inset-0 h-full max-h-none w-full max-w-none overflow-y-auto bg-ink px-6 pt-[max(1.5rem,env(safe-area-inset-top))] pb-[max(1.5rem,env(safe-area-inset-bottom))] text-fg open:grid open:place-items-center"
>
  <div class="flex w-full max-w-sm flex-col items-center gap-5 text-center">
    <div class="grid w-full grid-cols-[1fr_auto_1fr] items-center">
      <Icon name="ar" class="col-start-2 size-12 text-gold" />
      <button id="arHandoffClose" type="button" aria-label={t("products.arClose")} class="col-start-3 grid size-12 cursor-pointer place-items-center justify-self-end border border-line text-fg hover:text-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold">
        <Icon name="close" class="size-5" />
      </button>
    </div>
    <div class="space-y-3">
      <h2 id="arHandoffTitle" class="font-display text-3xl font-black tracking-wide uppercase">
        {t("header.arHandoffTitle")}
      </h2>
      <p
        id="arHandoffStatus"
        role="status"
        aria-live="polite"
        data-android={t("header.arAndroidHint")}
        data-samsung={t("header.arHandoffSamsungHint")}
        data-safari={t("header.arHandoffSafariHint")}
        class="text-base leading-relaxed text-fg-soft"
      >
        {t("header.arHandoffHint")}
      </p>
    </div>
    <fieldset class="w-full space-y-3">
      <legend class="text-sm font-extrabold tracking-caps text-gold uppercase">
        {t("header.arOrientation")}
      </legend>
      <div class="grid grid-cols-2 gap-3">
        <label class="flex min-h-16 cursor-pointer items-center justify-center gap-3 border border-line bg-ink-900 px-3 py-3 text-sm font-bold text-fg-soft transition-colors has-checked:border-gold has-checked:bg-gold/12 has-checked:text-gold-light has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-gold">
          <input type="radio" name="arOrientation" value="0" checked class="size-5 shrink-0 accent-gold" />
          <span class="flex items-center gap-2">
            <span aria-hidden="true" class="block h-8 w-5 border-2 border-current"></span>
            {t("header.arPortrait")}
          </span>
        </label>
        <label class="flex min-h-16 cursor-pointer items-center justify-center gap-3 border border-line bg-ink-900 px-3 py-3 text-sm font-bold text-fg-soft transition-colors has-checked:border-gold has-checked:bg-gold/12 has-checked:text-gold-light has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-gold">
          <input type="radio" name="arOrientation" value="90" class="size-5 shrink-0 accent-gold" />
          <span class="flex items-center gap-2">
            <span aria-hidden="true" class="block h-5 w-8 border-2 border-current"></span>
            {t("header.arLandscape")}
          </span>
        </label>
      </div>
    </fieldset>
    <fieldset id="arLightingOptions" hidden class="w-full space-y-3 [&[hidden]]:hidden!">
      <legend class="text-sm font-extrabold tracking-caps text-gold uppercase">
        {t("showcase.stateLabel")}
      </legend>
      <div class="grid grid-cols-2 gap-3">
        {(["off", "on"] as const).map((state) => (
          <label class="flex min-h-12 cursor-pointer items-center justify-center gap-2 border border-line bg-ink-900 px-2 py-2 text-sm font-bold text-fg-soft transition-colors has-checked:border-gold has-checked:bg-gold/12 has-checked:text-gold-light has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-gold">
            <input type="radio" name="arLighting" value={state} checked={state === "off"} class="size-5 shrink-0 accent-gold" />
            {t(state === "off" ? "showcase.btn1" : "showcase.btn3")}
          </label>
        ))}
      </div>
    </fieldset>
    <Button
      id="arHandoffButton"
      disabled
      aria-busy="true"
      class="w-full min-h-15 [--spinner-color:var(--color-ink)]"
    >
      {t("header.arContinue")}
      <Icon name="ar" class="size-5" />
    </Button>
  </div>
</dialog>

<style>
  @media (max-width: 560px) {
    .hero-media {
      inset-block-end: auto;
      block-size: 82svh;
      mask-image: linear-gradient(to bottom, black 78%, transparent 100%);
    }
  }
</style>

<script>
  import type { ModelViewerElement } from "@google/model-viewer";
  import {
    isAndroidArDevice,
    isAppleQuickLookDevice,
    panelArModes,
    panelArModelPath,
    panelArPlacementForDevice,
    panelArQuickLookModelPath,
    panelArViewerStyle,
    safariArUrl,
    samsungInternetArIntent,
    shouldOpenArInSafari,
    shouldOpenArInSamsungInternet,
    STONE_AR_MODEL_PATH,
    waitForArAvailability,
  } from "../../lib/panel-ar";

  type ARViewer = ModelViewerElement;

  const waitForModel = (viewer: ARViewer): Promise<void> => {
    if (viewer.loaded) return Promise.resolve();
    return new Promise((resolve, reject) => {
      const timeout = window.setTimeout(() => finish(new Error("Model load timeout")), 20000);
      const finish = (error?: Error) => {
        window.clearTimeout(timeout);
        viewer.removeEventListener("load", onLoad);
        viewer.removeEventListener("error", onError);
        error ? reject(error) : resolve();
      };
      const onLoad = () => finish();
      const onError = () => finish(new Error("Model could not be loaded"));
      viewer.addEventListener("load", onLoad, { once: true });
      viewer.addEventListener("error", onError, { once: true });
    });
  };

  const MOBILE_BREAKPOINT = 560;
  // Use a landscape and portrait loop; the hero is always muted.

  function initHeaderVideo(): void {
    const video = document.querySelector<HTMLVideoElement>("#headerVideo");
    const toggle = document.querySelector<HTMLButtonElement>("#headerVideoToggle");
    if (!video || !toggle) return;

    // Autoplay is the default on phones too, regardless of connection estimates.
    // Keep the explicit accessibility preference for a still background.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    // Set the live properties before attaching a source, including on iOS.
    video.muted = true;
    video.defaultMuted = true;
    video.playsInline = true;
    video.autoplay = true;
    video.controls = false;

    const isHome = video.dataset.home === "true";
    const videoMobile = isHome ? "/videos/hero-mobile-wide-v2.mp4" : video.dataset.panelVideoMobile;
    const videoDesktop = isHome ? "/videos/hero-1280.mp4" : video.dataset.panelVideoDesktop;

    let userPaused = false;
    let inView = true;
    let playPending = false;
    const sync = () => {
      const paused = video.paused;
      toggle.setAttribute("aria-label", (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? "");
      toggle.querySelector(".video-toggle__pause")?.classList.toggle("hidden", paused);
      toggle.querySelector(".video-toggle__play")?.classList.toggle("hidden", !paused);
    };
    const play = async () => {
      if (playPending || userPaused || !inView || document.hidden) return;
      playPending = true;
      try {
        await video.play();
      } catch {
        // OS autoplay restrictions keep the poster and offer the same small control.
        if (!userPaused && inView && !document.hidden && !video.error) {
          toggle.hidden = false;
          sync();
        }
      } finally {
        playPending = false;
      }
    };

    video.addEventListener("playing", () => {
      // Never expose a native central play overlay before playback succeeds.
      video.classList.add("is-playing");
      toggle.hidden = false;
      sync();
    });
    video.addEventListener("pause", sync);
    video.addEventListener("error", () => {
      video.classList.remove("is-playing");
      toggle.hidden = true;
    });
    toggle.addEventListener("click", () => {
      if (video.paused) {
        userPaused = false;
        void play();
      } else {
        userPaused = true;
        video.pause();
      }
    });

    // Save decoding work off screen, without undoing an explicit user pause.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        if (inView) void play();
        else video.pause();
      }, { threshold: 0.05 }).observe(video);
    }
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) video.pause();
      else void play();
    });
    // Mobile browsers can restore a frozen page from the back/forward cache.
    window.addEventListener("pageshow", () => { void play(); });

    // Do not wait for unrelated images, analytics or the window load event.
    const isMobile = window.matchMedia(`(max-width: ${MOBILE_BREAKPOINT}px)`).matches;
    const source = isMobile ? videoMobile : videoDesktop;
    if (!source) return;
    video.src = source;
    video.preload = "auto";
    video.addEventListener("canplay", () => { void play(); }, { once: true });
    video.load();
    void play();
  }

  function initHeader(): void {
    initHeaderVideo();

    const arButton = document.querySelector<HTMLButtonElement>("#headerArButton");
    const arStatus = document.querySelector<HTMLElement>("#headerArStatus");
    const handoffOverlay = document.querySelector<HTMLDialogElement>("#arHandoffOverlay");
    const handoffButton = document.querySelector<HTMLButtonElement>("#arHandoffButton");
    const handoffStatus = document.querySelector<HTMLElement>("#arHandoffStatus");
    const lightingOptions = document.querySelector<HTMLFieldSetElement>("#arLightingOptions");
    const lightingInputs = Array.from(
      document.querySelectorAll<HTMLInputElement>('input[name="arLighting"]'),
    );
    const orientationInputs = Array.from(
      document.querySelectorAll<HTMLInputElement>('input[name="arOrientation"]'),
    );
    if (!arButton) return;

    const query = new URLSearchParams(window.location.search);
    const patternHandoff = query.has("ar-pattern");
    const handoffRequested = !patternHandoff && query.get("ar-handoff") === "1";
    const requestedBrowser = query.get("ar-browser");
    const android = isAndroidArDevice(window.navigator.userAgent);
    const directAndroid = !patternHandoff && android && query.get("ar-direct") === "1";
    if (lightingOptions) lightingOptions.hidden = !android;
    const openInSamsungInternet = shouldOpenArInSamsungInternet(
      window.navigator.userAgent,
      window.location.search,
    );
    const openInSafari = shouldOpenArInSafari(
      window.navigator.userAgent,
      window.location.search,
    );
    const needsBrowserHandoff = openInSamsungInternet || openInSafari;
    const appleQuickLook = isAppleQuickLookDevice(
      window.navigator.userAgent,
      window.navigator.maxTouchPoints,
    );

    if (handoffStatus) {
      const hint = requestedBrowser === "safari"
        ? handoffStatus.dataset.safari
        : requestedBrowser === "samsung"
          ? handoffStatus.dataset.samsung
          : android ? handoffStatus.dataset.android : undefined;
      if (hint) handoffStatus.textContent = hint;
    }
    const initialHint = handoffStatus?.textContent ?? "";

    let arViewer: ARViewer | null = null;
    let arInitialized = false;
    let useOrientationStep = handoffRequested || directAndroid;
    const selectedLandscape = () => orientationInputs.find((input) => input.checked)?.value === "90";
    const selectedLit = () => lightingInputs.find((input) => input.checked)?.value === "on";
    let loadSelectedModel: (() => Promise<void>) | null = null;
    const setHandoffVisible = (visible: boolean) => {
      if (!useOrientationStep || !handoffOverlay) return;
      if (visible && !handoffOverlay.open) handoffOverlay.showModal();
      if (!visible && handoffOverlay.open) handoffOverlay.close();
      document.documentElement.style.overflow = visible ? "hidden" : "";
    };
    const dismissHandoff = () => {
      setHandoffVisible(false);
      useOrientationStep = false;
      arButton.focus();
    };
    document.querySelector("#arHandoffClose")?.addEventListener("click", dismissHandoff);
    handoffOverlay?.addEventListener("cancel", (event) => {
      event.preventDefault();
      dismissHandoff();
    });
    setHandoffVisible(true);
    const setStatus = (message = "") => {
      if (!arStatus) return;
      arStatus.textContent = message;
      arStatus.hidden = !message;
    };
    const setLoading = (loading: boolean) => {
      arButton.disabled = loading;
      arButton.setAttribute("data-loading", loading ? "true" : "false");
      arButton.setAttribute("aria-busy", loading ? "true" : "false");
      if (handoffButton) {
        handoffButton.disabled = loading;
        handoffButton.setAttribute("aria-busy", loading ? "true" : "false");
      }
      orientationInputs.forEach((input) => { input.disabled = loading; });
      if (lightingOptions) lightingOptions.disabled = loading;
    };
    const showArError = (kind: "unavailable" | "failed", canRetry = false) => {
      if (arViewer) arViewer.style.cssText = panelArViewerStyle(false);
      setLoading(false);
      arButton.disabled = !arViewer?.canActivateAR;
      if (handoffButton) handoffButton.disabled = !canRetry || !arViewer?.canActivateAR;
      arButton.setAttribute("data-error", "true");
      setStatus(arStatus?.dataset[kind] ?? "");
      if (handoffStatus) handoffStatus.textContent = arStatus?.dataset[kind] ?? "";
      setHandoffVisible(true);
    };

    const prepareAR = async () => {
      if (arInitialized) return;
      arInitialized = true;
      setLoading(true);
      try {
        await import("@google/model-viewer");
        await customElements.whenDefined("model-viewer");
        const viewer = document.createElement("model-viewer") as ARViewer;
        const portraitModelPath = arButton.dataset.modelPath ?? STONE_AR_MODEL_PATH;
        viewer.setAttribute("src", panelArModelPath(portraitModelPath, selectedLandscape()));
        if (appleQuickLook) {
          viewer.setAttribute("ios-src", panelArQuickLookModelPath(portraitModelPath, selectedLandscape()));
        }
        viewer.setAttribute("ar", "");
        viewer.setAttribute("ar-scale", "auto");
        viewer.setAttribute(
          "ar-placement",
          panelArPlacementForDevice(window.navigator.userAgent, window.navigator.maxTouchPoints),
        );
        viewer.setAttribute("ar-modes", arButton.dataset.arModes ?? panelArModes());
        viewer.setAttribute("loading", "eager");
        // WebXR presents the viewer's renderer. Give it a real viewport-sized
        // surface; a 1×1 hidden renderer can fail to start on Android Chrome.
        viewer.style.cssText = panelArViewerStyle(false);
        document.body.appendChild(viewer);
        arViewer = viewer;
        await viewer.updateComplete;
        await waitForModel(viewer);

        const textures = new Map<string, Awaited<ReturnType<ARViewer["createTexture"]>>>();
        const applyTexture = async () => {
          if (!android) return;
          const lit = selectedLit();
          const path = lit ? arButton.dataset.arTextureOn : arButton.dataset.arTextureOff;
          // Both baked models inherit this material name from the DARKGOLD
          // template. The other textured material is a panel edge.
          const face = viewer.model?.materials.find((material) => material.name === "DARKGOLD");
          const slot = face?.pbrMetallicRoughness.baseColorTexture;
          if (!path || !slot) throw new Error("Missing AR panel face texture");
          let texture = textures.get(path);
          if (!texture) {
            texture = await viewer.createTexture(path, path.endsWith(".webp") ? "image/webp" : "image/png");
            textures.set(path, texture);
          }
          slot.setTexture(texture);
          viewer.toggleAttribute("data-ar-dim-camera", lit);
        };
        await applyTexture();

        loadSelectedModel = async () => {
          const nextPath = panelArModelPath(portraitModelPath, selectedLandscape());
          if (appleQuickLook) {
            viewer.setAttribute("ios-src", panelArQuickLookModelPath(portraitModelPath, selectedLandscape()));
          }
          setLoading(true);
          try {
            if (viewer.getAttribute("src") !== nextPath) {
              viewer.setAttribute("src", nextPath);
              await viewer.updateComplete;
            }
            await waitForModel(viewer);
            await applyTexture();
            arButton.setAttribute("data-error", "false");
            setStatus();
            if (handoffStatus) handoffStatus.textContent = initialHint;
            setLoading(false);
          } catch (error) {
            console.error("Could not change AR orientation:", error);
            showArError("failed");
          }
        };

        viewer.addEventListener("ar-status", (event: Event) => {
          const status = (event as CustomEvent<{ status: string }>).detail.status;
          if (status === "failed") showArError("failed", true);
          if (status === "session-started") {
            arButton.setAttribute("data-error", "false");
            setStatus();
          }
          if (status === "not-presenting") {
            viewer.style.cssText = panelArViewerStyle(false);
            setLoading(false);
            setHandoffVisible(true);
          }
        });

        const arAvailable = await waitForArAvailability(
          () => viewer.canActivateAR,
          (milliseconds) => new Promise((resolve) => window.setTimeout(resolve, milliseconds)),
        );
        if (!arAvailable) {
          showArError("unavailable");
          return;
        }
        arButton.setAttribute("data-error", "false");
        setStatus();
        setLoading(false);
      } catch (error) {
        console.error("Could not prepare AR:", error);
        showArError("failed");
      }
    };

    const activatePreparedAR = () => {
      if (!arViewer?.canActivateAR) {
        showArError("unavailable");
        return;
      }
      arButton.setAttribute("data-error", "false");
      setStatus();
      setLoading(true);
      setHandoffVisible(false);
      arViewer.style.cssText = panelArViewerStyle(true);
      // Keep this call synchronous inside the click handler: Scene Viewer and
      // Quick Look require the original user gesture.
      void arViewer.activateAR()
        .catch((error) => {
          console.error("AR activation failed:", error);
          showArError("failed", true);
        })
        .finally(() => {
          if (arViewer?.canActivateAR && arButton.dataset.error !== "true") setLoading(false);
        });
    };

    arButton.addEventListener("click", () => {
      if (openInSafari) {
        setLoading(true);
        window.location.href = safariArUrl(window.location.href);
        return;
      }
      if (openInSamsungInternet) {
        setLoading(true);
        window.location.href = samsungInternetArIntent(window.location.href);
        return;
      }
      if (android) {
        useOrientationStep = true;
        setHandoffVisible(true);
        void prepareAR();
        return;
      }
      activatePreparedAR();
    });
    handoffButton?.addEventListener("click", activatePreparedAR);
    orientationInputs.forEach((input) => input.addEventListener("change", () => { void loadSelectedModel?.(); }));
    lightingInputs.forEach((input) => input.addEventListener("change", () => { void loadSelectedModel?.(); }));

    const mobileAR = window.matchMedia("(max-width: 1023px)");
    if (mobileAR.matches || useOrientationStep) {
      if (needsBrowserHandoff || (android && !useOrientationStep)) setLoading(false);
      else void prepareAR();
    }
    mobileAR.addEventListener("change", (event) => {
      if (!event.matches) return;
      if (needsBrowserHandoff || (android && !useOrientationStep)) setLoading(false);
      else void prepareAR();
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeader, { once: true });
  } else {
    initHeader();
  }
</script>
