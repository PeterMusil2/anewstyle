---
import { getPanelPagePath, useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang?: Lang;
  variant?: "bar" | "panel";
}

const { lang = "cs", variant = "bar" } = Astro.props;
const t = useTranslations(lang);
const options = [
  { href: `${getPanelPagePath("stone", lang)}#price-list`, label: t("nav.priceStone") },
  { href: `${getPanelPagePath("mineral", lang)}#price-list`, label: t("nav.priceMineral") },
];
---

<li class:list={["price-nav-item", variant === "bar" && "relative"]}>
  <details class="group">
    <summary
      data-price-nav-trigger
      class:list={[
        "price-nav-item__trigger flex cursor-pointer list-none items-center justify-between gap-2 font-bold tracking-caps text-fg-soft uppercase transition-colors hover:text-gold-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold [&::-webkit-details-marker]:hidden",
        variant === "bar" && "min-h-11 whitespace-nowrap text-[0.8125rem] tracking-[0.12em]",
        variant === "panel" && "min-h-14 border-b border-line text-[0.8125rem] tracking-[0.12em]",
      ]}
    >
      <span>{t("nav.price")}</span>
      <span aria-hidden="true" class="price-nav-item__chevron size-2 shrink-0 rotate-45 border-r border-b border-current transition-transform duration-200"></span>
    </summary>
    <div
      class:list={[
        "price-nav-item__menu flex flex-col border border-line-strong bg-ink-900 p-2 shadow-xl",
        variant === "bar" && "absolute inset-inline-start-0 top-full z-50 mt-2 min-w-72",
        variant === "panel" && "border-t-0 border-b border-x-0 border-line bg-ink-850 ps-3",
      ]}
    >
      {options.map(({ href, label }) => (
        <a
          href={href}
          data-nav-link
          data-price-nav-option
          class:list={[
            "flex items-center text-fg-soft no-underline transition-colors hover:bg-ink-800 hover:text-gold focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-gold",
            variant === "bar" && "min-h-12 px-4 text-sm",
            variant === "panel" && "min-h-12 border-b border-line px-3 text-base last:border-b-0",
          ]}
        >
          {label}
        </a>
      ))}
    </div>
  </details>
</li>

<script>
  const priceSection = document.getElementById("price-list");
  const priceTriggers = document.querySelectorAll<HTMLElement>("[data-price-nav-trigger]");
  const priceOptions = document.querySelectorAll<HTMLAnchorElement>("[data-price-nav-option]");

  if (priceSection && priceTriggers.length) {
    const updateActivePriceNav = () => {
      const { top, bottom } = priceSection.getBoundingClientRect();
      const active = top <= window.innerHeight * 0.55 && bottom >= window.innerHeight * 0.35;

      priceTriggers.forEach((trigger) => {
        if (active) {
          trigger.dataset.active = "true";
          trigger.setAttribute("aria-current", "location");
        } else {
          delete trigger.dataset.active;
          trigger.removeAttribute("aria-current");
        }
      });

      priceOptions.forEach((option) => {
        const optionUrl = new URL(option.href, window.location.href);
        const optionActive = active && optionUrl.pathname.replace(/\/+$/, "") === window.location.pathname.replace(/\/+$/, "");

        if (optionActive) {
          option.dataset.active = "true";
          option.setAttribute("aria-current", "location");
        } else {
          delete option.dataset.active;
          option.removeAttribute("aria-current");
        }
      });
    };

    updateActivePriceNav();
    window.addEventListener("scroll", updateActivePriceNav, { passive: true });
    window.addEventListener("resize", updateActivePriceNav, { passive: true });
    window.addEventListener("hashchange", updateActivePriceNav);
  }
</script>

<style>
  .price-nav-item__trigger[data-active="true"] {
    color: var(--color-gold);
  }

  .price-nav-item__trigger[data-active="true"]:is(:hover, :focus-visible) {
    color: var(--color-gold-light);
  }

  .price-nav-item__menu {
    display: none;
  }

  .price-nav-item__menu a[data-active="true"] {
    color: var(--color-gold);
  }

  .price-nav-item__menu a[data-active="true"]:is(:hover, :focus-visible) {
    color: var(--color-gold-light);
  }

  details[open] > .price-nav-item__menu {
    display: flex;
  }

  details[open] > summary .price-nav-item__chevron {
    rotate: 225deg;
  }
</style>
