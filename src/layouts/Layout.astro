---
import "../styles/global.css";

import Footer from "../components/footer/Footer.astro";
import IconSet from "../components/icons/IconSet.astro";
import CookieBar from "../components/cookies/CookieBar.astro";
import CookieDialog from "../components/cookies/CookieDialog.astro";
import Nav from "../components/nav/Nav.astro";
import StructuredData from "../components/seo/StructuredData.astro";
import WebMcp from "../components/agent/WebMcp.astro";
import {
  useTranslations,
  getLangFromUrl,
  getAlternateLinks,
  getCanonicalUrl,
  defaultLang,
  type Lang,
} from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  panelCategory?: "stone" | "mineral";
  showNav?: boolean;
  metaImageUrl?: string;
  pageType?:
    | "WebPage"
    | "CollectionPage"
    | "ImageGallery"
    | "AboutPage"
    | "ContactPage";
  breadcrumbs?: Array<{ name: string; url: string }>;
  additionalStructuredData?: Array<Record<string, unknown>>;
  /** Origins this page fetches early from (e.g. the Cloudinary CDN). */
  preconnect?: string[];
}

const {
  title,
  description,
  panelCategory,
  showNav = true,
  metaImageUrl,
  pageType,
  breadcrumbs,
  additionalStructuredData,
  preconnect = [],
} = Astro.props;
const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const baseSite = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = getCanonicalUrl(Astro.url, baseSite);
const alternateLinks = getAlternateLinks(canonicalUrl);
const xDefaultHref =
  alternateLinks.find((link) => link.lang === defaultLang)?.href ??
  canonicalUrl.href;
const ogLocale = lang === "cs" ? "cs_CZ" : "en_US";
const ogLocaleAlternate = lang === "cs" ? "en_US" : "cs_CZ";
const fbImageUrl = new URL("/images/meta/meta-facebook.webp", baseSite).href;
const resolvedMetaImageUrl = metaImageUrl
  ? new URL(metaImageUrl, baseSite).href
  : fbImageUrl;

// Google Tag Manager (hardcoded ID)
const GTM_ID = 'GTM-WT79RGCG';
const ENABLE_GTM = true;
---

<!doctype html>
  <html lang={lang} data-panel-category={panelCategory}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    {ENABLE_GTM && (
      // Consent Mode v2 + GTM loader
      <script is:inline>
        // dataLayer + gtag bootstrap
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }

        // Simple cookie helpers for consent
        (function(){
          const KEY = 'cookie-consent-v1';
          function readCookieRaw(name){
            const m = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/([.$?*|{}()\[\]\\\/\+^])/g,'\\$1') + '=([^;]*)'));
            return m ? decodeURIComponent(m[1]) : null;
          }
          function read(){
            try {
              const raw = readCookieRaw(KEY);
              if(!raw) return undefined;
              const obj = JSON.parse(raw);
              if (typeof obj === 'object' && obj) return obj;
            } catch(_){ /* ignore */ }
            return undefined;
          }
          function write(value, update){
            const days = 180; // 6 months
            const maxAge = days * 24 * 60 * 60;
            const secure = location.protocol === 'https:' ? '; Secure' : '';
            document.cookie = KEY + '=' + encodeURIComponent(JSON.stringify(value)) + '; Path=/; Max-Age=' + maxAge + '; SameSite=Lax' + secure;
            if (update) updateGtag(value);
          }
          function toConsentFlags(consent){
            const analytics = consent?.analytics ? 'granted' : 'denied';
            const marketing = consent?.marketing ? 'granted' : 'denied';
            return {
              ad_storage: marketing,
              analytics_storage: analytics,
              ad_user_data: marketing,
              ad_personalization: marketing,
              functionality_storage: 'granted',
              security_storage: 'granted',
            };
          }
          function updateGtag(consent){
            const flags = toConsentFlags(consent || {});
            gtag('consent','update', flags);
          }

          // expose minimal API
          window.__cookieConsent = { read, write, updateGtag, key: KEY };

          // Set default consent BEFORE loading GTM
          const existing = read();
          const defaults = toConsentFlags(existing || {});
          // If no stored consent, default everything optional to denied
          if (!existing) {
            defaults.ad_storage = 'denied';
            defaults.analytics_storage = 'denied';
            defaults.ad_user_data = 'denied';
            defaults.ad_personalization = 'denied';
          }
          gtag('consent', 'default', defaults);
        })();

        // Load GTM after consent defaults are set - but only once the visitor
        // interacts (scroll, tap, key). Marketing tags (Meta pixel ≈ 1.3 MB of
        // JS) then never block the first paint or input on phones. Events
        // pushed to dataLayer before that are queued and sent once it loads.
        (function(w,d,s,l,i){
          w[l]=w[l]||[];w[l].push({'gtm.start': new Date().getTime(), event:'gtm.js'});
          var loaded=false, evs=['pointerdown','keydown','scroll','touchstart'];
          function load(){
            if(loaded) return; loaded=true;
            evs.forEach(function(e){ w.removeEventListener(e, load); });
            var f=d.getElementsByTagName(s)[0], j=d.createElement(s), dl=l!='dataLayer'?'&l='+l:''; j.async=true; j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl; f.parentNode.insertBefore(j,f);
          }
          evs.forEach(function(e){ w.addEventListener(e, load, { once: true, passive: true }); });
        })(window,document,'script','dataLayer','GTM-WT79RGCG');
      </script>
    )}
    {preconnect.map((origin) => <link rel="preconnect" href={origin} />)}
    <link rel="canonical" href={canonicalUrl.href} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Lukáš Chylík" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/images/favicons/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicons/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/images/favicons/favicon-16x16.png"
    />
    <link
      rel="mask-icon"
      href="/images/favicons/safari-pinned-tab.svg"
      color="#5bbad5"
    />

    <!-- Alternate language links (hreflang) -->
    {alternateLinks.map(({ lang: altLang, href }) => (
      <link rel="alternate" hreflang={altLang} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <!-- Machine-readable versions for AI agents -->
    <link rel="alternate" type="text/markdown" title="llms.txt" href="/llms.txt" />
    <link rel="alternate" type="application/json" title="Site data for agents" href="/agent/site.json" />

    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="ANEW STYLE" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf9f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <!-- Apply a stored theme choice before first paint (no flash). -->
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
        }
      } catch (_error) {}
    </script>

    <!-- Schema.org markup for Google -->
    <meta itemprop="name" content={title} />
    <meta itemprop="description" content={description} />
    <meta itemprop="image" content={resolvedMetaImageUrl} />

    <!-- Open Graph data -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ANEW STYLE" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={resolvedMetaImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />

    <!-- Twitter Card data -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedMetaImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <StructuredData
      title={title}
      description={description}
      canonicalUrl={canonicalUrl.href}
      lang={lang}
      metaImageUrl={resolvedMetaImageUrl}
      pageType={pageType}
      breadcrumbs={breadcrumbs}
      additionalGraph={additionalStructuredData}
    />

    <meta name="generator" content={Astro.generator} />

    <!-- Store current language for client-side scripts -->
    <script is:inline define:vars={{ lang }}>
      window.__currentLang = lang;
      try {
        if (typeof localStorage !== "undefined") {
          localStorage.setItem("lang", lang);
        }
      } catch (_error) {
      }
    </script>
    <script is:inline>
      (() => {
        const storageKey = "anewstyle-attribution-v1";
        const trackedFields = [
          "gclid",
          "fbclid",
          "utm_source",
          "utm_medium",
          "utm_campaign",
          "utm_content",
          "utm_term",
        ];
        const params = new URLSearchParams(window.location.search);
        const hasCampaignParams = trackedFields.some((field) =>
          params.has(field),
        );

        try {
          const stored = JSON.parse(
            sessionStorage.getItem(storageKey) || "{}",
          );
          if (!stored.landing_page) {
            stored.landing_page = window.location.href.split("#")[0];
          }
          if (!stored.referrer) stored.referrer = document.referrer;

          if (hasCampaignParams) {
            trackedFields.forEach((field) => {
              stored[field] = params.get(field) || "";
            });
            const referringHost = stored.referrer
              ? new URL(stored.referrer).hostname
              : "";
            stored.source =
              stored.utm_source ||
              (stored.gclid
                ? "google"
                : stored.fbclid
                  ? "facebook"
                  : referringHost || "direct");
            stored.medium =
              stored.utm_medium ||
              (stored.gclid
                ? "cpc"
                : stored.fbclid
                  ? "paid_social"
                  : referringHost
                    ? "referral"
                    : "direct");
          } else if (!stored.source) {
            const referringHost = stored.referrer
              ? new URL(stored.referrer).hostname
              : "";
            stored.source = referringHost || "direct";
            stored.medium = referringHost ? "referral" : "direct";
          }

          sessionStorage.setItem(storageKey, JSON.stringify(stored));
        } catch (_error) {
          // Attribution is optional; the contact form remains usable if
          // browser storage is unavailable.
        }
      })();
    </script>
  </head>
  <body data-lang={lang} class="bg-ink text-fg antialiased">
    <a
      href="#main"
      class="sr-only z-[60] bg-gold px-5 py-3 text-sm font-extrabold tracking-caps text-ink uppercase focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t("common.skipToContent")}
    </a>
    {ENABLE_GTM && (
      // Google Tag Manager (noscript)
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}
    <CookieBar lang={lang} />
    <CookieDialog lang={lang} />
    <IconSet />
    {showNav && <Nav lang={lang} panelCategory={panelCategory} />}
    <slot />
    <Footer lang={lang} panelCategory={panelCategory} />
    <WebMcp />
    {import.meta.env.PROD && (
      <script is:inline>
        // PWA: register the service worker once the page has loaded.
        if ("serviceWorker" in navigator) {
          addEventListener("load", () => navigator.serviceWorker.register("/sw.js").catch(() => {}));
        }
      </script>
    )}
    <script>
      import fancyboxCss from "@fancyapps/ui/dist/fancybox/fancybox.css?url";

      // The lightbox (JS + CSS) loads on intent: the first hover, focus or
      // touch on a [data-fancybox] trigger. A click that arrives before it is
      // ready is replayed once it has loaded.
      const SELECTOR = "[data-fancybox]";
      let ready: Promise<void> | null = null;

      const loadFancybox = () =>
        (ready ??= (async () => {
          if (!document.querySelector("link[data-fancybox-css]")) {
            const link = document.createElement("link");
            link.rel = "stylesheet";
            link.href = fancyboxCss;
            link.dataset.fancyboxCss = "";
            document.head.append(link);
          }
          const { Fancybox } = await import("@fancyapps/ui");
          Fancybox.bind(document.body, SELECTOR, {
            on: {
              // Lightboxes opened from inside a <dialog> must render in it.
              init: (fancybox: { items?: Array<{ trigger?: Element | null }>; options: { parentEl?: Element } }) => {
                const dialog = fancybox.items?.[0]?.trigger?.closest("dialog");
                if (dialog) fancybox.options.parentEl = dialog;
              },
            } as never,
          });
        })());

      const intent = (event: Event) => {
        if ((event.target as Element | null)?.closest?.(SELECTOR)) loadFancybox();
      };
      for (const type of ["pointerover", "focusin", "touchstart"]) {
        document.addEventListener(type, intent, { passive: true });
      }

      let loaded = false;
      document.addEventListener(
        "click",
        (event) => {
          if (loaded) return;
          const trigger = (event.target as Element | null)?.closest?.<HTMLElement>(SELECTOR);
          if (!trigger) return;
          event.preventDefault();
          event.stopImmediatePropagation();
          loadFancybox()
            .then(() => {
              loaded = true;
              trigger.click();
            })
            .catch((error) => console.error(error));
        },
        true,
      );
    </script>
  </body>
</html>
