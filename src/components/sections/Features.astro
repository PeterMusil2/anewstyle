---
import Palette from "../palette/Palette.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { inlineMarkdown } from "../../lib/inline-markdown";
import {
  useTranslations,
  type Lang,
  type TranslationKey,
} from "../../i18n/utils";

interface Props {
  id: string;
  lang?: Lang;
  panelCategory?: "stone" | "mineral";
  showBoth?: boolean;
}

const { id, lang = "cs", panelCategory, showBoth = false } = Astro.props as Props;
const t = useTranslations(lang);

/** A description is a list of [translation key, emphasised?] parts. */
type Part = [TranslationKey, boolean?];

interface Feature {
  id?: string;
  icon?: string;
  label: TranslationKey;
  desc: Part[];
  mineralLabel?: TranslationKey;
  mineralDesc?: TranslationKey;
  combinedDesc?: TranslationKey;
  palette?: boolean;
  note?: TranslationKey;
}

const features: Feature[] = [
  { id: "lightweight", icon: "Ligthweight.svg", label: "features.iconLightweight", desc: [["features.item1Desc1"], ["features.item1Desc2", true], ["features.item1Desc3"], ["features.item1Desc4", true]], mineralDesc: "features.item1Mineral" },
  { id: "quick-mounting", icon: "Mounting.svg", label: "features.iconMounting", desc: [["features.item2Desc1"], ["features.item2Desc2", true], ["features.item2Desc3"]] },
  { id: "backlight", icon: "Backlight.svg", label: "features.iconBacklight", desc: [["features.item3Desc1"], ["features.item3Desc2", true], ["features.item3Desc3"]] },
  { id: "rf-control", icon: "RF_control.svg", label: "features.iconRfWireless", desc: [["features.item4Desc1"], ["features.item4Desc2", true], ["features.item4Desc3"]] },
  { id: "smartphone-control", icon: "MobileControl.svg", label: "features.iconSmartphone", desc: [["features.item5Desc1"], ["features.item5Desc2", true], ["features.item5Desc3"]] },
  { id: "touch-control", icon: "touch.svg", label: "features.iconTouch", desc: [["features.item15Desc1"], ["features.item15Desc2", true]] },
  { id: "temperature", icon: "temperature.png", label: "features.iconTemperature", desc: [["features.item16Desc1"], ["features.item16Desc2", true], ["features.item16Desc3"]] },
  { id: "thickness-16mm", icon: "16mm.svg", label: "features.iconThickness16", desc: [["features.item6Desc1"], ["features.item6Desc2", true], ["features.item6Desc3"]], mineralLabel: "features.iconThickness20", mineralDesc: "features.item6Mineral" },
  { id: "thickness-34mm", icon: "34mm.svg", label: "features.iconThickness34", desc: [["features.item7Desc1"], ["features.item7Desc2", true], ["features.item7Desc3"]], mineralLabel: "features.iconThickness38", combinedDesc: "features.item7Combined" },
  { id: "laminated", icon: "laminated.svg", label: "features.iconLaminated", desc: [["features.item8Desc1"], ["features.item8Desc2", true], ["features.item8Desc3"]] },
  { id: "custom-size", icon: "CustomSize.svg", label: "features.iconCustomSize", desc: [["features.item9Desc1"], ["features.item9Desc2", true], ["features.item9Desc3"]] },
  { id: "led", icon: "LED.svg", label: "features.iconLed", desc: [["features.item10Desc1"], ["features.item10Desc2", true], ["features.item10Desc3"]] },
  { id: "dimmable", icon: "Dimmable.svg", label: "features.iconDimmable", desc: [["features.item11Desc1", true], ["features.item11Desc2"]] },
  { id: "nano-impregnation", icon: "Waterproof.svg", label: "features.iconWaterResistant", desc: [["features.item12Desc1"], ["features.item12Desc2", true], ["features.item12Desc3"]], mineralDesc: "features.item12Mineral", note: "features.item12Desc4" },
  { id: "easy-repair", icon: "Repair.svg", label: "features.iconEasyRepair", desc: [["features.item13Desc1"], ["features.item13Desc2", true], ["features.item13Desc3"]] },
  { id: "color-palette", label: "price.feature13", desc: [["features.item14Desc1"], ["features.item14Desc2", true], ["features.item14Desc3"]], palette: true },
];

const label = (key: TranslationKey) => t(key).replaceAll("\n", " ");
const formattedDescription = (key: TranslationKey) =>
  inlineMarkdown(t(key)).replaceAll(
    "<strong>",
    '<strong class="font-semibold text-fg">',
  );
---

<section id={id} aria-labelledby={`${id}-title`} class="section-y bg-ink-850">
  <div class="container-page flex flex-col gap-14">
    <SectionHeader id={`${id}-title`} eyebrow={t("features.title")} title={t("features.heading")}>
      <p class="text-fg-muted">{t("features.intro")}</p>
    </SectionHeader>

    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {
        features.map((feature) => (
          <li
            id={feature.id}
            class="reveal flex scroll-mt-[calc(var(--nav-height)+1.5rem)] flex-col gap-5 border border-line bg-ink-900 p-7 transition-colors duration-300 target:border-gold hover:border-line-strong"
          >
            {feature.palette ? (
              <Palette lang={lang} />
            ) : feature.icon?.endsWith(".png") ? (
              <img src={`/images/symbols/${feature.icon}`} alt="" width="48" height="48" loading="lazy" class="size-12 object-contain" />
            ) : (
              <span
                class="block size-12 bg-gold mask-contain mask-center mask-no-repeat"
                style={`mask-image: url(/images/symbols/${feature.icon}); -webkit-mask-image: url(/images/symbols/${feature.icon});`}
                aria-hidden="true"
              />
            )}
            <h3 class="text-base font-black tracking-[0.1em] uppercase">
              {showBoth && feature.mineralLabel ? (
                <span class="grid gap-2">
                  <span><span class="mb-0.5 block text-[0.625rem] tracking-caps text-gold">{t("home.equipmentStone")}</span>{label(feature.label)}</span>
                  <span><span class="mb-0.5 block text-[0.625rem] tracking-caps text-gold">{t("home.equipmentMineral")}</span>{label(feature.mineralLabel)}</span>
                </span>
              ) : panelCategory ? (
                panelCategory === "mineral" && feature.mineralLabel ? label(feature.mineralLabel) : label(feature.label)
              ) : feature.mineralLabel ? (
                <><span data-panel-type="stone">{label(feature.label)}</span><span data-panel-type="mineral">{label(feature.mineralLabel)}</span></>
              ) : label(feature.label)}
            </h3>
            <div class="text-[0.9375rem] leading-relaxed text-fg-muted">
              {showBoth && feature.combinedDesc ? (
                <span set:html={formattedDescription(feature.combinedDesc)} />
              ) : showBoth && feature.mineralDesc ? (
                <div class="grid gap-3">
                  <p><span class="mb-1 block text-[0.625rem] font-bold tracking-caps text-gold uppercase">{t("home.equipmentStone")}</span>{feature.desc.map(([key, strong]) => strong ? <strong class="font-semibold text-fg">{t(key)}</strong> : <span>{t(key)}</span>)}</p>
                  <p><span class="mb-1 block text-[0.625rem] font-bold tracking-caps text-gold uppercase">{t("home.equipmentMineral")}</span><span set:html={formattedDescription(feature.mineralDesc)} /></p>
                </div>
              ) : panelCategory ? panelCategory === "mineral" && feature.mineralDesc ? (
                <span set:html={formattedDescription(feature.mineralDesc)} />
              ) : (
                feature.desc.map(([key, strong]) =>
                  strong ? <strong class="font-semibold text-fg">{t(key)}</strong> : <span>{t(key)}</span>,
                )
              ) : feature.mineralDesc ? (
                <>
                  <span data-panel-type="stone">{feature.desc.map(([key, strong]) => strong ? <strong class="font-semibold text-fg">{t(key)}</strong> : <span>{t(key)}</span>)}</span>
                  <span data-panel-type="mineral" set:html={formattedDescription(feature.mineralDesc)} />
                </>
              ) : feature.desc.map(([key, strong]) => strong ? <strong class="font-semibold text-fg">{t(key)}</strong> : <span>{t(key)}</span>)}
              {feature.note && (panelCategory ? panelCategory === "stone" : true) && <em data-panel-type={showBoth ? undefined : "stone"} class="mt-2 block text-fg-subtle">{showBoth && <span class="font-semibold text-fg">{t("home.equipmentStone")}:</span>} {t(feature.note)}</em>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
