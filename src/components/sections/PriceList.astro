---
/**
 * Price list. The size picker is a native radio group; every price, VAT
 * price and preview image is rendered for all four sizes and effects.css shows
 * the ones matching the checked radio with :has() – no JavaScript needed.
 */
import prices from "../../data/prices.json";
import type { PricesData } from "./PriceList.types";
import { MINERAL_FEATURE_KEYS, priceFor, type PanelCategory, type SizeKey } from "../../lib/prices";
import Button from "../ui/Button.astro";
import ScaleFigure from "../ui/ScaleFigure.astro";
import Icon from "../icons/Icon.astro";
import {
  useTranslations,
  type Lang,
  type TranslationKey,
} from "../../i18n/utils";

interface Props {
  id: string;
  lang?: Lang;
  panelCategory?: "stone" | "mineral";
}

const { id, lang = "cs", panelCategory } = Astro.props;
const t = useTranslations(lang);
const basePath = lang === "cs" ? "" : "/en";
const contactPath = panelCategory
  ? `${basePath}/?panel=${panelCategory}#contact`
  : `${basePath}/#contact`;
const comparisonPath = `${basePath}/#equipment-comparison`;


const sizes: { key: SizeKey; label: string; width: number; aria: TranslationKey }[] = [
  { key: "l", label: "L", width: 400, aria: "price.showL" },
  { key: "xl", label: "XL", width: 600, aria: "price.showXL" },
  { key: "xxl", label: "XXL", width: 800, aria: "price.showXXL" },
  { key: "xxxl", label: "XXXL", width: 1200, aria: "price.showXXXL" },
];
const previewCategories: PanelCategory[] = panelCategory ? [panelCategory] : ["stone", "mineral"];
const previewImage = (size: SizeKey, category: PanelCategory) =>
  `/images/priceList/${size}${category === "mineral" ? "-art-stone" : ""}.avif`;

const PANEL_HEIGHT = 2400;
const dims = (width: number) => `${PANEL_HEIGHT} × ${width} mm`;

const featureLabel = (key: string) => t(`price.feature${key}` as TranslationKey);
const categoryFeatureLabel = (key: string, category: PanelCategory) =>
  category === "mineral" && MINERAL_FEATURE_KEYS.has(key)
    ? t(`price.feature${key}Mineral` as TranslationKey)
    : featureLabel(key);

const number = new Intl.NumberFormat("cs-CZ", { maximumFractionDigits: 0 });
const format = (value: number) => number.format(value);

const products = (prices as PricesData).products;
// Mineral = stone price + per-size surcharge (src/lib/prices.ts, shared with
// the agent data so the site and the agents quote the same numbers).
const priceMap = (product: (typeof products)[number], category: PanelCategory) =>
  Object.fromEntries(
    sizes.map(({ key }) => {
      const net = priceFor(product, key, category);
      return [key, { net: format(net), gross: format(Math.round(net * 1.21)) }];
    }),
  ) as Record<SizeKey, { net: string; gross: string }>;

const tiers = products.map((product, index) => {
  const previous = products[index - 1];
  // Highlights: the first tier lists what it has, every next tier lists only
  // what it adds on top of the previous one.
  const highlights = Object.entries(product.features)
    .filter(([key, has]) => has && !(previous?.features[key] ?? false))
    .map(([key]) => key);

  return {
    ...product,
    featured: index === products.length - 1,
    tagline: product.tagline?.[lang] ?? "",
    taglineMineral: product.taglineMineral?.[lang] ?? product.tagline?.[lang] ?? "",
    previousTitle: previous?.title,
    highlights,
    price: priceMap(product, "stone"),
    mineralPrice: priceMap(product, "mineral"),
  };
});

const cheapest = (key: SizeKey, category: PanelCategory) =>
  format(Math.min(...products.map((product) => priceFor(product, key, category))));
const getTierPrice = (tier: (typeof tiers)[number], category: PanelCategory) =>
  category === "mineral" ? tier.mineralPrice : tier.price;
---

<section id={id} aria-labelledby={`${id}-title`} class="pricing bg-ink-850">
  <div class="price-catalog">
    <div class="container-page flex flex-col gap-4 py-5 lg:gap-5 lg:py-7">
    <header class="reveal grid gap-3 lg:grid-cols-[auto_minmax(0,1fr)] lg:items-end lg:gap-x-16 short:gap-2">
      <div class="flex flex-col gap-3 sm:gap-4 short:gap-2.5">
        <p class="eyebrow">{t("price.eyebrow")}</p>
        <!-- Same title style as every SectionHeader on the site. -->
        <h2 id={`${id}-title`} class="font-display text-[2.125rem] leading-[1.05] font-black tracking-display uppercase sm:text-5xl lg:text-[3.25rem]">
          {t("price.title")}
        </h2>
      </div>
      <div class="flex flex-col gap-1 lg:max-w-2xl lg:justify-self-end lg:text-right tiny:hidden">
        <p class="text-[0.9375rem] text-fg-soft lg:text-base">{panelCategory ? panelCategory === "mineral" ? t("price.categoryMineral") : t("price.categoryStone") : t("price.desc1")}</p>
      </div>
    </header>

    {!panelCategory && <fieldset class="grid grid-cols-2 gap-2 sm:max-w-3xl sm:gap-3" aria-label={t("price.categoryLabel")}>
      <legend class="sr-only">{t("price.categoryLabel")}</legend>
      <label class="flex min-h-14 cursor-pointer items-center justify-center border border-line bg-ink-900 px-3 py-3 text-center text-xs leading-snug font-extrabold tracking-[0.08em] uppercase transition-colors hover:border-line-strong has-checked:border-gold has-checked:bg-gold/12 has-checked:text-gold-light has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-gold sm:px-5 sm:text-sm">
        <input type="radio" name="panel-category" value="stone" data-price-category="stone" class="sr-only" />
        {t("price.categoryStone")}
      </label>
      <label class="flex min-h-14 cursor-pointer items-center justify-center border border-line bg-ink-900 px-3 py-3 text-center text-xs leading-snug font-extrabold tracking-[0.08em] uppercase transition-colors hover:border-line-strong has-checked:border-gold has-checked:bg-gold/12 has-checked:text-gold-light has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-gold sm:px-5 sm:text-sm">
        <input type="radio" name="panel-category" value="mineral" data-price-category="mineral" class="sr-only" />
        {t("price.categoryMineral")}
      </label>
    </fieldset>}
    </div>

    <div class="price-catalog__body">
      <!--
        The pricing panel is sized to the viewport (minus the fixed nav), so
        the size picker and all three versions are visible together.
      -->
      <div class="container-page flex min-h-[min(calc(100svh-var(--nav-height)),56rem)] flex-col justify-center gap-4 py-5 lg:gap-5 lg:py-7 short:gap-3 short:py-4">
        {previewCategories.map((category) => <p data-price-type={category} data-price-display="block" class="hidden text-sm text-fg-muted sm:block short:hidden">
          <span>{t("price.desc2")}</span>{" "}<strong class="font-bold text-gold">{t("price.desc3")}</strong>{" "}<span>{category === "mineral" ? t("price.desc4Mineral") : t("price.desc4")}</span>
        </p>)}
    <!-- Step 1: size -->
    <fieldset class="flex flex-col gap-2.5" aria-labelledby={`${id}-step1`}>
      <div class="flex items-center justify-between gap-4">
        <h3 class="flex items-center gap-3">
          <span class="grid size-7 shrink-0 place-items-center border border-gold text-xs font-extrabold text-gold">1</span>
          <span id={`${id}-step1`} class="text-xs font-extrabold tracking-[0.14em] uppercase sm:text-[0.8125rem]">{t("price.step1")}</span>
        </h3>
        <p class="hidden text-xs text-fg-muted lg:block">{t("price.underText")}</p>
      </div>
      <div class="grid grid-cols-4 gap-2 lg:gap-3">
        {
          sizes.map((size, index) => (
            <label class="group relative flex min-h-14 min-w-0 cursor-pointer items-center justify-center gap-3 border border-line bg-ink-900 px-2 py-2.5 short:py-2 transition-colors duration-200 hover:border-line-strong has-checked:border-gold has-checked:bg-gold/12 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-gold sm:justify-start sm:px-4 lg:gap-4">
              <input
                type="radio"
                name="size"
                value={size.key}
                checked={index === 0}
                aria-label={t(size.aria)}
                class="sr-only"
              />
              <span class="hidden h-11 w-6 shrink-0 items-end justify-center sm:flex short:h-9" aria-hidden="true">
                <span
                  class="block h-full bg-ink-700 shadow-[inset_0_0_0_1px_var(--color-line-strong)] transition-colors group-has-checked:bg-gold"
                  style={`width: ${(size.width / PANEL_HEIGHT) * 100 * 1.9}%`}
                />
              </span>
              <span class="flex min-w-0 flex-col items-center gap-1 sm:items-start">
                <span class="text-lg leading-none font-black tracking-[0.04em] lg:text-xl">{size.label}</span>
                <span class="truncate text-[0.625rem] leading-tight text-fg-muted sm:text-xs">
                  <span class="sm:hidden">{size.width} mm</span>
                  <span class="hidden sm:inline">{dims(size.width)}</span>
                </span>
                <span class="hidden truncate text-xs leading-tight font-bold text-gold group-has-checked:text-gold-light lg:block">
                  {previewCategories.map((category) => <span data-price-type={category} data-price-display="inline">{t("price.from")} {cheapest(size.key, category)} {t("price.currency")}</span>)}
                </span>
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <!-- Step 2: version -->
    <div class="flex flex-col gap-2.5">
      <div class="flex items-center justify-between gap-4">
        <h3 class="flex items-center gap-3">
          <span class="grid size-7 shrink-0 place-items-center border border-gold text-xs font-extrabold text-gold">2</span>
          <span class="text-xs font-extrabold tracking-[0.14em] uppercase sm:text-[0.8125rem]">
            {t("price.step2")}{" "}
            <span class="text-fg-subtle">·</span>{" "}
            {sizes.map((size) => <span data-size={size.key}>{size.label}</span>)}
          </span>
        </h3>
        <div class="flex items-center gap-5">
          <p class="hidden text-xs text-fg-muted italic sm:block">{t("price.vat")}</p>
          <a href={comparisonPath} class="hidden min-h-11 items-center gap-2 text-xs font-extrabold tracking-caps text-gold uppercase no-underline hover:text-gold-light lg:inline-flex">
            {t("price.compareCta")} ↓
          </a>
        </div>
      </div>

      <div class="flex items-center gap-4 border border-line bg-ink-900 px-4 py-3 xl:hidden">
        <div class="relative h-28 w-14 shrink-0">
          {
            sizes.flatMap((size) => previewCategories.map((category) => (
              <img
                src={previewImage(size.key, category)}
                width="280"
                height="560"
                loading="lazy"
                decoding="async"
                alt={`${t("price.previewAlt")} ${size.label}`}
                data-size={size.key}
                data-price-type={category}
                data-price-display="block"
                data-size-preview
                class="absolute inset-0 size-full -scale-x-100 object-contain object-bottom"
              />
            )))
          }
          <ScaleFigure class="absolute bottom-0 left-0 z-10 aspect-[1.4/5.6] w-[33%]" />
        </div>
        <div class="flex min-w-0 flex-col gap-1.5">
          <p class="text-[0.6875rem] font-bold tracking-[0.2em] text-fg-muted uppercase">{t("price.previewAlt")}</p>
          <p class="text-sm font-semibold text-fg-soft">
            {sizes.map((size) => <span data-size={size.key}>{size.label} · {dims(size.width)}</span>)}
          </p>
        </div>
      </div>

      <div class="grid items-stretch gap-3 lg:grid-cols-3 lg:gap-4 xl:grid-cols-[12rem_repeat(3,minmax(0,1fr))] xl:short:grid-cols-[10rem_repeat(3,minmax(0,1fr))]">
        <div class="hidden flex-col items-center justify-between gap-3 border border-line bg-ink-900 px-4 py-5 xl:flex">
          <p class="text-[0.6875rem] font-bold tracking-[0.2em] text-fg-muted uppercase">{t("price.previewAlt")}</p>
          <div class="relative aspect-[280/560] w-full max-w-36 short:max-w-28 tiny:max-w-22">
            {
              sizes.flatMap((size) => previewCategories.map((category) => (
                <img
                  src={previewImage(size.key, category)}
                  width="280"
                  height="560"
                  loading="lazy"
                  decoding="async"
                  alt={`${t("price.previewAlt")} ${size.label}`}
                  data-size={size.key}
                  data-price-type={category}
                  data-price-display="block"
                  data-size-preview
                  class="absolute inset-0 size-full -scale-x-100 object-contain object-bottom"
                />
              )))
            }
            <!-- Same proportion as the original site: 33 % of the preview width, bottom-left aligned. -->
            <ScaleFigure class="absolute bottom-0 left-0 z-10 aspect-[1.4/5.6] w-[33%]" />
          </div>
          <p class="text-center text-xs text-fg-soft">
            {sizes.map((size) => <span data-size={size.key}>{dims(size.width)}</span>)}
          </p>
        </div>

        <ul
          class="tier-track -mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 pb-1 lg:col-span-3 lg:mx-0 lg:grid lg:grid-cols-3 lg:gap-4 lg:overflow-visible lg:px-0 lg:pb-0"
          aria-label={t("price.step2")}
        >
          {
            tiers.map((tier) => (
              <li
                class:list={[
                  "relative flex w-[84%] shrink-0 snap-center flex-col gap-3 border px-5 py-4 sm:w-[60%] lg:w-auto lg:px-6 short:gap-2.5 short:py-3.5",
                  tier.featured ? "border-gold bg-ink-750" : "border-line bg-ink-800",
                ]}
              >
                {tier.featured && (
                  <span class="absolute -top-px right-5 bg-gold px-2.5 py-1 text-[0.625rem] font-extrabold tracking-[0.16em] text-ink uppercase">
                    {t("price.featured")}
                  </span>
                )}
                <div class="flex flex-col gap-1.5">
                  <h4 class="text-[0.9375rem] font-black tracking-[0.22em] text-gold">{tier.title}</h4>
                  {previewCategories.map((category) => <p data-price-type={category} data-price-display="block" class="line-clamp-2 hidden text-sm leading-snug text-fg-soft sm:block short:hidden">{category === "mineral" ? tier.taglineMineral : tier.tagline}</p>)}
                </div>

                <div class="border-y border-line py-2.5 lg:py-3">
                  {sizes.map((size) => (
                    <>
                      {previewCategories.map((category) => <div data-size={size.key} data-price-type={category} data-price-display="flex" class="flex flex-col gap-1">
                        <p class="flex flex-wrap items-baseline gap-x-1.5">
                          <span class="text-4xl leading-none font-extrabold tracking-tight tabular-nums lg:text-[2.5rem] short:text-[2rem] tiny:text-[1.875rem]">
                            {getTierPrice(tier, category)[size.key].net}
                          </span>
                          <span class="text-base font-bold">{t("price.currency")}</span>
                          <span class="text-xs text-fg-muted">{t("price.withoutVat")}</span>
                        </p>
                        <p class="text-xs text-fg-muted tabular-nums">
                          {getTierPrice(tier, category)[size.key].gross} {t("price.currency")} {t("price.withVat")}
                        </p>
                      </div>)}
                    </>
                  ))}
                </div>

                <ul class="flex grow flex-col gap-1 text-sm leading-snug">
                  {tier.previousTitle && (
                    <li class="flex items-start gap-2 font-semibold">
                      <Icon name="check" class="mt-px size-4 text-gold" />
                      {t("price.everythingFrom")} {tier.previousTitle}
                    </li>
                  )}
                  {tier.highlights.map((key) => (
                    <li class="flex items-start gap-2">
                      <Icon name="check" class="mt-px size-4 text-gold" />
                      {previewCategories.map((category) => (
                        <span data-price-type={category} data-price-display="inline">
                          {categoryFeatureLabel(key, category)}
                        </span>
                      ))}
                    </li>
                  ))}
                </ul>

                <div class="flex items-center gap-3">
                  <Button
                    href={contactPath}
                    size="sm"
                    variant={tier.featured ? "primary" : "outline"}
                    class="flex-1 px-3!"
                  >
                    {t("price.inquire")}
                  </Button>
                  <a
                    href="https://www.anewstyle-eshop.cz/"
                    rel="external"
                    target="_blank"
                    class="grid size-11 shrink-0 place-items-center border border-line-strong text-fg-soft transition-colors hover:border-gold hover:text-gold"
                    aria-label={`${t("price.eshop")} – ${tier.title}`}
                    title={t("price.eshop")}
                  >
                    <Icon name="eshop" class="size-4" />
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 text-xs lg:hidden">
            <p class="text-fg-subtle lg:hidden" aria-hidden="true">{t("price.swipeHint")} →</p>
      <a href={comparisonPath} class="ml-auto inline-flex min-h-11 items-center gap-2 font-extrabold tracking-caps text-gold uppercase no-underline hover:text-gold-light">
        {t("price.compareCta")} ↓
      </a>
    </div>
  </div>

  <!-- Offer: contact form unlocks current stone decors and a discount -->
  <div class="container-page pt-10 lg:pt-14">
    <div class="flex flex-col items-start gap-5 border border-gold/60 bg-ink-900 p-6 sm:flex-row sm:items-center sm:justify-between md:p-8">
      <p class="max-w-3xl text-base leading-relaxed text-fg-soft md:text-lg">
        {panelCategory ? (panelCategory === "mineral" ? t("price.offerPromptBeforeMineral") : t("price.offerPromptBefore")) : <><span data-panel-type="stone">{t("price.offerPromptBefore")}</span><span data-panel-type="mineral">{t("price.offerPromptBeforeMineral")}</span></>}{" "}
        <strong class="text-[1.2em] font-black text-gold-light">{t("price.offerDiscount")}</strong>.
      </p>
      <div class="flex w-full flex-col gap-2 sm:w-auto sm:shrink-0">
        <Button href={contactPath} class="w-full py-3 text-center whitespace-normal! sm:whitespace-nowrap!">{t("price.offerCta")}</Button>
        <p class="max-w-sm text-xs leading-relaxed text-fg-muted">{t("price.offerTerms")}</p>
      </div>
    </div>
  </div>

  <div class="container-page grid gap-4 pt-10 pb-20 md:grid-cols-2 md:gap-5 lg:pt-14 lg:pb-30">
      <div class="flex flex-col gap-3 border border-line bg-ink-900 p-7 md:p-8">
        <h3 class="text-sm font-extrabold tracking-[0.18em] text-gold uppercase">{t("price.customTitle")}</h3>
        <p class="text-base leading-relaxed text-fg-soft">{t("price.customDesc")}</p>
        <Button href={contactPath} variant="link" class="self-start">{t("price.customCta")} →</Button>
      </div>
      <div class="flex flex-col gap-3 border border-line bg-ink-900 p-7 md:p-8">
        <h3 class="text-sm font-extrabold tracking-[0.18em] text-gold uppercase">{t("contact.showroomTitle")}</h3>
        <p class="text-base leading-relaxed text-fg-soft">{t("price.showroomDesc")}</p>
        <Button href="tel:+420601221551" variant="link" class="self-start tracking-[0.06em]!">+420 601 221 551 →</Button>
      </div>
  </div>
  </div>
  </div>
</section>

<style>
  .price-catalog [data-price-type="mineral"] {
    display: none;
  }

  :global(html[data-panel-category="mineral"]) .price-catalog [data-price-type="stone"] {
    display: none;
  }

  :global(html[data-panel-category="mineral"]) .price-catalog [data-price-type="mineral"][data-price-display="inline"] {
    display: inline;
  }

  :global(html[data-panel-category="mineral"]) .price-catalog [data-price-type="mineral"][data-price-display="block"] {
    display: block;
  }

  :global(html[data-panel-category="mineral"]) .price-catalog [data-price-type="mineral"][data-price-display="flex"] {
    display: flex;
  }

  :global(html[data-panel-category="mineral"]) .price-catalog:has(input[name="size"][value="l"]:checked) [data-price-type="mineral"][data-size]:not([data-size="l"]),
  :global(html[data-panel-category="mineral"]) .price-catalog:has(input[name="size"][value="xl"]:checked) [data-price-type="mineral"][data-size]:not([data-size="xl"]),
  :global(html[data-panel-category="mineral"]) .price-catalog:has(input[name="size"][value="xxl"]:checked) [data-price-type="mineral"][data-size]:not([data-size="xxl"]),
  :global(html[data-panel-category="mineral"]) .price-catalog:has(input[name="size"][value="xxxl"]:checked) [data-price-type="mineral"][data-size]:not([data-size="xxxl"]) {
    display: none;
  }
</style>
