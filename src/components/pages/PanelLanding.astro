---
import Layout from "../../layouts/Layout.astro";
import Header from "../header/Header.astro";
import Products from "../sections/Products.astro";
import PriceList from "../sections/PriceList.astro";
import {
  getLangFromUrl,
  getPanelPagePath,
  useTranslations,
  type Lang,
  type PanelCategory,
} from "../../i18n/utils";
import { panelPageStructuredData } from "../../lib/structured-data";
import { getMaterialOverview } from "../../lib/site-data";

interface Props {
  category: PanelCategory;
  lang?: Lang;
}

const { category, lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
const categoryName = t(category === "stone" ? "price.categoryStone" : "price.categoryMineral");
const title = t(category === "stone" ? "meta.title" : "meta.titleMineral");
const description = t(category === "stone" ? "meta.descriptionStone" : "meta.descriptionMineral");
const pagePath = getPanelPagePath(category, lang);
const homePath = lang === "cs" ? "/" : "/en/";
const basePath = lang === "cs" ? "" : "/en";
const material = getMaterialOverview(lang)[category];
const pageUrl = new URL(pagePath, Astro.site ?? Astro.url.origin).href;
---

<Layout
  title={title}
  description={description}
  panelCategory={category}
  metaImageUrl={category === "stone" ? "/images/meta/meta-facebook.webp" : "/images/patterns/mineral-2.png"}
  pageType="CollectionPage"
  breadcrumbs={[
    { name: lang === "cs" ? "Domů" : "Home", url: new URL(homePath, Astro.site ?? Astro.url.origin).href },
    { name: categoryName, url: pageUrl },
  ]}
  additionalStructuredData={panelPageStructuredData(lang, pageUrl, category)}
>
  <Header
    lang={lang}
    pageTitle={categoryName}
    pageDescription={t("header.title")}
    panelCategory={category}
  />
  <main id="main">
    <section id="panel-material" aria-labelledby="panel-material-title" class="home-section-divider bg-ink">
      <div class="container-page grid gap-7 py-8 sm:py-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-center lg:gap-12">
        <div class="flex flex-col items-center gap-3 text-center">
          <h2 id="panel-material-title" class="text-center text-2xl font-black tracking-tight text-fg sm:text-3xl">
            {t(category === "stone" ? "panelPage.stoneMaterialTitle" : "panelPage.mineralMaterialTitle")}
          </h2>
          <p class="text-sm leading-relaxed text-fg-soft">{material.technology}</p>
          <nav aria-label={t("nav.features")} class="flex flex-wrap justify-center gap-x-5 gap-y-2 pt-1 text-center text-sm font-bold">
            <a href={`${homePath}#features`} class="text-gold underline-offset-4 hover:underline focus-visible:underline">{t("panelPage.sharedFeaturesLink")}</a>
            <a href={`${basePath}/faq/`} class="text-gold underline-offset-4 hover:underline focus-visible:underline">{t("panelPage.sharedFaqLink")}</a>
          </nav>
        </div>
        <dl class="grid gap-3 sm:grid-cols-2">
          <div class="border border-line bg-ink-850 p-4 sm:p-5">
            <dt class="text-xs font-extrabold tracking-caps text-fg-muted uppercase">{t("panelPage.materialLayer")}</dt>
            <dd class="mt-2 text-sm leading-relaxed font-semibold text-fg">{material.frontLayer}</dd>
          </div>
          <div class="border border-line bg-ink-850 p-4 sm:p-5">
            <dt class="text-xs font-extrabold tracking-caps text-fg-muted uppercase">{t("panelPage.materialThickness")}</dt>
            <dd class="mt-2 text-sm leading-relaxed font-semibold text-fg">{material.totalThickness}</dd>
          </div>
          <div class="border border-line bg-ink-850 p-4 sm:p-5">
            <dt class="text-xs font-extrabold tracking-caps text-fg-muted uppercase">{t("panelPage.materialWeight")}</dt>
            <dd class="mt-2 text-sm leading-relaxed font-semibold text-fg">{material.weight}</dd>
          </div>
          <div class="border border-line bg-ink-850 p-4 sm:p-5">
            <dt class="text-xs font-extrabold tracking-caps text-fg-muted uppercase">{t("panelPage.materialConsumption")}</dt>
            <dd class="mt-2 text-sm leading-relaxed font-semibold text-fg">{material.consumption}</dd>
          </div>
          <div class="border border-line bg-ink-850 p-4 sm:p-5">
            <dt class="text-xs font-extrabold tracking-caps text-fg-muted uppercase">{t("panelPage.materialLuminance")}</dt>
            <dd class="mt-2 text-sm leading-relaxed font-semibold text-fg">{material.luminance}</dd>
          </div>
          <div class="border border-line bg-ink-850 p-4 sm:p-5">
            <dt class="text-xs font-extrabold tracking-caps text-fg-muted uppercase">{t("panelPage.materialSurface")}</dt>
            <dd class="mt-2 text-sm leading-relaxed font-semibold text-fg">{material.surfaceShort}</dd>
          </div>
        </dl>
      </div>
    </section>
    <Products id="products" lang={lang} panelCategory={category} />
    <PriceList id="price-list" lang={lang} panelCategory={category} />
  </main>
</Layout>
