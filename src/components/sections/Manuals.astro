---
import Picture from "../ui/Picture.astro";
import Icon from "../icons/Icon.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "cs" } = Astro.props;
const t = useTranslations(lang);

const manuals =
  lang === "cs"
    ? [
        {
          href: "/downloads/Manual_CZ_AnewStyle_Basic_Deluxe.pdf",
          badge: "CZ",
          language: t("manual.langCs"),
          size: "735 KB",
          aria: t("contact.downloadManualCs"),
        },
      ]
    : [
        {
          href: "/downloads/Manual_EN_AnewStyle_Basic_Deluxe.pdf",
          badge: "EN",
          language: t("manual.langEn"),
          size: "712 KB",
          aria: t("contact.downloadManualEn"),
        },
      ];

const videos = [
  { id: "LNqzOWaAFGY", title: t("manual.videoDeluxeTitle") },
  { id: "lO5PBh_ZTyA", title: t("manual.videoSlimTitle") },
];
---

<section id="manual" aria-labelledby="manual-title" class="section-y bg-ink">
  <div class="container-page flex flex-col gap-16">
    <SectionHeader id="manual-title" as="h1" layout="split" eyebrow="Anew Style" title={t("manual.title")}>
      <p>{t("manual.intro")}</p>
    </SectionHeader>

    <div class="flex flex-col gap-6">
      <h2 class="border-b border-line pb-4 text-sm font-extrabold tracking-[0.18em] uppercase">
        {t("manual.videosTitle")}
      </h2>
      <ul class="grid gap-5 md:grid-cols-2">
        {
          videos.map((v) => (
            <li class="reveal flex flex-col border border-line bg-ink-900">
              <div class="aspect-video bg-ink-850">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${v.id}`}
                  title={v.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                  class="size-full border-0"
                />
              </div>
              <strong class="border-t border-line px-6 py-5 text-sm font-extrabold tracking-[0.16em] uppercase">
                {v.title}
              </strong>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex flex-col gap-6">
      <h2 class="border-b border-line pb-4 text-sm font-extrabold tracking-[0.18em] uppercase">
        {t("manual.pdfTitle")}
      </h2>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          manuals.map((m) => (
            <li class="reveal">
              <a
                href={m.href}
                target="_blank"
                rel="noopener"
                title={m.aria}
                class="group flex h-full flex-col border border-line bg-ink-900 text-fg no-underline transition-colors hover:border-gold/50"
              >
                <div class="relative aspect-[4/3] overflow-hidden bg-ink-850">
                  <Picture
                    src="/downloads/Manual_AnewStyle_Basic_Deluxe.jpg"
                    alt=""
                    sizes="(min-width: 64rem) 30vw, 90vw"
                    class="size-full object-cover transition-transform duration-500 ease-out-soft group-hover:scale-105"
                  />
                  <span class="absolute top-4 left-4 bg-gold px-2.5 py-1 text-xs font-extrabold tracking-caps text-ink">
                    {m.badge}
                  </span>
                  <Icon name="pdf" class="absolute right-4 bottom-4 size-10 text-fg" />
                </div>
                <div class="flex flex-col gap-3 p-6">
                  <strong class="text-base font-black tracking-[0.08em] uppercase">{t("manual.cardTitle")}</strong>
                  <span class="flex items-center gap-2 text-sm text-fg-muted">
                    <span>{m.language}</span>
                    <span aria-hidden="true">·</span>
                    <span>PDF</span>
                    <span aria-hidden="true">·</span>
                    <span>{m.size}</span>
                  </span>
                  <span class="mt-2 inline-flex min-h-11 items-center gap-2.5 text-xs font-extrabold tracking-caps text-gold uppercase group-hover:text-gold-light">
                    <Icon name="download" class="size-4" />
                    {t("manual.cardCta")}
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
