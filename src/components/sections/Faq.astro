---
/**
 * FAQ – native exclusive accordion (<details name="faq">); the opening motion
 * is pure CSS (.faq-item in effects.css).
 */
import SectionHeader from "../ui/SectionHeader.astro";
import Button from "../ui/Button.astro";
import Icon from "../icons/Icon.astro";
import faq from "../../data/faq.json";
import { inlineMarkdown } from "../../lib/inline-markdown";
import {
  useTranslations,
  type Lang,
  type TranslationKey,
} from "../../i18n/utils";

interface Props {
  id: string;
  lang?: Lang;
}

const { id, lang = "cs" } = Astro.props;
const t = useTranslations(lang);
const basePath = lang === "cs" ? "" : "/en";

const questions = faq.items.map((item) => ({
  question: item.question[lang],
  answer: inlineMarkdown(item.answer[lang]),
}));
---

<section id={id} aria-labelledby={`${id}-title`} class="section-y bg-ink">
  <div class="container-page grid gap-12 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-24">
    <div class="flex flex-col gap-8 lg:sticky lg:top-[calc(var(--nav-height)+2rem)] lg:self-start">
      <SectionHeader id={`${id}-title`} layout="left" eyebrow={t("faq.title")} title={t("faq.heading")}>
        <p class="text-fg-muted">{t("faq.desc" as TranslationKey)}</p>
      </SectionHeader>
      <Button href={`${basePath}/#contact`} variant="outline" class="self-start">
        {t("contact.title")}
      </Button>
    </div>

    <div class="border-t border-line-strong">
      {
        questions.map((item, index) => (
          <details name="faq" class="faq-item group border-b border-line-strong" open={index === 0}>
            <summary class="flex min-h-19 cursor-pointer items-center justify-between gap-6 py-5 text-left">
              <h3 class="text-lg leading-snug font-bold text-fg transition-colors group-open:text-gold">
                {item.question}
              </h3>
              <span class="grid size-9 shrink-0 place-items-center border border-line-strong text-gold transition-colors group-open:border-gold">
                <Icon name="plus" class="faq-icon size-4" />
              </span>
            </summary>
            <div class="faq-answer">
              <p
                class="prose-inline pr-6 pb-7 text-base leading-relaxed text-fg-soft sm:pr-16"
                set:html={item.answer}
              />
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
