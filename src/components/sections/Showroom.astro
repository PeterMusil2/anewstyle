---
import Icon from "../icons/Icon.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { useTranslations, type Lang } from "../../i18n/utils";
import { getGalleryItems } from "../../lib/gallery";

interface Props {
  id: string;
  lang?: Lang;
}

const { id, lang = "cs" } = Astro.props;
const t = useTranslations(lang);

// Photos and 360° panoramas are watermarked image sets in public/media/,
// videos come from Cloudinary; the CMS list decides order and visibility
// (see src/lib/gallery.ts).
// Display order mirrors the segment control: videos first, then 360, then photos.
const GALLERY_ORDER: Record<string, number> = { video: 0, "360": 1, image: 2 };
const galleryItems = getGalleryItems()
  .map((item) => ({ ...item, alt: lang === "en" ? (item.altEn ?? item.alt) : item.alt }))
  .sort((a, b) => (GALLERY_ORDER[a.type] ?? 99) - (GALLERY_ORDER[b.type] ?? 99));

// Tile widths, mirroring the .gallery grid (container 4 → 3 → 2 → 1 columns):
// a landscape tile spans two columns, a portrait tile one. Lazy tiles use
// sizes="auto" where supported (the real rendered width), these otherwise.
const TILE_SIZES = {
  landscape: "auto, (max-width: 35rem) 100vw, (max-width: 48rem) 100vw, (max-width: 64rem) 66vw, 50vw",
  portrait: "auto, (max-width: 35rem) 100vw, (max-width: 48rem) 50vw, (max-width: 64rem) 33vw, 25vw",
};

// One look for every segment of the filter.
const segmentButton =
  "segment-filter__btn inline-flex min-h-11 cursor-pointer items-center justify-center px-5 text-xs font-extrabold tracking-caps text-fg-soft uppercase transition-colors not-last:border-r not-last:border-line-strong hover:text-fg aria-pressed:bg-gold aria-pressed:text-ink [&[hidden]]:hidden!";

// 360° panoramas open in a lazy-loaded Photo Sphere Viewer overlay.
const panoLabels = {
  close: lang === "en" ? "Close" : "Zavřít",
  prev: lang === "en" ? "Previous panorama" : "Předchozí panorama",
  next: lang === "en" ? "Next panorama" : "Další panorama",
};
---

<section id={id} aria-labelledby={`${id}-title`} class="section-y bg-ink">
  <div class="container-page flex flex-col gap-10">
    <SectionHeader id={`${id}-title`} as="h1" layout="split" eyebrow="Anew Style" title={t("gallery.title")}>
      <p>
        <span>{t("gallery.descPart1")}</span><strong class="font-bold text-gold">{t("gallery.descPart2")}</strong><span>{t("gallery.descPart3")}</span><strong class="font-bold text-fg">{t("gallery.descPart4")}</strong><span>{t("gallery.descPart5")}</span>
      </p>
    </SectionHeader>
    <div
      class="segment-filter inline-flex flex-wrap self-start border border-line-strong"
      role="group"
      aria-label={t("gallery.filterAriaLabel")}
    >
      <button type="button" class={segmentButton} data-filter="" aria-pressed="true">{t("gallery.filterAll")}</button>
      <button type="button" class={segmentButton} data-filter="video" aria-pressed="false">{t("gallery.filterVideos")}</button>
      <button type="button" class={segmentButton} data-filter="360" aria-pressed="false">{t("gallery.filter360")}</button>
      <button type="button" class={segmentButton} data-filter="image" aria-pressed="false">{t("gallery.filterImages")}</button>
      <button type="button" class={`${segmentButton} segment-filter__btn--bonus`} data-filter="bonus" aria-pressed="false" hidden>{t("gallery.filterBonus")}</button>
    </div>
  </div>

  <div class="gallery-wrap container-wide mt-10">
    <div
      class="gallery"
      data-pano-close={panoLabels.close}
      data-pano-prev={panoLabels.prev}
      data-pano-next={panoLabels.next}
    >
    {
      galleryItems.map((item) =>
        item.type === "360" ? (
          <a
            href={item.full}
            aria-label={item.alt ?? t("gallery.preview360Day")}
            data-media="360"
            data-bonus={item.bonus ? "true" : undefined}
            data-pano={item.bonus ? undefined : item.full}
            data-pano-locked={item.bonus ? item.full : undefined}
            class="gitem group relative overflow-hidden border border-line bg-ink-900 no-underline"
            rel="noopener"
          >
            <div class="gitem__photo size-full">
              <img
                src={item.tile.src}
                srcset={item.tile.srcset}
                sizes={item.tile.srcset ? TILE_SIZES.landscape : undefined}
                loading="lazy"
                decoding="async"
                width={item.tile.width}
                height={item.tile.height}
                alt={item.alt ?? t("gallery.preview360Day")}
                class="size-full object-cover transition-transform duration-500 ease-out-soft group-hover:scale-105"
              />
            </div>
            <div class="absolute inset-0 grid place-items-center bg-black/10 transition-colors group-hover:bg-black/0">
              <span class="grid size-18 place-items-center rounded-full bg-black/45 text-white shadow-lg backdrop-blur-md transition-transform duration-300 group-hover:scale-110 sm:size-22">
                <Icon name="360" class="size-10 sm:size-12" />
              </span>
            </div>
          </a>
        ) : (
          <a
            href={item.full}
            aria-label={item.alt ?? t("products.stoneAsLighting")}
            data-fancybox={item.bonus ? undefined : "gallery"}
            data-fancybox-locked={item.bonus ? "gallery" : undefined}
            data-srcset={item.fullSrcset}
            data-sizes={item.fullSrcset ? "100vw" : undefined}
            data-media={item.type}
            data-orientation={item.orientation}
            data-bonus={item.bonus ? "true" : undefined}
            class="gitem group relative overflow-hidden border border-line bg-ink-900 no-underline"
            rel="noopener"
          >
            <div class="gitem__photo size-full">
              <img
                src={item.tile.src}
                srcset={item.tile.srcset}
                sizes={item.tile.srcset ? TILE_SIZES[item.orientation] : undefined}
                loading="lazy"
                decoding="async"
                width={item.tile.width}
                height={item.tile.height}
                style={item.tile.style}
                alt={item.alt ?? t("products.stoneAsLighting")}
                class="size-full object-cover transition-transform duration-500 ease-out-soft group-hover:scale-105"
              />
            </div>
            {item.type === "video" && (
              <div class="absolute inset-0 grid place-items-center bg-black/10 transition-colors group-hover:bg-black/0">
                <span class="grid size-18 place-items-center rounded-full bg-black/45 text-white shadow-lg backdrop-blur-md transition-transform duration-300 group-hover:scale-110 sm:size-22">
                  <Icon name="play" class="size-9 translate-x-0.5 sm:size-11" />
                </span>
              </div>
            )}
          </a>
        ),
      )
    }
    </div>
  </div>

  <div class="container-page mt-14 flex flex-col items-center gap-6 text-center">
    <p class="text-[0.9375rem] text-fg-muted">
      <span>{t("gallery.underText")}</span>{" "}
      <a
        href="https://www.designatak.cz/"
        aria-label={t("gallery.gotoAtakDesign")}
        class="font-semibold text-gold underline underline-offset-4 hover:text-gold-light"
        rel="external"
      >ATAK Design</a>.
    </p>
  </div>
</section>

<script>
  // Set once the visitor submits the contact form; see Contact.astro.
  const BONUS_KEY = "bonusContentUnlocked";

  const isBonusUnlocked = (): boolean => {
    try {
      return localStorage.getItem(BONUS_KEY) === "true";
    } catch {
      // Private mode or blocked storage: stay locked rather than throwing.
      return false;
    }
  };

  const initGalleryFilter = () => {
    const gallery = document.querySelector<HTMLElement>(".gallery");
    const filter = gallery
      ?.closest("section")
      ?.querySelector<HTMLElement>(".segment-filter");
    if (!filter || !gallery) return;

    // Reveal the bonus tiles and their filter only for unlocked visitors. The
    // markup ships locked, so the gated content never flashes before this runs.
    if (isBonusUnlocked()) {
      gallery.dataset.bonusUnlocked = "true";
      filter
        .querySelectorAll<HTMLButtonElement>(".segment-filter__btn--bonus")
        .forEach((btn) => btn.removeAttribute("hidden"));

      // Bonus tiles ship without the attributes that make them openable, so a
      // locked visitor cannot reach them by paging through the lightbox or the
      // panorama viewer. Promote them to the real attributes now.
      gallery
        .querySelectorAll<HTMLElement>("[data-fancybox-locked]")
        .forEach((el) => {
          el.dataset.fancybox = el.dataset.fancyboxLocked ?? "gallery";
          delete el.dataset.fancyboxLocked;
        });

      gallery
        .querySelectorAll<HTMLElement>("[data-pano-locked]")
        .forEach((el) => {
          el.dataset.pano = el.dataset.panoLocked ?? "";
          delete el.dataset.panoLocked;
        });
    }

    const buttons = filter.querySelectorAll<HTMLButtonElement>(
      ".segment-filter__btn",
    );

    const activate = (btn: HTMLButtonElement) => {
      buttons.forEach((b) => b.setAttribute("aria-pressed", "false"));
      btn.setAttribute("aria-pressed", "true");

      const value = btn.dataset.filter ?? "";
      if (value) {
        gallery.setAttribute("data-filter", value);
      } else {
        gallery.removeAttribute("data-filter");
      }
    };

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.getAttribute("aria-pressed") === "true") return;
        activate(btn);
      });
    });

    // ?filter=<value> preselects a segment on arrival - the thank-you modal
    // links here with ?filter=bonus. A hidden button (bonus while locked) is
    // ignored, so the URL can never expose gated content.
    const requested = new URLSearchParams(location.search).get("filter");
    if (requested) {
      const target = Array.from(buttons).find(
        (btn) => btn.dataset.filter === requested && !btn.hidden,
      );
      if (target) activate(target);
    }
  };

  initGalleryFilter();
  document.addEventListener("astro:page-load", initGalleryFilter);
</script>

<script>
  import psvCss from "@photo-sphere-viewer/core/index.css?url";
  // Lazy 360° panorama viewer. Photo Sphere Viewer (WebGL/three.js) and its CSS
  // are only fetched the first time a visitor opens a panorama. Prev/next cycle
  // through every panorama in the gallery by swapping the source on one viewer.
  const initPanoViewer = () => {
    const triggers = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("a[data-pano]"),
    );
    if (triggers.length === 0) return;

    const urls = triggers
      .map((trigger) => trigger.dataset.pano ?? "")
      .filter(Boolean);
    const gallery = document.querySelector<HTMLElement>(".gallery");
    const labels = {
      close: gallery?.dataset.panoClose ?? "Close",
      prev: gallery?.dataset.panoPrev ?? "Previous",
      next: gallery?.dataset.panoNext ?? "Next",
    };

    let closeActive: (() => void) | null = null;

    const button = (
      className: string,
      label: string,
      glyph: string,
    ): HTMLButtonElement => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = className;
      btn.setAttribute("aria-label", label);
      btn.innerHTML = glyph;
      return btn;
    };

    const open = async (startIndex: number): Promise<void> => {
      let index = startIndex;

      const modal = document.createElement("div");
      modal.className = "pano-modal";
      modal.setAttribute("role", "dialog");
      modal.setAttribute("aria-modal", "true");

      const stage = document.createElement("div");
      stage.className = "pano-modal__stage";

      const closeBtn = button("pano-modal__close", labels.close, "&times;");
      modal.append(stage, closeBtn);

      const multiple = urls.length > 1;
      const prevBtn = multiple
        ? button(
            "pano-modal__nav pano-modal__nav--prev",
            labels.prev,
            "&lsaquo;",
          )
        : null;
      const nextBtn = multiple
        ? button(
            "pano-modal__nav pano-modal__nav--next",
            labels.next,
            "&rsaquo;",
          )
        : null;
      if (prevBtn && nextBtn) modal.append(prevBtn, nextBtn);

      document.body.append(modal);
      document.documentElement.style.overflow = "hidden";

      // The stylesheet is linked by URL: with inlined stylesheets Vite cannot
      // preload a CSS chunk for a dynamic import ("Unable to preload CSS").
      if (!document.querySelector("link[data-psv-css]")) {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = psvCss;
        link.dataset.psvCss = "";
        document.head.append(link);
      }
      const { Viewer } = await import("@photo-sphere-viewer/core");

      const viewer = new Viewer({
        container: stage,
        panorama: urls[index],
        navbar: ["zoom", "move", "fullscreen"],
      });

      const go = (delta: number): void => {
        index = (index + delta + urls.length) % urls.length;
        void viewer.setPanorama(urls[index], { showLoader: true });
      };

      const onKey = (event: KeyboardEvent): void => {
        if (event.key === "Escape") close();
        else if (event.key === "ArrowLeft" && multiple) go(-1);
        else if (event.key === "ArrowRight" && multiple) go(1);
      };

      const close = (): void => {
        document.removeEventListener("keydown", onKey);
        viewer.destroy();
        modal.remove();
        document.documentElement.style.overflow = "";
        closeActive = null;
      };

      closeBtn.addEventListener("click", close);
      prevBtn?.addEventListener("click", () => go(-1));
      nextBtn?.addEventListener("click", () => go(1));
      modal.addEventListener("click", (event) => {
        if (event.target === modal) close();
      });
      document.addEventListener("keydown", onKey);
      closeActive = close;
    };

    triggers.forEach((trigger, triggerIndex) => {
      if (trigger.dataset.panoBound) return;
      trigger.dataset.panoBound = "1";
      trigger.addEventListener("click", (event) => {
        if (!trigger.dataset.pano) return;
        event.preventDefault();
        closeActive?.();
        void open(triggerIndex);
      });
    });
  };

  initPanoViewer();
  document.addEventListener("astro:page-load", initPanoViewer);
</script>
