{
  "name": "anew-style",
  "version": "3.0.0",
  "description": "Updated on 19.7.2026",
  "private": true,
  "license": "ISC",
  "author": "Lukáš Chylík",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"astro dev\" \"bun run stylelint:watch\"",
    "gallery:build": "node scripts/build-cloudinary-gallery.mjs",
    "build": "bun run gallery:build && astro check && astro build && node scripts/postbuild-sitemap-alias.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "stylelint": "stylelint --fix \"src/**/*.scss\" \"src/**/*.astro\"",
    "stylelint:watch": "nodemon -e scss,astro --watch src -x \"bun run stylelint\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@fancyapps/ui": "^6.1.14",
    "@google/model-viewer": "^4.3.1",
    "@photo-sphere-viewer/core": "^5.15.1",
    "astro": "^7.1.1",
    "cloudinary": "^2.10.0",
    "three": "^0.185.1",
    "typescript": "^6"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.3",
    "cssnano": "^8.0.2",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.20",
    "postcss-html": "^1.8.1",
    "postcss-preset-env": "^11.3.2",
    "postcss-scss": "^4.0.9",
    "sass": "^1.101.0",
    "stylelint": "^17.14.0",
    "stylelint-order": "^8.1.1"
  }
}