---
import Picture from "../ui/Picture.astro";
import Icon from "../icons/Icon.astro";
import { useTranslations, type Lang } from "../../i18n/utils";
import { PANEL_AR_PLACEMENT, panelArModes } from "../../lib/panel-ar";

interface Props {
  id: number;
  title: string;
  imgLight: string;
  imgDark?: string;
  imgFrame?: string;
  modelHorizontal3d?: string;
  modelVertical3d?: string;
  has3D: boolean;
  fan?: boolean;
  lang?: Lang;
}

const {
  id,
  title,
  imgLight,
  imgDark,
  imgFrame,
  modelHorizontal3d,
  modelVertical3d,
  has3D,
  fan = false,
  lang = "cs",
} = Astro.props;
const t = useTranslations(lang);

// The CMS stores uploaded files as absolute paths, older entries as bare
// file names – accept both.
const asset = (folder: string, value?: string) =>
  value ? (/^(\/|https?:)/.test(value) ? value : `${folder}/${value}`) : undefined;
const productImage = (value?: string) => asset("/images/products", value);
const productModel = (value?: string) => asset("/3d/products", value);

const groupName = `product-${id}`;
const hasHorizontalModel = Boolean(modelHorizontal3d);
const hasVerticalModel = Boolean(modelVertical3d);
const primaryFancyboxHref = hasHorizontalModel
  ? `#horizontal3dModel${id}`
  : hasVerticalModel
    ? `#vertical3dModel${id}`
    : productImage(imgLight);

// Every lightbox slide needs a thumbnail; 3D slides reuse the lit photo.
const lightPhoto = productImage(imgLight);
const extraFancyboxItems = [
  hasHorizontalModel && hasVerticalModel ? `#vertical3dModel${id}` : null,
  imgDark ? productImage(imgDark) : null,
  imgFrame ? productImage(imgFrame) : null,
  hasHorizontalModel || hasVerticalModel ? lightPhoto : null,
]
  .filter((src): src is string => Boolean(src))
  .map((href) => ({ href, thumb: href.startsWith("#") ? lightPhoto : href }));
---

<a
  id={`productCard${id}`}
  class:list={[
    "card group border border-line bg-ink-900 text-fg no-underline",
    fan
      ? "product-fan-card relative block aspect-[3/4] overflow-hidden shadow-2xl transition-[border-color,box-shadow,filter] duration-300"
      : "flex h-full flex-col transition-colors duration-300 hover:border-gold/50",
  ]}
  href={primaryFancyboxHref}
  data-fancybox={groupName}
  data-caption={title}
  data-thumb={lightPhoto}
>
  <div class:list={[
    "relative flex items-center justify-center overflow-hidden bg-[radial-gradient(60%_60%_at_50%_50%,rgb(163_140_82/0.12),transparent_70%)]",
    fan ? "size-full" : "aspect-[1024/524]",
  ]}>
    <Picture
      src={lightPhoto ?? ""}
      alt=""
      sizes="(min-width: 80rem) 25vw, (min-width: 40rem) 50vw, 100vw"
      width={1024}
      height={524}
      class:list={[
        "size-full transition-transform duration-500 ease-out-soft group-hover:scale-105",
        fan ? "product-fan-card__stone-image object-cover" : "object-contain",
      ]}
    />
    {
      has3D && (
        <span
          aria-hidden="true"
          class:list={[
            "absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-black/55 px-2.5 py-1 text-[0.6875rem] font-extrabold tracking-caps text-white uppercase backdrop-blur-md",
            fan && "fan-ar-badge",
          ]}
          title={t("products.showIn3d")}
        >
          <Icon name="ar" class="size-4" />
          3D · AR
        </span>
      )
    }
  </div>
  {
    fan ? (
      <span class="product-fan-card__title absolute inset-x-0 bottom-0 bg-linear-to-t from-black/95 via-black/75 to-transparent px-3 pt-9 pb-3 text-center text-[0.625rem] font-black tracking-[0.12em] text-white uppercase sm:px-4 sm:pb-4 sm:text-xs">
        {title}<span class="sr-only"> – {t("products.showProductDetail")}</span>
      </span>
    ) : (
      <div class="flex items-center justify-between gap-4 border-t border-line px-5 py-4">
        <strong class="truncate text-[0.9375rem] font-black tracking-[0.18em] uppercase">{title}<span class="sr-only"> – {t("products.showProductDetail")}</span></strong>
        <span
          class="grid size-11 shrink-0 place-items-center border border-line-strong text-gold transition-colors group-hover:border-gold group-hover:bg-gold group-hover:text-ink"
          title={t("products.btnShowDetail")}
          aria-hidden="true"
        >
          <svg viewBox="0 0 16 16" class="size-4 fill-none stroke-current stroke-[1.75]"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
        </span>
      </div>
    )
  }
</a>
{
  extraFancyboxItems.map((item) => (
    <a
      href={item.href}
      data-thumb={item.thumb}
      data-fancybox={groupName}
      data-caption={title}
      aria-hidden="true"
      tabindex="-1"
      hidden
    />
  ))
}
<div class="product-models" hidden>
  {
    hasHorizontalModel && (
      <model-viewer
        id={`horizontal3dModel${id}`}
        src={productModel(modelHorizontal3d)}
        alt={`${title} – ${t("products.showIn3d")}`}
        poster={lightPhoto}
        loading="lazy"
        reveal="auto"
        ar
        ar-scale="auto"
        ar-placement={PANEL_AR_PLACEMENT}
        ar-modes={panelArModes()}
        camera-controls
        touch-action="pan-y"
        interaction-prompt="auto"
        camera-orbit="0deg 90deg auto"
        min-camera-orbit="auto auto auto"
        camera-target="auto auto auto"
        field-of-view="22deg"
        max-field-of-view="45deg"
        environment-image="neutral"
        shadow-intensity="0.6"
        exposure="1.05"
        class="product-3d"
      >
        <span slot="progress-bar" class="product-3d__progress"></span>
        <button slot="ar-button" type="button" class="product-3d__ar">
          {t("header.btnAr")}
        </button>
      </model-viewer>
    )
  }
  {
    hasVerticalModel && (
      <model-viewer
        id={`vertical3dModel${id}`}
        src={productModel(modelVertical3d)}
        alt={`${title} – ${t("products.showIn3d")}`}
        poster={lightPhoto}
        loading="lazy"
        reveal="auto"
        ar
        ar-scale="auto"
        ar-placement={PANEL_AR_PLACEMENT}
        ar-modes={panelArModes()}
        camera-controls
        touch-action="pan-y"
        interaction-prompt="auto"
        camera-orbit="0deg 90deg auto"
        min-camera-orbit="auto auto auto"
        camera-target="auto auto auto"
        field-of-view="22deg"
        max-field-of-view="45deg"
        environment-image="neutral"
        shadow-intensity="0.6"
        exposure="1.05"
        class="product-3d"
      >
        <span slot="progress-bar" class="product-3d__progress"></span>
        <button slot="ar-button" type="button" class="product-3d__ar">
          {t("header.btnAr")}
        </button>
      </model-viewer>
    )
  }
</div>
